<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_realtime_refresh" model="ir.ui.view">
        <field name="name">res.company.form.realtime.refresh</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="before">
                <group string="Real-time Updates" name="realtime_refresh">
                    <field name="realtime_refresh" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>