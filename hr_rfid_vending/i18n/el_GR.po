msgid "Product Price list"
msgstr "Τιμοκατάλογος Προϊόντος"

#. module: hr_rfid_vending
#: model:ir.model.fields,field_description:hr_rfid_vending.field_hr_rfid_ctrl__pricelist_id
msgid "Product Pricelist"
msgstr "Τιμοκατάλογος Προϊόντος"

#. module: hr_rfid_vending
#: model:ir.model.fields,field_description:hr_rfid_vending.field_hr_rfid_vending_event__item_sold_id
