#: code:addons/hr_rfid_vending/controllers/main.py:0
msgid ""
"%(employee)s is not checked in, and gets vending credit only after a check-"
"in."
msgstr ""
"%(employee)s nu a intrat și primește credit de vending doar după pontarea de"
" intrare."

#. module: hr_rfid_vending
#: model_terms:ir.ui.view,arch_db:hr_rfid_vending.hr_rfid_employee_form_inherit_hr_rfid_vending
msgid ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                                Tip: Fixed type sets the balance to the amount every cron run (good for a fixed daily allowance). Top-up type adds the amount until Max balance is reached (good for an \"up to N\" credit)."
msgstr ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                                Sfat: Tipul Fix setează soldul la valoarea sumei la fiecare rulare a cron-ului (potrivit pentru o alocație zilnică fixă). Tipul Suplimentare adaugă suma până la atingerea Soldului maxim (potrivit pentru un credit „până la N”)."

