<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Showcase demo data for hr_rfid_odoo_import.

        Without it the "Data Transfers" list is empty on a demo database and
        shows only its empty-state text, so nothing anywhere shows what a
        finished transfer actually tells the operator. The other menu this
        module adds opens the wizard, which is transient and cannot be filled
        from here at all.

        What is shipped is ONE finished transfer and its protocol - the account
        of a small access-control site moved off an Odoo 14 server. Only the two
        kept models can carry demo data at all: the conflict list and the
        company-mapping list are TransientModels that belong to the wizard and
        are swept away by the cleaner, so a resolved-versus-open conflict cannot
        be shown here at all.

        The transfer is 'done' ON PURPOSE and no other state is shippable: the
        scheduled job picks up the OLDEST transfer left in 'queued' or 'running'
        (_cron_process) and would immediately try to read the address below over
        XML-RPC, while _abandon_stalled_runs would close a 'running' one as dead
        thirty minutes later. A finished transfer is inert.

        The password field is deliberately absent - _finish clears it the moment
        a transfer ends, so a finished record that still held one would be a
        shape the product never produces.

        noupdate="1": the protocol is a historical account of one job. Nothing
        may rewrite it on a later upgrade, and an operator may delete it once
        they have seen it.

        tracking_disable is NOT set: the creation note in the chatter is part of
        what an operator sees on a real transfer.
    -->
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- The transfer itself                                          -->
        <!-- ============================================================ -->
        <!--
            Every JSON column below is what the wizard hands over in
            _queue_run, and what a finished pass leaves behind:

            * installed_modules_json - the answer to the probe the wizard makes
              from source_probe_modules(): the source keeps the RFID core, the
              site manager, the working-time pair and leaves, and does NOT keep
              cameras, vending or the service desk.
            * options_json - exactly the keys _build_options writes, in that
              order. import_vending / import_service are false because the
              other system has neither module, which is how the wizard gates
              them; import_cameras stays ticked and is refused later by the
              phase itself, which is why the two produce different reasons in
              the protocol below.
            * done_phases_json - the sixteen phases of the registry, sorted, as
              _save_progress writes them. Skipped phases count as done: they
              had their turn and left their line.
            * read_cursors_json - every long read at CURSOR_FINISHED (-1), the
              mark _read_all sets when it reaches the end of the source. That is
              what a transfer that has nothing left to read looks like.
            * step_totals_json - the running totals that travel WITH those
              cursors, so the protocol reports the whole transfer and not just
              the slice the last pass happened to read.
        -->
        <record id="demo_import_run_v14" model="hr.rfid.odoo.import.run">
            <field name="state">done</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="source_url">https://acs-old.example.com</field>
            <field name="source_db">acs_v14</field>
            <field name="source_login">migration</field>
            <field name="source_uid">6</field>
            <field name="source_slug">acs_v14</field>
            <field name="installed_modules_json">["hr_holidays", "hr_attendance_late", "hr_attendance_multi_rfid", "hr_rfid", "hr_rfid_site_manager"]</field>
            <field name="options_json">{"import_hardware": true, "import_people": true, "import_leaves": true, "import_access": true, "import_cameras": true, "import_sites": true, "import_cards": true, "import_all_partners": true, "import_all_employees": true, "import_images": true, "import_users": false, "import_user_groups": false, "import_user_events": true, "import_system_events": true, "import_th_logs": false, "event_date_from": false, "orphan_event_cutoff": false, "import_vending": false, "import_attendance": true, "import_attendance_extra": true, "import_service": false}</field>
            <field name="company_map_json" eval="'{&quot;1&quot;: %s}' % ref('base.main_company')"/>
            <field name="resolution_json">[]</field>
            <field name="done_phases_json">["Phase 1+3", "Phase 10", "Phase 2", "Phase 2c", "Phase 3b", "Phase 3c", "Phase 4", "Phase 4b", "Phase 5", "Phase 6a", "Phase 6b", "Phase 6c", "Phase 7", "Phase 7c", "Phase 8", "Phase 9"]</field>
            <field name="read_cursors_json">{"people:res.partner": -1, "people:hr.employee": -1, "leaves:hr.leave.allocation": -1, "leaves:hr.leave": -1, "sites:equipment:hr.rfid.webstack": -1, "sites:equipment:hr.rfid.ctrl": -1, "sites:equipment:hr.rfid.door": -1, "sites:equipment:hr.rfid.access.group": -1, "sites:equipment:hr.rfid.ctrl.alarm.group": -1, "sites:contacts:res.partner": -1, "access:hr.rfid.card": -1, "events:hr.rfid.event.user:module": -1, "events:hr.rfid.event.system:module": -1, "attendance:hr.attendance": -1}</field>
            <field name="step_totals_json">{"people:res.partner": {"source": 12, "imported": 12, "linked": 0, "skipped": 0, "rejected": 0}, "people:hr.employee": {"source": 27, "imported": 27, "linked": 0, "skipped": 0, "rejected": 0}, "leaves:hr.leave.allocation": {"source": 21, "imported": 21, "linked": 0, "skipped": 0, "rejected": 0}, "leaves:hr.leave": {"source": 58, "imported": 58, "linked": 0, "skipped": 0, "rejected": 0}, "access:hr.rfid.card": {"source": 31, "imported": 31, "linked": 0, "skipped": 0, "rejected": 0}, "events:hr.rfid.event.user": {"source": 8412, "imported": 8412, "linked": 0, "skipped": 0, "rejected": 0, "camera": 0}, "events:hr.rfid.event.system": {"source": 1190, "imported": 1190, "linked": 0, "skipped": 0, "rejected": 0, "camera": 0}, "attendance:hr.attendance": {"source": 4268, "imported": 4268, "linked": 0, "skipped": 0, "rejected": 0}}</field>
            <field name="done_count">16</field>
            <field name="total_count">16</field>
        </record>

        <!-- ============================================================ -->
        <!-- The protocol - one line per step, in the order they ran      -->
        <!-- ============================================================ -->
        <!--
            The lines are created in reading order because the model is ordered
            by id, so the notebook on the transfer form reads top to bottom the
            way the work happened. Every 'model' value below is what the code
            really puts there: a model name for a step that moves records, and
            a plain label for the steps that check rather than move (the IO
            tables, the consistency checks, the reconciliation).

            There is deliberately no 'error' line anywhere: _finish_reporting_
            failures ends a transfer that has one in 'failed', so an error line
            beside state 'done' would be a shape the product cannot produce.
        -->

        <!-- Phase 1+3, step 1-5: the foundation both systems share. -->
        <!-- Card types are matched on their external id, never created again -
             that is why every one of them is Linked and none Imported. -->
        <record id="demo_log_01_card_type" model="hr.rfid.odoo.import.log">
            <field name="run_id" ref="demo_import_run_v14"/>
            <field name="phase">Phase 1+3</field>
            <field name="model">hr.rfid.card.type</field>
            <field name="source_count">4</field>
            <field name="imported_count">0</field>
            <field name="linked_count">4</field>
            <field name="status">done</field>
            <field name="duration">0.41</field>
        </record>
