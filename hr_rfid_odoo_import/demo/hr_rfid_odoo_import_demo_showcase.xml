        <record id="demo_log_18_leave_type" model="hr.rfid.odoo.import.log">
            <field name="run_id" ref="demo_import_run_v14"/>
            <field name="phase">Phase 2c</field>
            <field name="model">hr.leave.type</field>
            <field name="source_count">6</field>
            <field name="imported_count">6</field>
