#: model:ir.model.fields,field_description:hr_rfid_odoo_import.field_hr_rfid_odoo_import_log__linked_count
msgid "Linked"
msgstr "Συνδεδεμένα"

#. module: hr_rfid_odoo_import
#: model:ir.model.fields,help:hr_rfid_odoo_import.field_hr_rfid_odoo_import_wiz__progress_text
msgid ""
"Live status of the running import job (current phase, processed records). "
"Updated by the worker that performs the import."
msgstr ""
"Текущ статус на изпълняваната задача за импорт (текуща фаза, обработени "
"записи). Актуализира се от работния процес, изпълняващ импорта."

#. module: hr_rfid_odoo_import
#: model:ir.model.fields,help:hr_rfid_odoo_import.field_hr_rfid_odoo_import_wiz__source_login
msgid ""
"Login of an admin-level user on the source Odoo instance - the user must "
"have read access to every model the import will fetch."
msgstr ""
"Потребителско име на потребител с администраторски права в системата "
"източник Odoo - потребителят трябва да има права за четене за всеки модел, "
"който импортът ще извлича."

#. module: hr_rfid_odoo_import
#: model:ir.model.fields,help:hr_rfid_odoo_import.field_hr_rfid_odoo_import_wiz__source_version
msgid ""
"Major Odoo version detected on the source instance (e.g. '14.0', '15.0'). "
"Used to dispatch the right importer per phase."
msgstr ""
"Основна версия на Odoo, открита в системата източник (напр. „14.0“, „15.0“). "
"Използва се за избор на правилния импортер за всяка фаза."

