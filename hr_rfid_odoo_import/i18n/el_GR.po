msgid "Last Updated on"
msgstr "Τελευταία ενημέρωση στις"

#. module: hr_rfid_odoo_import
#: model:ir.model.fields,help:hr_rfid_odoo_import.field_hr_rfid_odoo_import_wiz__source_db
msgid ""
"Leave empty if the source server hosts a single database - it will be auto-"
"detected. If the source has multiple databases, enter the exact database "
"name here."
msgstr ""
"Оставете празно, ако сървърът източник хоства една база данни - тя ще бъде "
"открита автоматично. Ако източникът има няколко бази данни, въведете тук "
"точното име на базата данни."

