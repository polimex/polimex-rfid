#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/base_importer.py:0
msgid ""
"door №%(num)s \"%(name)s\" belongs to camera \"%(cam)s\" - it is attached "
"again right after the cameras come across"
msgstr ""
"Tür Nr. %(num)s \"%(name)s\" gehört zu Kamera \"%(cam)s\" - sie wird direkt "
"nach den Kameras erneut zugeordnet"

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/base_importer.py:0
msgid ""
"door №%(num)s \"%(name)s\" belongs to company \"%(company)s\", which is not "
"included in this transfer - add that company on the first page to bring its "
"doors"
msgstr ""
"Tür Nr. %(num)s \"%(name)s\" gehört zu Unternehmen \"%(company)s\", das "
"nicht in diese Übertragung einbezogen ist - fügen Sie dieses Unternehmen auf"
" der ersten Seite hinzu, um dessen Türen zu übernehmen"

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/base_importer.py:0
msgid ""
"door №%(num)s \"%(name)s\" is part of this transfer and still did not arrive"
" - look at the hardware step above"
msgstr ""
"Tür Nr. %(num)s \"%(name)s\" ist Teil dieser Übertragung und ist noch nicht "
"eingetroffen - siehe Hardware-Schritt oben"

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/base_importer.py:0
msgid ""
"door №%(num)s \"%(name)s\" is part of this transfer; a door with the same "
"name exists here (№%(target)s) but under a different transfer identity, so "
"they are not recognised as one - send this protocol to support"
msgstr ""
"Tür №%(num)s „%(name)s“ ist Teil dieser Übertragung; hier existiert eine Tür"
" mit demselben Namen (№%(target)s), jedoch unter einer anderen "
"Übertragungsidentität, sodass sie nicht als dieselbe erkannt werden - senden"
" Sie dieses Protokoll an den Support"

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/base_importer.py:0
msgid "door №%(num)s from the other system has no match here"
msgstr "Tür Nr. %(num)s aus dem anderen System hat hier keine Entsprechung"

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/consistency_importer.py:0
msgid "group %(group)s grants door %(door)s of another company"
msgstr ""
"Gruppe %(group)s gewährt Zugang zu Tür %(door)s eines anderen Unternehmens"

