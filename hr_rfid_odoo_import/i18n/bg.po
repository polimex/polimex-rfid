#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/camera_importer.py:0
msgid ""
"%(count)s camera(s) arrived without a password and cannot be reached until "
"one is entered."
msgstr ""
"%(count)s камера(и) пристигнаха без парола и не могат да бъдат достигнати, "
"докато не бъде въведена такава."

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/core_importer.py:0
msgid ""
"%(count)s controller(s) were asked to send their input/output table. It "
"arrives when they next report in; run this again if any of them were "
"switched off."
msgstr ""
"%(count)s контролер(и) бяха помолени да изпратят своята таблица за входове/"
"изходи. Тя пристига при следващото им отчитане; изпълнете отново, ако някои "
"от тях са били изключени."

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/camera_importer.py:0
msgid ""
"%(count)s door(s) arrived without the kind of card they accept, because that "
"kind is not here. Set it on each door before the barrier is used again."
msgstr ""
"%(count)s врата(и) пристигнаха без вида карта, който приемат, защото този "
"вид не е налице тук. Задайте го на всяка врата, преди бариерата да бъде "
"използвана отново."

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/camera_importer.py:0
msgid ""
"%(count)s plate(s) came from an unrecognised list and were placed in the "
"deny list."
msgstr ""
"%(count)s регистрационен(ни) номер(а) идваха от непознат списък и бяха "
"поставени в списъка за отказ."

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/import_wizard.py:0
msgid ""
"%(count)s record(s) clash with ones already here - decide about each of them "
"in the list below before starting."
msgstr ""
"%(count)s записа влизат в конфликт с вече съществуващи тук - решете за всеки "
"от тях в списъка по-долу, преди да започнете."

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/site_importer.py:0
msgid ""
"%(equipment)s piece(s) of equipment had not arrived yet and %(sites)s "
"pointed at a site that is not here."
msgstr ""
"%(equipment)s единица(и) оборудване все още не бяха пристигнали, а %(sites)s "
"сочеха към обект, който не е тук."

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/import_wizard.py:0
msgid "%(kind)s: could not be counted"
msgstr "%(kind)s: не можа да бъде преброено"

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/event_importer.py:0
msgid ""
"%(missing)s recognised plate event(s) are waiting for the camera capability. "
"Add it here, then run the transfer again."
msgstr ""
"%(missing)s разпознато(и) събитие(я) за регистрационен номер чакат "
"функционалност на камерата. Добавете я тук, след което стартирайте трансфера "
"отново."

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/event_importer.py:0
msgid "%(missing)s recognised plate event(s) did not come across."
msgstr ""
"%(missing)s разпознато(и) събитие(я) за регистрационен номер не "
"пристигна(ха)."

#. module: hr_rfid_odoo_import
#. odoo-python
#: code:addons/hr_rfid_odoo_import/models/importers/event_importer.py:0
msgid ""
"%(missing)s recognised plate event(s) stayed behind because events were left "
"out of this transfer. Run it again with events switched on to bring them."
msgstr ""
"%(missing)s разпознати събития с регистрационен номер останаха назад, защото "
"събитията бяха изключени от този трансфер. Стартирайте го отново с включени "
"събития, за да ги пренесете."

#. module: hr_rfid_odoo_import
#. odoo-python
