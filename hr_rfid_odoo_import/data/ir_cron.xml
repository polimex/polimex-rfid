<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Active from the start and on a long interval: the transfer wakes
             this up itself the moment it is queued. A scheduled job left
             inactive never runs, not even when triggered - the readiness
             check requires active to be true - and it would fail silently. -->
        <record id="ir_cron_import_run" model="ir.cron">
            <field name="name">RFID: continue data transfers</field>
            <field name="model_id" ref="model_hr_rfid_odoo_import_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
