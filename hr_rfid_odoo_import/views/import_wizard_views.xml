<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ════════════════════════════════════════════════════ -->
        <!-- Wizard Form View -->
        <!-- ════════════════════════════════════════════════════ -->
        <record id="hr_rfid_odoo_import_wiz_form" model="ir.ui.view">
            <field name="name">hr.rfid.odoo.import.wiz.form</field>
            <field name="model">hr.rfid.odoo.import.wiz</field>
            <field name="arch" type="xml">
                <form string="Import RFID Data from Odoo">
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="connection,configure,confirm,importing,done"
                               options="{'clickable': false}"/>
                    </header>
                    <sheet>
                        <!-- Warnings (step 3). Rendered here rather than with a
                             widget: the only widget that fits lives in another
                             module, and when that module is absent the field
                             falls back to printing its raw contents. -->
                        <div class="alert alert-danger" role="alert"
                             invisible="state != 'confirm' or not has_blocking">
                            <strong>Sort this out before starting</strong>
                            <field name="blocking_html" nolabel="1" readonly="1"/>
                        </div>
                        <div class="alert alert-warning" role="alert"
                             invisible="state != 'confirm' or not has_advisory">
                            <strong>Worth knowing</strong>
                            <field name="advisory_html" nolabel="1" readonly="1"/>
                        </div>

                        <!-- ══ Step 1: Connection ══════════════════ -->
                        <div invisible="state != 'connection'">
                            <div class="alert alert-info text-center" role="status">
                                Connect to the source Odoo instance to import RFID access control data.
                                The source server must be running and accessible.
                            </div>
                            <group string="Source Odoo Connection">
                                <group>
                                    <field name="source_url" placeholder="https://erp.example.com"/>
                                    <field name="source_db" placeholder="my_database"/>
                                </group>
                                <group>
                                    <field name="source_login"/>
                                    <field name="source_password" password="True"/>
                                </group>
                                <!-- The blocking warning about a second source
                                     tells the operator to name the system here.
                                     Without the field on screen that warning is
                                     an instruction nobody can follow, and a
                                     genuinely different source can never be
                                     transferred at all. -->
                                <group>
                                    <field name="source_slug"
                                           placeholder="leave empty for a one-off transfer"/>
                                </group>
                            </group>
                        </div>

                        <!-- ══ Step 2: Configuration ═══════════════ -->
                        <div invisible="state != 'configure'">
                            <div class="alert alert-success" role="status">
                                <strong>Connected!</strong>
                                Source: <field name="source_version" class="d-inline" readonly="1"/>
                                | UID: <field name="source_uid" class="d-inline" readonly="1"/>
                            </div>

                            <!-- The list is the DECISION of this step, so it
                                 takes the dialog's full width. Inside a <group>
                                 it lands in one cell of a two-column grid - a
                                 quarter of the dialog, with every header
                                 truncated (odoo-wizard-guide: the choice sits
                                 outside groups; count and size the columns). -->
                            <separator string="Company Mapping"/>
                            <field name="company_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="do_import" width="40px"/>
                                    <field name="source_name" readonly="1"/>
                                    <field name="source_id" readonly="1" optional="hide"/>
                                    <field name="target_company_id"
                                           options="{'no_create': True}"/>
                                </list>
                            </field>

                            <group string="Core Import Options" col="4">
                                <field name="import_hardware"/>
                                <field name="import_people"/>
                                <field name="import_access"/>
                                <field name="import_cards"/>
                                <field name="import_cameras"/>
                                <field name="import_sites"/>
                            </group>

                            <group string="People Options"
                                   invisible="not import_people" col="4">
                                <field name="import_leaves"/>
                                <field name="import_all_partners"/>
                                <field name="import_all_employees"/>
                                <field name="import_images"/>
                                <field name="import_users"/>
                                <field name="import_user_groups"
                                       invisible="not import_users"/>
                            </group>

                            <group string="Events &amp; History" col="4">
                                <field name="import_user_events"/>
                                <field name="import_system_events"/>
                                <field name="import_th_logs"/>
                                <field name="event_date_from"
                                       invisible="not import_user_events and not import_system_events and not import_th_logs"/>
                                <field name="orphan_event_cutoff"
                                       invisible="not import_system_events"/>
                            </group>

                            <group string="Optional Modules" col="4">
                                <field name="import_vending"
                                       invisible="not source_has_vending"/>
                                <field name="import_attendance"
                                       invisible="not source_has_attendance"/>
                                <field name="import_attendance_extra"
                                       invisible="not source_has_attendance_late"/>
                                <field name="import_service"
                                       invisible="not source_has_service"/>
                            </group>

                            <!-- Warnings: source module installed but not in target -->
                            <div class="alert alert-warning" role="alert"
                                 invisible="not source_has_vending or target_has_vending">
                                <i class="fa fa-exclamation-triangle"/> Module <strong>hr_rfid_vending</strong> is installed on source but NOT on target. Install it to import vending data.
                            </div>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not source_has_attendance or target_has_attendance">
                                <i class="fa fa-exclamation-triangle"/> Module <strong>hr_attendance_multi_rfid</strong> is installed on source but NOT on target. Install it to import attendance data.
                            </div>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not source_has_attendance_late or target_has_attendance_late">
                                <i class="fa fa-exclamation-triangle"/> Module <strong>hr_attendance_late</strong> is installed on source but NOT on target. Install it to import attendance extra data.
                            </div>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not source_has_service or target_has_service">
                                <i class="fa fa-exclamation-triangle"/> Module <strong>rfid_service_base</strong> is installed on source but NOT on target. Install it to import service data.
                            </div>

                            <group string="Advanced" col="4">
                                <field name="dry_run"/>
                            </group>
                        </div>

                        <!-- ══ Step 3: Confirm / Preview ═══════════ -->
                        <div invisible="state != 'confirm'">
                            <!-- Written for the person deciding whether to
                                 press Start: an intro sentence, then plain
                                 "what: how many" lines - no monospace dump,
                                 no ASCII frames (odoo-wizard-guide: the long
                                 generated text sits below the decisions;
                                 odoo-ux-standards #18: wizards open with a
                                 conversational intro). -->
                            <p>
                                Here is what the other system holds for the
                                companies you picked. Nothing has been touched
                                yet - the transfer starts only when you press
                                the button below, and then runs on its own.
                            </p>
                            <separator string="What will come across"/>
                            <field name="preview_text" readonly="1"
                                   widget="text" nolabel="1"/>
                            <p class="text-muted">
                                <i class="fa fa-lightbulb-o" role="img"/>
                                Records that are already here are recognised
                                and will not be duplicated.
                            </p>

                            <separator string="Conflicts Found"
                                       invisible="not conflict_ids"/>
                            <div invisible="not conflict_ids">
                                <field name="conflict_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="source_model" readonly="1"/>
                                        <field name="source_name" readonly="1"/>
                                        <field name="source_ref" readonly="1"/>
                                        <field name="target_name" readonly="1"/>
                                        <field name="conflict_field" readonly="1"
                                               optional="hide"/>
                                        <!-- Умишлено БЕЗ required: празно значи
                                             "още не е решено" и спира импорта с
                                             обяснимо предупреждение, вместо с
                                             "невалидно поле". -->
                                        <field name="resolution"/>
                                    </list>
                                </field>
                            </div>
                            <div invisible="conflict_ids" class="text-success text-center mb-3">
                                <strong>No conflicts detected.</strong>
                            </div>
                        </div>

                        <!-- ══ Step 4: Importing ═══════════════════ -->
                        <div invisible="state != 'importing'" class="text-center">
                            <div class="mb-3">
                                <span class="spinner-border spinner-border-sm me-2"/>
                                <strong>Import in progress...</strong>
                            </div>
                            <field name="progress_percent" widget="progressbar"
                                   options="{'editable': false}" class="mb-3"/>
                            <field name="progress_text" readonly="1"
                                   widget="text" class="text-start"/>
                        </div>

                        <!-- ══ Step 5: Done ════════════════════════ -->
                        <div invisible="state != 'done'">
                            <div invisible="not error_message"
                                 class="alert alert-danger" role="alert">
                                <strong>Import Error:</strong>
                                <field name="error_message" readonly="1" nolabel="1"/>
                            </div>
                            <div invisible="error_message"
                                 class="alert alert-success text-center" role="status">
                                <strong>Import completed successfully!</strong>
                            </div>
                            <div class="alert alert-info" role="status">
                                The transfer now runs in the background. Its progress
                                and the account of what it moved are on the
                                Data Transfers page.
                            </div>
                        </div>
                    </sheet>

                    <footer>
                        <!-- Step 1 buttons -->
                        <button string="Test Connection" name="action_test_connection"
                                type="object" class="btn-primary"
                                invisible="state != 'connection'"/>

                        <!-- Step 2 buttons -->
                        <button string="Preview" name="action_preview"
                                type="object" class="btn-primary"
                                invisible="state != 'configure'"/>

                        <!-- Step 3 buttons -->
                        <button string="Start Import" name="action_import"
                                type="object" class="btn-primary btn-lg"
                                invisible="state != 'confirm'"
                                confirm="This will import data from the source Odoo instance. Continue?"/>

                        <!-- Step 5 buttons -->
                        <button string="Close" special="cancel" class="btn-primary"
                                invisible="state != 'done'"/>

                        <!-- Back buttons -->
                        <button string="Back" name="action_back" type="object"
                                class="btn-secondary"
                                invisible="state not in ('configure', 'confirm')"/>

                        <!-- Cancel button -->
                        <button string="Cancel" special="cancel" class="btn-secondary"
                                invisible="state in ('importing', 'done')"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- Action & Menu -->
        <!-- ════════════════════════════════════════════════════ -->
        <record id="hr_rfid_odoo_import_wiz_action" model="ir.actions.act_window">
            <field name="name">Import from Odoo</field>
            <field name="res_model">hr.rfid.odoo.import.wiz</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="hr_rfid_odoo_import_wiz_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="hr_rfid_odoo_import_menu"
                  name="Import from Odoo"
                  parent="hr_rfid.hr_rfid_root_menu_hardware_manager"
                  action="hr_rfid_odoo_import_wiz_action"
                  groups="base.group_system"
                  sequence="85"/>
    </data>
</odoo>
