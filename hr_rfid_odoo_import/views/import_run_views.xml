<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_rfid_odoo_import_run_list" model="ir.ui.view">
            <field name="name">hr.rfid.odoo.import.run.list</field>
            <field name="model">hr.rfid.odoo.import.run</field>
            <field name="arch" type="xml">
                <list string="Data Transfers" create="0">
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="create_date"/>
                    <field name="current_phase"/>
                    <field name="progress" widget="progressbar"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'done'"
                           decoration-danger="state == 'failed'"
                           decoration-info="state == 'running'"/>
                </list>
            </field>
        </record>

        <record id="hr_rfid_odoo_import_run_form" model="ir.ui.view">
            <field name="name">hr.rfid.odoo.import.run.form</field>
            <field name="model">hr.rfid.odoo.import.run</field>
            <field name="arch" type="xml">
                <form string="Data Transfer" create="0">
                    <header>
                        <!-- The bar does not move on its own, so there has to
                             be a way to look again. It must not be the primary
                             button and it must not be called "Continue":
                             operators read that as "run it now, in front of
                             me", press it on a transfer that is already
                             running, and the request collides with the worker.
                             It shows what has happened; it does not do the
                             work. -->
                        <button name="action_refresh" type="object"
                                string="Look again"
                                invisible="state in ('done', 'failed')"/>
                        <!-- The full protocol, untruncated, as one file the
                             operator can attach to a support conversation. -->
                        <button name="action_download_protocol" type="object"
                                string="Download the protocol"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="queued,running,done"/>
                    </header>
                    <sheet>
                        <!-- Shown while the transfer is waiting as well as
                             while it runs. Waiting with no explanation and a
                             button beside it is what made operators press the
                             button to "get it going". -->
                        <div class="alert alert-info" role="status"
                             invisible="state not in ('queued', 'running')">
                            The transfer runs on its own, a piece at a time, and
                            carries on if the server restarts. You can close this
                            page and come back to it. The figures here are from the
                            moment the page was opened - press Look again to see
                            how far it has got.
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id" readonly="1"/>
                                <field name="source_url" readonly="1"/>
                                <field name="source_db" readonly="1"/>
                            </group>
                            <group>
                                <field name="current_phase" readonly="1"/>
                                <field name="progress" widget="progressbar" readonly="1"/>
                                <field name="done_count" readonly="1"/>
                                <field name="total_count" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="What happened" name="log">
                                <p class="text-muted">
                                    One line per step. "Skipped" lines say why that
                                    kind of data was left behind.
                                </p>
                                <field name="log_ids" nolabel="1" readonly="1">
                                    <list create="0" delete="0">
                                        <field name="phase"/>
                                        <field name="model"/>
                                        <field name="source_count"/>
                                        <field name="imported_count"/>
                                        <field name="linked_count" optional="show"/>
                                        <field name="skipped_count" optional="show"/>
                                        <field name="rejected_count" optional="hide"/>
                                        <field name="duration" optional="hide"/>
                                        <field name="status" widget="badge"
                                               decoration-danger="status == 'error'"
                                               decoration-warning="status == 'skipped'"/>
                                        <field name="error_message"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="hr_rfid_odoo_import_run_action" model="ir.actions.act_window">
            <field name="name">Data Transfers</field>
            <field name="res_model">hr.rfid.odoo.import.run</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No data has been transferred here yet
                </p>
                <p>
                    A transfer copies access control data from another Odoo system
                    into this one - the equipment, the people, the cards and the
                    history. Start one from Import from Odoo; it will appear here
                    and keep going in the background.
                </p>
                <p>
                    Every transfer keeps an account of what it moved and, just as
                    importantly, what it could not.
                </p>
            </field>
        </record>

        <menuitem id="hr_rfid_odoo_import_run_menu"
                  name="Data Transfers"
                  parent="hr_rfid.hr_rfid_root_menu_hardware_manager"
                  action="hr_rfid_odoo_import_run_action"
                  groups="base.group_system"
                  sequence="90"/>
    </data>
</odoo>
