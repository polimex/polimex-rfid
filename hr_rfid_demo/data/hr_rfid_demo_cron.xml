<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The demo keeps working: every quarter of an hour, the passages since
         the last run. It does nothing on a database with real hardware
         (hr.rfid.demo._demo_hardware), or without the demo hardware. -->
        <record id="hr_rfid_demo_cron" model="ir.cron">
            <field name="name">RFID Demo: simulate the passages since the last run</field>
            <field name="model_id" ref="model_hr_rfid_demo"/>
            <field name="state">code</field>
            <field name="code">model._cron_simulate()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="priority">30</field>
            <field name="active" eval="True"/>
        </record>
</odoo>
