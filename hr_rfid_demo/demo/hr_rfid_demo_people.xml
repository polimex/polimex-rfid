        <!-- Two people work nights, ten in the evening to six in the
             morning, so the demo has night work to show. A night is two
             lines of a calendar: the evening, and the morning after it. -->
        <record id="demo_calendar_night" model="resource.calendar">
            <field name="name">Demo Night Shift 22:00-06:00</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="tz">Europe/Sofia</field>
            <field name="hours_per_day">8</field>
            <field name="attendance_ids" eval="[(5, 0, 0)]
                + [(0, 0, {'name': 'Night %s evening' % day, 'dayofweek': str(day), 'hour_from': 22.0, 'hour_to': 24.0, 'day_period': 'afternoon'}) for day in range(0, 5)]
                + [(0, 0, {'name': 'Night %s morning' % day, 'dayofweek': str(day), 'hour_from': 0.0, 'hour_to': 6.0, 'day_period': 'morning'}) for day in range(1, 6)]"/>
        </record>
        <!-- The people of the demo work ordinary days: morning, break,
             afternoon, one working day. hr_attendance_late's own showcase
             turns this core calendar into shifts (each range a shift of its
             own), and a full day then reads as one shift plus overtime every
             single day. -->
        <record id="resource.resource_calendar_std_38h" model="resource.calendar">
            <field name="daily_ranges_are_shifts" eval="False"/>
        </record>
        <record id="hr.employee_jod" model="hr.employee">
            <field name="resource_calendar_id" ref="demo_calendar_night"/>
        </record>
        <record id="hr.employee_jgo" model="hr.employee">
            <field name="resource_calendar_id" ref="demo_calendar_night"/>
        </record>
</odoo>
