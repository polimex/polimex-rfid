<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Mark the wristband report as a label report for automatic printer selection -->
        <record id="rfid_service_zpl_labels.action_report_rfid_wristband" model="ir.actions.report">
            <field name="label">True</field>
            <!-- Set default printing action to server (Send to Printer) -->
            <field name="property_printing_action_id" ref="base_report_to_printer.printing_action_1"/>
        </record>
    </data>
</odoo>