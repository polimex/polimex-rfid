#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_access_group_action
msgid ""
"<strong>How long</strong> the access is valid (activation and expiration "
"dates)"
msgstr ""
"<strong>За колко време</strong> е валиден достъпът (дати на активиране и "
"изтичане)"

#. module: hr_rfid
#: model_terms:ir.ui.view,arch_db:hr_rfid.hr_rfid_controller_ts_wiz
msgid ""
"<strong>How to configure access times:</strong><br/>\n"
"                                • Each day can have up to 4 separate access "
"periods<br/>\n"
"                                • Enter times in 24-hour format (e.g., 8:30 "
"= 8:30, 17:45 = 17:45)<br/>\n"
"                                • Leave begin and end at 0:00 to skip an "
"interval<br/>\n"
"                                • Holiday settings override the regular "
"weekday schedule<br/>\n"
"                                • Changes are synchronized to all "
"controllers using this schedule"
msgstr ""
"<strong>Как да конфигурирате времето за достъп:</strong><br/>\n"
"                                • Всеки ден може да има до 4 отделни периода "
"на достъп<br/>\n"
"                                • Въведете времето във 24-часов формат "
"(напр. 8:30 = 8:30, 17:45 = 17:45)<br/>\n"
"                                • Оставете началото и края на 0:00, за да "
"пропуснете интервал<br/>\n"
