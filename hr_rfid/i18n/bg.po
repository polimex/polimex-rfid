#: model:ir.model.fields,field_description:hr_rfid.field_hr_department_acc_grs__dep_id
#: model:ir.model.fields,field_description:hr_rfid.field_hr_department_add_def_acc_grs__dep_id
#: model:ir.model.fields,field_description:hr_rfid.field_hr_department_def_acc_gr__dep_id
