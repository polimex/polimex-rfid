#: model:ir.ui.menu,name:hr_rfid.hr_rfid_settings_menu
msgid "Configuration"
msgstr "Конфигурация"

#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_hr_rfid_ctrl__alarm_lines_setup
msgid ""
"Configuration data for alarm zones in hexadecimal format. Defines which "
"zones are enabled, their AC/DC monitoring settings, and sensor event "
"reporting."
msgstr ""
"Конфигурационни данни за алармените зони в шестнадесетичен формат. Определя "
"кои зони са активирани, техните настройки за AC/DC мониторинг и докладване "
"на събития от сензорите."

#. module: hr_rfid
#: model:onboarding.onboarding.step,step_image_alt:hr_rfid.onboarding_step_module_settings
#: model:onboarding.onboarding.step,title:hr_rfid.onboarding_step_module_settings
