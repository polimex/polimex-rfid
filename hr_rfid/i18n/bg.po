#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"\"After Hours Protection\" - Motion detectors that should be armed at night"
msgstr ""
"\"Защита след работно време\" - Детектори за движение, които трябва да се "
"активират през нощта"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid "\"First Floor Security\" - All sensors on the first floor"
msgstr "\"Сигурност на първия етаж\" - Всички сензори на първия етаж"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"\"Warehouse Perimeter\" - All door and window sensors around the warehouse"
msgstr ""
"\"Периметър на склада\" - Всички сензори на врати и прозорци около склада"

#. module: hr_rfid
#. odoo-python
#: code:addons/hr_rfid/models/hr_rfid_ctrl_iotable.py:0
msgid ""
"%d is not a valid number for the io table. Valid values range from 0 to 99"
msgstr ""
"%d не е валидно число за таблицата вход/изход. Валидните стойности са от 0 "
"до 99"

#. module: hr_rfid
#. odoo-python
#: code:addons/hr_rfid/models/hr_rfid_card.py:0
msgid "%s list"
msgstr "%s списък"

#. module: hr_rfid
#: model:ir.actions.report,print_report_name:hr_rfid.action_report_hr_rfid_card_foldable_badge
msgid ""
"'Foldable Badge - %s - %s' % ((object.name or 'Access Badge')."
"replace('/',''), object.get_owner().name.replace('/',''))"
msgstr ""
"'Сгъваема карта - %s - %s' % ((object.name or 'Карта за достъп')."
"replace('/',''), object.get_owner().name.replace('/',''))"

#. module: hr_rfid
#: model:ir.actions.report,print_report_name:hr_rfid.action_report_hr_employee_foldable_badge
#: model:ir.actions.report,print_report_name:hr_rfid.action_report_res_partner_foldable_badge
msgid "'Foldable Badge - %s' % (object.name or 'Access Badge').replace('/','')"
msgstr ""
"'Сгъваема карта - %s' % (object.name or 'Карта за достъп').replace('/','')"

#. module: hr_rfid
#: model:ir.model.fields.selection,name:hr_rfid.selection__hr_rfid_ctrl__relay_time_factor__1
msgid "0.1 seconds"
msgstr "0,1 секунди"

#. module: hr_rfid
#: model:ir.model.fields.selection,name:hr_rfid.selection__hr_rfid_ctrl__relay_time_factor__0
msgid "1 second"
msgstr "1 секунда"

#. module: hr_rfid
#: model:ir.model.fields.selection,name:hr_rfid.selection__hr_rfid_ctrl__mode_selection_31__1
msgid "1 x 32 Relays"
msgstr "1 x 32 релета"

#. module: hr_rfid
#: model:ir.model.fields.selection,name:hr_rfid.selection__hr_rfid_ctrl__mode_selection_31__3
msgid "1 x 512 Relays"
msgstr "1 x 512 релета"

#. module: hr_rfid
#: model:ir.model.fields.selection,name:hr_rfid.selection__hr_rfid_event_system__event_action__45
#: model:ir.model.fields.selection,name:hr_rfid.selection__hr_rfid_notification__system_event__45
msgid "1-W ERROR (wiring problems)"
msgstr "1-W ГРЕШКА (проблеми с окабеляването)"

#. module: hr_rfid
#: model:ir.model.fields.selection,name:hr_rfid.selection__hr_rfid_command__error__13
msgid "1-Wire Error"
msgstr "Грешка в 1-Wire"

#. module: hr_rfid
#: model:ir.model.fields.selection,name:hr_rfid.selection__hr_rfid_ctrl__mode_selection_31__2
msgid "2 x 16 Relays"
msgstr "2 x 16 релета"

#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_res_partner__hr_rfid_pin_code
#: model:ir.model.fields,help:hr_rfid.field_res_users__hr_rfid_pin_code
msgid ""
"4-digit PIN code for secure door access. Use this along with an RFID card "
"for high-security areas. Default \"0000\" means no PIN required - the card "
"alone grants access. Change this to add an extra security layer."
msgstr ""
"4-цифрен ПИН код за сигурен достъп до врати. Използвайте го заедно с RFID "
"карта за зони с висока сигурност. По подразбиране \"0000\" означава, че не "
"се изисква ПИН - само картата дава достъп. Променете това, за да добавите "
"допълнително ниво на сигурност."

#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_hr_employee__hr_rfid_pin_code
msgid ""
"4-digit PIN code for secure door access. Used in combination with RFID cards "
"for two-factor authentication. Default '0000' means no PIN required. The PIN "
"must be entered on door readers when accessing restricted areas."
msgstr ""
"4-цифрен ПИН код за сигурен достъп до врати. Използва се в комбинация с RFID "
"карти за двуфакторна автентикация. По подразбиране '0000' означава, че не се "
"изисква ПИН. ПИН кодът трябва да се въведе на четците на вратите при достъп "
"до ограничени зони."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid ""
"<b>Access Controllers</b> - Manage doors, readers, and access permissions"
msgstr ""
"<b>Контролери за достъп</b> - Управление на врати, четци и разрешения за "
"достъп"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Access Denied</b> - Failed attempts due to invalid permissions"
msgstr "<b>Отказан достъп</b> - Неуспешни опити поради невалидни разрешения"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Access Granted</b> - Successful entry/exit through doors"
msgstr "<b>Разрешен достъп</b> - Успешно влизане/излизане през врати"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Access restrictions:</b> Limit zones to specific departments or employee "
"groups"
msgstr ""
"<b>Ограничения за достъп:</b> Ограничаване на зоните до определени отдели "
"или групи служители"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Alarm Controllers</b> - Monitor security zones and sensors"
msgstr ""
"<b>Контролери на аларми</b> - Наблюдение на зоните за сигурност и сензорите"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Anti-Passback Violations</b> - Improper entry/exit sequences"
msgstr ""
"<b>Нарушения на Anti-Passback</b> - Неправилни последователности на влизане/"
"излизане"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid "<b>Anti-pass back:</b> Prevent tailgating and ensure accurate tracking"
msgstr ""
"<b>Anti-pass back:</b> Предотвратяване на опашки и осигуряване на точно "
"проследяване"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Arm/Disarm Multiple Alarms</b> - Control all sensors in a group with one "
"click"
msgstr ""
"<b>Активиране/Деактивиране на множество аларми</b> - Управление на всички "
"сензори в група с едно кликване"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Attendance tracking:</b> Automatically track work hours based on zone "
"entry/exit"
msgstr ""
"<b>Проследяване на присъствието:</b> Автоматично проследяване на работното "
"време въз основа на влизане/излизане от зоната"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>Common examples:</b><br>\n"
"                    • Regular hours: Mon-Fri 8:00-17:00<br>\n"
"                    • 24/7 access: All days 0:00-24:00<br>\n"
"                    • Weekend only: Sat-Sun 8:00-20:00<br>\n"
"                    • Night shift: All days 22:00-6:00"
msgstr ""
"<b>Често срещани примери:</b><br>\n"
"                    • Редовно работно време: Пон-Пет 8:00-17:00<br>\n"
"                    • 24/7 достъп: Всички дни 0:00-24:00<br>\n"
"                    • Само уикенд: Съб-Нед 8:00-20:00<br>\n"
"                    • Нощна смяна: Всички дни 22:00-6:00"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_workcode_action
msgid ""
"<b>Common workcode setup:</b><br>\n"
"                    • 0001 - Start Work (Clock In)<br>\n"
"                    • 0002 - Start Break (Lunch/Rest)<br>\n"
"                    • 0003 - End Break (Return from Break)<br>\n"
"                    • 0004 - End Work (Clock Out)<br>"
msgstr ""
"<b>Често срещана настройка на работни кодове:</b><br>\n"
"                    • 0001 - Начало на работа (Влизане)<br>\n"
"                    • 0002 - Начало на почивка (Обяд/Отдих)<br>\n"
"                    • 0003 - Край на почивка (Връщане от почивка)<br>\n"
"                    • 0004 - Край на работа (Излизане)<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Create Hierarchies</b> - Build parent-child relationships (e.g., Campus → "
"Building → Floor)"
msgstr ""
"<b>Създаване на йерархии</b> - Изграждане на връзки родител-дете (напр. "
"Кампус → Сграда → Етаж)"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Door Contacts</b> - Monitor if doors are opened when armed"
msgstr ""
"<b>Контакти на врати</b> - Наблюдение дали вратите са отворени, когато са "
"активирани"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Emergency Events</b> - Fire alarms, emergency buttons, evacuations"
msgstr ""
"<b>Спешни събития</b> - Пожарни аларми, бутони за спешни случаи, евакуации"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Environmental</b> - Temperature monitoring and alerts"
msgstr "<b>Околна среда</b> - Наблюдение на температурата и предупреждения"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid "<b>Example Groups:</b>"
msgstr "<b>Примерни групи:</b>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Getting Started:</b><br>\n"
"                    1. Use \"Hardware Manager → Add Module\" to register "
"your module's serial number<br>\n"
"                    2. Configure the module's network settings to connect to "
"this Odoo instance<br>\n"
"                    3. Once connected, use \"Read controllers\" to auto-"
"detect connected devices<br>"
msgstr ""
"<b>Първи стъпки:</b><br>\n"
"                    1. Използвайте \"Управление на хардуер → Добавяне на "
"модул\", за да регистрирате серийния номер на модула<br>\n"
"                    2. Конфигурирайте мрежовите настройки на модула, за да "
"се свърже с този Odoo екземпляр<br>\n"
"                    3. След като е свързан, използвайте \"Прочитане на "
"контролери\" за автоматично откриване на свързаните устройства<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Glass Break Detectors</b> - Detect breaking glass"
msgstr ""
"<b>Детектори за счупване на стъкло</b> - Откриване на счупване на стъкло"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid ""
"<b>Hardware Status</b> - Power cycles, wiring errors, communication issues"
msgstr ""
"<b>Състояние на хардуера</b> - Цикли на захранване, грешки в окабеляването, "
"проблеми с комуникацията"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>How to use:</b><br>\n"
"                    1. Click on a time schedule to open it<br>\n"
"                    2. Click the \"Details\" button to edit access "
"hours<br>\n"
"                    3. Set up to 4 time periods per day (e.g., 8:00-12:00 "
"and 13:00-17:00)<br>\n"
"                    4. Save your changes - they sync automatically to "
"controllers"
msgstr ""
"<b>Как да използвате:</b><br>\n"
"                    1. Кликнете върху времеви график, за да го отворите<br>\n"
"                    2. Кликнете върху бутона \"Детайли\", за да редактирате "
"часовете за достъп<br>\n"
"                    3. Настройте до 4 времеви периода на ден (напр. "
"8:00-12:00 и 13:00-17:00)<br>\n"
"                    4. Запазете промените - те се синхронизират автоматично "
"с контролерите"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_card_type_action
msgid ""
"<b>Important:</b> Doors must be configured to accept specific card types. \n"
"                    A card will only open doors that accept its type AND "
"when the card owner has proper access rights."
msgstr ""
"<b>Важно:</b> Вратите трябва да бъдат конфигурирани да приемат определени "
"типове карти. \n"
"                    Картата ще отваря само врати, които приемат нейния тип И "
"когато собственикът на картата има подходящи права за достъп."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>Key concepts:</b><br>\n"
"                    • <b>TS 0</b> = \"Not using TS\" - Always allows access "
"(no time restrictions)<br>\n"
"                    • <b>TS 1-15</b> = Custom schedules with specific access "
"hours<br>\n"
"                    • <b>Empty schedule</b> = Blocks all access when "
"assigned to a door<br>\n"
"                    • <b>Holiday settings</b> = Override normal weekday "
"schedules on holidays"
msgstr ""
"<b>Ключови понятия:</b><br>\n"
"                    • <b>TS 0</b> = \"Не се използва TS\" - Винаги позволява "
"достъп (без времеви ограничения)<br>\n"
"                    • <b>TS 1-15</b> = Персонализирани графици с конкретни "
"часове за достъп<br>\n"
"                    • <b>Празен график</b> = Блокира целия достъп, когато е "
"зададен на врата<br>\n"
"                    • <b>Настройки за празници</b> = Замества нормалните "
"седмични графици в празнични дни"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Module Status Indicators:</b><br>\n"
"                    🟢 Green: Active and communicating (contacted within "
"last 10 minutes)<br>\n"
"                    🟡 Yellow: Active but not communicating (check network "
"connection)<br>\n"
"                    🔴 Red: Disabled (enable to allow communication)<br>"
msgstr ""
"<b>Индикатори за състоянието на модула:</b><br>\n"
"                    🟢 Зелено: Активен и комуникиращ (осъществен контакт "
"през последните 10 минути)<br>\n"
"                    🟡 Жълто: Активен, но не комуникира (проверете мрежовата "
"връзка)<br>\n"
"                    🔴 Червено: Деактивиран (активирайте, за да позволите "
"комуникация)<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Monitor Status</b> - See if all alarms in a group are armed, disarmed, or "
"mixed"
msgstr ""
"<b>Състояние на мониторинг</b> - Вижте дали всички аларми в група са "
"активирани, деактивирани или смесени"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Motion Detectors</b> - Detect movement in protected areas"
msgstr "<b>Детектори за движение</b> - Откриване на движение в защитени зони"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Need Help?</b><br>\n"
"                    • Check module IP address and network connectivity<br>\n"
"                    • Ensure the security key matches between Odoo and the "
"module<br>\n"
"                    • Verify the module is not behind a restrictive "
"firewall<br>\n"
"                    • Contact support if you continue experiencing issues"
msgstr ""
"<b>Нужда от помощ?</b><br>\n"
"                    • Проверете IP адреса на модула и мрежовата "
"свързаност<br>\n"
"                    • Уверете се, че ключът за сигурност съвпада между Odoo "
"и модула<br>\n"
"                    • Проверете дали модулът не е зад рестриктивна защитна "
"стена<br>\n"
"                    • Свържете се с поддръжката, ако продължавате да имате "
"проблеми"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Organize by Area</b> - Group sensors by floor, building, or department"
msgstr ""
"<b>Организиране по зона</b> - Групиране на сензори по етаж, сграда или отдел"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_card_action
msgid ""
"<b>Quick tips:</b><br>\n"
"                    • Card numbers must be exactly 10 digits<br>\n"
"                    • Assign cards to employees or contacts, not both<br>\n"
"                    • Use activation/deactivation dates for temporary "
"access<br>\n"
"                    • Card types determine which doors can be opened<br>\n"
"                    • Access rights come from the owner's access groups"
msgstr ""
"<b>Бързи съвети:</b><br>\n"
"                    • Номерата на картите трябва да са точно 10 цифри<br>\n"
"                    • Присвоявайте карти на служители или контакти, но не и "
"на двете<br>\n"
"                    • Използвайте дати на активиране/деактивиране за "
"временен достъп<br>\n"
"                    • Типовете карти определят кои врати могат да се "
"отварят<br>\n"
"                    • Правата за достъп идват от групите за достъп на "
"собственика"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_reader_action
msgid ""
"<b>Reader Modes:</b><br>\n"
"                    • <b>Card Only</b> - Simple card scan for access<br>\n"
"                    • <b>Card + PIN</b> - Enhanced security with PIN "
"verification<br>\n"
"                    • <b>Card + Workcode</b> - For tracking time on specific "
"projects<br>\n"
"                    • <b>Card or PIN</b> - Flexible access with either method"
msgstr ""
"<b>Режими на четец:</b><br>\n"
"                    • <b>Само карта</b> - Просто сканиране на карта за "
"достъп<br>\n"
"                    • <b>Карта + ПИН</b> - Подобрена сигурност с проверка на "
"ПИН<br>\n"
"                    • <b>Карта + Работен код</b> - За проследяване на "
"времето по конкретни проекти<br>\n"
"                    • <b>Карта или ПИН</b> - Гъвкав достъп с всеки от "
"методите"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_reader_action
msgid ""
"<b>Reader Types:</b><br>\n"
"                    • <b>In (Entry)</b> - Records when someone enters an "
"area<br>\n"
"                    • <b>Out (Exit)</b> - Records when someone leaves an area"
msgstr ""
"<b>Типове четци:</b><br>\n"
"                    • <b>Вход</b> - Записва, когато някой влиза в зона<br>\n"
"                    • <b>Изход</b> - Записва, когато някой напуска зона"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid "<b>Real-time occupancy:</b> See who is currently in each zone"
msgstr "<b>Заетост в реално време:</b> Вижте кой в момента е във всяка зона"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid ""
"<b>Relay Controllers</b> - Control multiple relay outputs for various "
"equipment"
msgstr ""
"<b>Релейни контролери</b> - Управление на множество релейни изходи за "
"различно оборудване"

