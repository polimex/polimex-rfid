#. module: hr_rfid
#: model:ir.model.fields,field_description:hr_rfid.field_hr_rfid_access_group__default_department_ids
msgid "Department (Default)"
msgstr "Отдел (По подразбиране)"

#. module: hr_rfid
#: model:ir.model,name:hr_rfid.model_hr_department_acc_grs
msgid "Department Access Group Configuration"
