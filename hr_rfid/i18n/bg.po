#: code:addons/hr_rfid/models/res_partner.py:0
msgid "Send Barcode card - Compose Email"
msgstr "Изпращане на баркод карта – Съставяне на имейл"

#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_hr_rfid_notification__notify_followers
msgid ""
"Send notifications to all users who follow this zone. This is useful for "
"security teams or managers who need to monitor all activity in an area."
msgstr ""
"Изпращайте известия до всички потребители, които следят тази зона. Това е "
"полезно за екипите по сигурността или мениджърите, които трябва да "
"наблюдават цялата активност в дадена област."

#. module: hr_rfid
#: model:ir.model.fields.selection,name:hr_rfid.selection__hr_rfid_command__cmd__db2
msgid "Sending Balance To Vending Machine"
msgstr "Изпращане на баланс към вендинг машина"

