#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_res_partner__hr_rfid_pin_code
#: model:ir.model.fields,help:hr_rfid.field_res_users__hr_rfid_pin_code
msgid ""
"4-digit PIN code for secure door access. Use this along with an RFID card "
"for high-security areas. Default \"0000\" means no PIN required - the card "
"alone grants access. Change this to add an extra security layer."
msgstr ""
"4-stelliger PIN-Code für den sicheren Türzugang. Verwenden Sie diesen "
"zusammen mit einer RFID-Karte für Hochsicherheitsbereiche. Standard \"0000\""
" bedeutet, dass kein PIN erforderlich ist - die Karte allein gewährt "
"Zutritt. Ändern Sie diesen, um eine zusätzliche Sicherheitsebene "
"hinzuzufügen."

#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_hr_employee__hr_rfid_pin_code
msgid ""
"4-digit PIN code for secure door access. Used in combination with RFID cards"
" for two-factor authentication. Default '0000' means no PIN required. The "
"PIN must be entered on door readers when accessing restricted areas."
msgstr ""
"4-stelliger PIN-Code für den sicheren Türzugang. Wird in Kombination mit "
"RFID-Karten zur Zwei-Faktor-Authentifizierung verwendet. Standard '0000' "
"bedeutet, dass kein PIN erforderlich ist. Der PIN muss an Türlesern "
"eingegeben werden, wenn auf gesperrte Bereiche zugegriffen wird."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid ""
"<b>Access Controllers</b> - Manage doors, readers, and access permissions"
msgstr ""
"<b>Zutrittskontroll-Controller</b> - Türen, Leser und Zutrittsrechte "
"verwalten"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Access Denied</b> - Failed attempts due to invalid permissions"
msgstr ""
"<b>Zugang verweigert</b> - Fehlgeschlagene Versuche aufgrund ungültiger "
"Berechtigungen"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Access Granted</b> - Successful entry/exit through doors"
msgstr "<b>Zugang gewährt</b> - Erfolgreicher Zutritt/Austritt durch Türen"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Access restrictions:</b> Limit zones to specific departments or employee "
"groups"
msgstr ""
"<b>Zutrittsbeschränkungen:</b> Zonen auf bestimmte Abteilungen oder "
"Mitarbeitergruppen beschränken"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Alarm Controllers</b> - Monitor security zones and sensors"
msgstr "<b>Alarm-Controller</b> - Sicherheitsbereiche und Sensoren überwachen"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Anti-Passback Violations</b> - Improper entry/exit sequences"
msgstr ""
"<b>Anti-Passback-Verstöße</b> - Unzulässige Zutritts-/Austrittssequenzen"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid "<b>Anti-pass back:</b> Prevent tailgating and ensure accurate tracking"
msgstr ""
"<b>Anti-Passback:</b> Tailgating verhindern und eine genaue Nachverfolgung "
"gewährleisten"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Arm/Disarm Multiple Alarms</b> - Control all sensors in a group with one "
"click"
msgstr ""
"<b>Mehrere Alarme scharf/unscharf schalten</b> - Alle Sensoren einer Gruppe "
"mit einem Klick steuern"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Attendance tracking:</b> Automatically track work hours based on zone "
"entry/exit"
msgstr ""
"<b>Anwesenheitsverfolgung:</b> Arbeitszeiten automatisch anhand des "
"Betretens/Verlassens von Zonen erfassen"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>Common examples:</b><br>\n"
"                    • Regular hours: Mon-Fri 8:00-17:00<br>\n"
"                    • 24/7 access: All days 0:00-24:00<br>\n"
"                    • Weekend only: Sat-Sun 8:00-20:00<br>\n"
"                    • Night shift: All days 22:00-6:00"
msgstr ""
"<b>Häufige Beispiele:</b><br>\n"
"                    • Reguläre Zeiten: Mo–Fr 8:00–17:00<br>\n"
"                    • 24/7-Zugang: Alle Tage 0:00–24:00<br>\n"
"                    • Nur Wochenende: Sa–So 8:00–20:00<br>\n"
"                    • Nachtschicht: Alle Tage 22:00–6:00"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_workcode_action
msgid ""
"<b>Common workcode setup:</b><br>\n"
"                    • 0001 - Start Work (Clock In)<br>\n"
"                    • 0002 - Start Break (Lunch/Rest)<br>\n"
"                    • 0003 - End Break (Return from Break)<br>\n"
"                    • 0004 - End Work (Clock Out)<br>"
msgstr ""
"<b>Typische Arbeitscode-Einrichtung:</b><br>\n"
"                    • 0001 - Arbeit beginnen (Einstempeln)<br>\n"
"                    • 0002 - Pause beginnen (Mittag/Pause)<br>\n"
"                    • 0003 - Pause beenden (Rückkehr von Pause)<br>\n"
"                    • 0004 - Arbeit beenden (Ausstempeln)<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Create Hierarchies</b> - Build parent-child relationships (e.g., Campus →"
" Building → Floor)"
msgstr ""
"<b>Hierarchien erstellen</b> - Übergeordnete/untergeordnete Beziehungen "
"aufbauen (z. B. Campus → Gebäude → Etage)"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Door Contacts</b> - Monitor if doors are opened when armed"
msgstr ""
"<b>Türkontakte</b> - Überwachen, ob Türen im scharfen Zustand geöffnet "
"werden"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Emergency Events</b> - Fire alarms, emergency buttons, evacuations"
msgstr "<b>Notfallereignisse</b> - Feueralarme, Notfallknöpfe, Evakuierungen"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Environmental</b> - Temperature monitoring and alerts"
msgstr "<b>Umgebungsüberwachung</b> - Temperaturüberwachung und Warnmeldungen"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid "<b>Example Groups:</b>"
msgstr "<b>Beispielgruppen:</b>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Getting Started:</b><br>\n"
"                    1. Use \"Hardware Manager → Add Module\" to register your module's serial number<br>\n"
"                    2. Configure the module's network settings to connect to this Odoo instance<br>\n"
"                    3. Once connected, use \"Read controllers\" to auto-detect connected devices<br>"
msgstr ""
"<b>Erste Schritte:</b><br>\n"
"                    1. Verwenden Sie \"Hardware-Manager → Modul hinzufügen\", um die Seriennummer Ihres Moduls zu registrieren<br>\n"
"                    2. Konfigurieren Sie die Netzwerkeinstellungen des Moduls, um eine Verbindung zu dieser Odoo-Instanz herzustellen<br>\n"
"                    3. Sobald verbunden, verwenden Sie \"Controller lesen\", um angeschlossene Geräte automatisch zu erkennen<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Glass Break Detectors</b> - Detect breaking glass"
msgstr "<b>Glasbruchmelder</b> - Glasbruch erkennen"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid ""
"<b>Hardware Status</b> - Power cycles, wiring errors, communication issues"
msgstr ""
"<b>Hardwarestatus</b> - Spannungszyklen, Verdrahtungsfehler, "
"Kommunikationsprobleme"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>How to use:</b><br>\n"
"                    1. Click on a time schedule to open it<br>\n"
"                    2. Click the \"Details\" button to edit access hours<br>\n"
"                    3. Set up to 4 time periods per day (e.g., 8:00-12:00 and 13:00-17:00)<br>\n"
"                    4. Save your changes - they sync automatically to controllers"
msgstr ""
"<b>So verwenden Sie es:</b><br>\n"
"                    1. Klicken Sie auf einen Zeitplan, um ihn zu öffnen<br>\n"
"                    2. Klicken Sie auf die Schaltfläche \"Details\", um die Zutrittszeiten zu bearbeiten<br>\n"
"                    3. Legen Sie bis zu 4 Zeiträume pro Tag fest (z. B. 8:00–12:00 und 13:00–17:00)<br>\n"
"                    4. Speichern Sie Ihre Änderungen – sie werden automatisch mit den Controllern synchronisiert"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_card_type_action
msgid ""
"<b>Important:</b> Doors must be configured to accept specific card types. \n"
"                    A card will only open doors that accept its type AND when the card owner has proper access rights."
msgstr ""
"<b>Wichtig:</b> Türen müssen so konfiguriert sein, dass sie bestimmte Kartentypen akzeptieren. \n"
"                    Eine Karte öffnet nur Türen, die ihren Typ akzeptieren UND wenn der Karteninhaber über die entsprechenden Zutrittsrechte verfügt."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>Key concepts:</b><br>\n"
"                    • <b>TS 0</b> = \"Not using TS\" - Always allows access (no time restrictions)<br>\n"
"                    • <b>TS 1-15</b> = Custom schedules with specific access hours<br>\n"
"                    • <b>Empty schedule</b> = Blocks all access when assigned to a door<br>\n"
"                    • <b>Holiday settings</b> = Override normal weekday schedules on holidays"
msgstr ""
"<b>Wichtige Konzepte:</b><br>\n"
"                    • <b>TS 0</b> = \"Kein Zeitplan\" - Gewährt immer Zugang (keine Zeitbeschränkungen)<br>\n"
"                    • <b>TS 1-15</b> = Benutzerdefinierte Zeitpläne mit spezifischen Zutrittszeiten<br>\n"
"                    • <b>Leerer Zeitplan</b> = Sperrt bei Zuweisung zu einer Tür sämtlichen Zugang<br>\n"
"                    • <b>Feiertagseinstellungen</b> = Überschreiben normale Wochentag-Zeitpläne an Feiertagen"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Module Status Indicators:</b><br>\n"
"                    🟢 Green: Active and communicating (contacted within last 10 minutes)<br>\n"
"                    🟡 Yellow: Active but not communicating (check network connection)<br>\n"
"                    🔴 Red: Disabled (enable to allow communication)<br>"
msgstr ""
"<b>Modulstatus-Anzeigen:</b><br>\n"
"                    🟢 Grün: Aktiv und kommunizierend (zuletzt innerhalb der letzten 10 Minuten kontaktiert)<br>\n"
"                    🟡 Gelb: Aktiv, aber keine Kommunikation (Netzwerkverbindung prüfen)<br>\n"
"                    🔴 Rot: Deaktiviert (aktivieren, um Kommunikation zu ermöglichen)<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Monitor Status</b> - See if all alarms in a group are armed, disarmed, or"
" mixed"
msgstr ""
"<b>Status überwachen</b> - Anzeigen, ob alle Alarme einer Gruppe scharf, "
"unscharf oder gemischt sind"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Motion Detectors</b> - Detect movement in protected areas"
msgstr "<b>Bewegungsmelder</b> - Bewegungen in gesicherten Bereichen erkennen"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Need Help?</b><br>\n"
"                    • Check module IP address and network connectivity<br>\n"
"                    • Ensure the security key matches between Odoo and the module<br>\n"
"                    • Verify the module is not behind a restrictive firewall<br>\n"
"                    • Contact support if you continue experiencing issues"
msgstr ""
"<b>Hilfe benötigt?</b><br>\n"
"                    • IP-Adresse und Netzwerkverbindung des Moduls prüfen<br>\n"
"                    • Sicherstellen, dass der Sicherheitsschlüssel in Odoo und im Modul übereinstimmt<br>\n"
"                    • Überprüfen, ob das Modul nicht hinter einer restriktiven Firewall liegt<br>\n"
"                    • Support kontaktieren, wenn das Problem weiterhin besteht"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Organize by Area</b> - Group sensors by floor, building, or department"
msgstr ""
"<b>Nach Bereich organisieren</b> - Sensoren nach Etage, Gebäude oder "
"Abteilung gruppieren"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_card_action
msgid ""
"<b>Quick tips:</b><br>\n"
"                    • Card numbers must be exactly 10 digits<br>\n"
"                    • Assign cards to employees or contacts, not both<br>\n"
"                    • Use activation/deactivation dates for temporary access<br>\n"
"                    • Card types determine which doors can be opened<br>\n"
"                    • Access rights come from the owner's access groups"
msgstr ""
"<b>Schnelltipps:</b><br>\n"
"                    • Kartennummern müssen genau 10 Stellen haben<br>\n"
"                    • Karten Mitarbeitern oder Kontakten zuweisen, nicht beiden<br>\n"
"                    • Aktivierungs-/Deaktivierungsdaten für temporären Zugang verwenden<br>\n"
"                    • Kartentypen bestimmen, welche Türen geöffnet werden können<br>\n"
"                    • Zutrittsrechte stammen aus den Zutrittsgruppen des Inhabers"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_reader_action
msgid ""
"<b>Reader Modes:</b><br>\n"
"                    • <b>Card Only</b> - Simple card scan for access<br>\n"
"                    • <b>Card + PIN</b> - Enhanced security with PIN verification<br>\n"
"                    • <b>Card + Workcode</b> - For tracking time on specific projects<br>\n"
"                    • <b>Card or PIN</b> - Flexible access with either method"
msgstr ""
"<b>Lesermodi:</b><br>\n"
"                    • <b>Nur Karte</b> - Einfaches Kartenlesen für den Zugang<br>\n"
"                    • <b>Karte + PIN</b> - Erhöhte Sicherheit mit PIN-Überprüfung<br>\n"
"                    • <b>Karte + Arbeitscode</b> - Zur Zeiterfassung für bestimmte Projekte<br>\n"
"                    • <b>Karte oder PIN</b> - Flexibler Zugang mit einer der beiden Methoden"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_reader_action
msgid ""
"<b>Reader Types:</b><br>\n"
"                    • <b>In (Entry)</b> - Records when someone enters an area<br>\n"
"                    • <b>Out (Exit)</b> - Records when someone leaves an area"
msgstr ""
"<b>Lesertypen:</b><br>\n"
"                    • <b>Ein (Eingang)</b> - Erfasst, wenn jemand einen Bereich betritt<br>\n"
"                    • <b>Aus (Ausgang)</b> - Erfasst, wenn jemand einen Bereich verlässt"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid "<b>Real-time occupancy:</b> See who is currently in each zone"
msgstr ""
"<b>Echtzeit-Belegung:</b> Anzeigen, wer sich aktuell in welcher Zone "
"befindet"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid ""
"<b>Relay Controllers</b> - Control multiple relay outputs for various "
"equipment"
msgstr ""
"<b>Relais-Controller</b> - Mehrere Relaisausgänge für verschiedene Geräte "
"steuern"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Safety compliance:</b> Monitor zone capacity for emergency evacuations"
msgstr ""
"<b>Sicherheitskonformität:</b> Zonenkapazität für Notfallevakuierungen "
"überwachen"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Security Alerts</b> - Forced doors, overtime, tamper attempts"
msgstr ""
"<b>Sicherheitswarnungen</b> - Aufgebrochene Türen, Zeitüberschreitungen, "
"Manipulationsversuche"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Temperature Controllers</b> - Monitor environmental conditions"
msgstr "<b>Temperatur-Controller</b> - Umgebungsbedingungen überwachen"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Time Schedule Errors</b> - Access outside allowed hours"
msgstr "<b>Zeitplanfehler</b> - Zugang außerhalb der erlaubten Zeiten"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Turnstile Controllers</b> - Manage turnstile access points"
msgstr "<b>Drehkreuz-Controller</b> - Drehkreuz-Zugangspunkte verwalten"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid ""
"<b>Unknown Cards</b> - Unregistered card presentations for easy enrollment"
msgstr ""
"<b>Unbekannte Karten</b> - Präsentationen nicht registrierter Karten zur "
"einfachen Registrierung"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>What are Modules?</b><br>\n"
"                    Modules (WebStacks) are network devices that manage communication between Odoo and your access control hardware (controllers, doors, and card readers)."
msgstr ""
"<b>Was sind Module?</b><br>\n"
"                    Module (WebStacks) sind Netzwerkgeräte, die die Kommunikation zwischen Odoo und Ihrer Zutrittskontrollhardware (Controller, Türen und Kartenleser) verwalten."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Window Sensors</b> - Alert when windows are opened"
msgstr "<b>Fenstersensoren</b> - Alarm bei geöffneten Fenstern"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Zone Controls</b> - Security zone arming/disarming"
