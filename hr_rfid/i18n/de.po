#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_hr_rfid_notification__notify_followers
msgid ""
"Send notifications to all users who follow this zone. This is useful for "
"security teams or managers who need to monitor all activity in an area."
msgstr ""
"Senden Sie Benachrichtigungen an alle Benutzer, die diese Zone abonniert "
"haben. Dies ist nützlich für Sicherheitsteams oder Manager, die alle "
"Aktivitäten in einem Bereich überwachen müssen."

#. module: hr_rfid
#: model:ir.model.fields.selection,name:hr_rfid.selection__hr_rfid_command__cmd__db2
msgid "Sending Balance To Vending Machine"
msgstr "Guthaben an den Verkaufsautomaten senden"

