#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"\"After Hours Protection\" - Motion detectors that should be armed at night"
msgstr ""
"\"After Hours Protection\" - Detectoare de mișcare care ar trebui activate "
"noaptea"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid "\"First Floor Security\" - All sensors on the first floor"
msgstr "\"First Floor Security\" - Toți senzorii de pe primul etaj"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid "\"Warehouse Perimeter\" - All door and window sensors around the warehouse"
msgstr ""
"\"Warehouse Perimeter\" - Toți senzorii de ușă și de fereastră din jurul "
"depozitului"

