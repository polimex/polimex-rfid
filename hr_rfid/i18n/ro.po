#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_res_partner__hr_rfid_pin_code
#: model:ir.model.fields,help:hr_rfid.field_res_users__hr_rfid_pin_code
msgid ""
"4-digit PIN code for secure door access. Use this along with an RFID card "
"for high-security areas. Default \"0000\" means no PIN required - the card "
"alone grants access. Change this to add an extra security layer."
msgstr ""
"Cod PIN de 4 cifre pentru acces securizat la ușă. Utilizați-l împreună cu o "
"cartelă RFID pentru zonele de înaltă securitate. Valoarea implicită \"0000\""
" înseamnă că nu este necesar un cod PIN - cartela singură acordă accesul. "
"Modificați-l pentru a adăuga un nivel suplimentar de securitate."

#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_hr_employee__hr_rfid_pin_code
msgid ""
"4-digit PIN code for secure door access. Used in combination with RFID cards"
" for two-factor authentication. Default '0000' means no PIN required. The "
"PIN must be entered on door readers when accessing restricted areas."
msgstr ""
"Cod PIN de 4 cifre pentru acces securizat la ușă. Utilizat în combinație cu "
"carduri RFID pentru autentificarea în doi factori. Valoarea implicită '0000'"
" înseamnă că nu este necesar un cod PIN. Codul PIN trebuie introdus la "
"cititoarele de la ușă când se accesează zonele restricționate."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid ""
"<b>Access Controllers</b> - Manage doors, readers, and access permissions"
msgstr ""
"<b>Controlere de acces</b> - Gestionați ușile, cititoarele și permisiunile "
"de acces"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Access Denied</b> - Failed attempts due to invalid permissions"
msgstr ""
"<b>Acces refuzat</b> - Tentative eșuate din cauza permisiunilor invalide"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Access Granted</b> - Successful entry/exit through doors"
msgstr "<b>Acces acordat</b> - Intrare/ieșire reușită prin uși"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Access restrictions:</b> Limit zones to specific departments or employee "
"groups"
msgstr ""
"<b>Restricții de acces:</b> Limitați zonele la departamente specifice sau "
"grupuri de angajați"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Alarm Controllers</b> - Monitor security zones and sensors"
msgstr ""
"<b>Controlere de alarmă</b> - Monitorizați zonele de securitate și senzorii"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Anti-Passback Violations</b> - Improper entry/exit sequences"
msgstr "<b>Încălcări Anti-Passback</b> - Secvențe de intrare/ieșire incorecte"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid "<b>Anti-pass back:</b> Prevent tailgating and ensure accurate tracking"
msgstr ""
"<b>Anti-pasaj înapoi:</b> Preveniți tailgating-ul și asigurați urmărirea "
"precisă"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Arm/Disarm Multiple Alarms</b> - Control all sensors in a group with one "
"click"
msgstr ""
"<b>Activare/Dezactivare alarme multiple</b> - Controlați toți senzorii "
"dintr-un grup cu un singur clic"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Attendance tracking:</b> Automatically track work hours based on zone "
"entry/exit"
msgstr ""
"<b>Urmărire prezență:</b> Urmăriți automat orele de lucru pe baza "
"intrărilor/ieșirilor din zonă"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>Common examples:</b><br>\n"
"                    • Regular hours: Mon-Fri 8:00-17:00<br>\n"
"                    • 24/7 access: All days 0:00-24:00<br>\n"
"                    • Weekend only: Sat-Sun 8:00-20:00<br>\n"
"                    • Night shift: All days 22:00-6:00"
msgstr ""
"<b>Exemple comune:</b><br>\n"
"                    • Program regulat: Lun-Vin 8:00-17:00<br>\n"
"                    • Acces 24/7: Toate zilele 0:00-24:00<br>\n"
"                    • Doar weekend: Sâm-Dum 8:00-20:00<br>\n"
"                    • Tură de noapte: Toate zilele 22:00-6:00"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_workcode_action
msgid ""
"<b>Common workcode setup:</b><br>\n"
"                    • 0001 - Start Work (Clock In)<br>\n"
"                    • 0002 - Start Break (Lunch/Rest)<br>\n"
"                    • 0003 - End Break (Return from Break)<br>\n"
"                    • 0004 - End Work (Clock Out)<br>"
msgstr ""
"<b>Configurare cod de lucru comună:</b><br>\n"
"                    • 0001 - Început lucru (Pontaj intrare)<br>\n"
"                    • 0002 - Început pauză (Prânz/Odihnă)<br>\n"
"                    • 0003 - Sfârșit pauză (Revenire din pauză)<br>\n"
"                    • 0004 - Sfârșit lucru (Pontaj ieșire)<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Create Hierarchies</b> - Build parent-child relationships (e.g., Campus →"
" Building → Floor)"
msgstr ""
"<b>Creați ierarhii</b> - Construiți relații de tip părinte-copil (ex.: "
"Campus → Clădire → Etaj)"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Door Contacts</b> - Monitor if doors are opened when armed"
msgstr ""
"<b>Contacte de ușă</b> - Monitorizați dacă ușile sunt deschise când sistemul"
" este armat"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Emergency Events</b> - Fire alarms, emergency buttons, evacuations"
msgstr ""
"<b>Evenimente de urgență</b> - Alarme de incendiu, butoane de urgență, "
"evacuări"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Environmental</b> - Temperature monitoring and alerts"
msgstr "<b>Mediu</b> - Monitorizarea temperaturii și alerte"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid "<b>Example Groups:</b>"
msgstr "<b>Grupuri exemplu:</b>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Getting Started:</b><br>\n"
"                    1. Use \"Hardware Manager → Add Module\" to register your module's serial number<br>\n"
"                    2. Configure the module's network settings to connect to this Odoo instance<br>\n"
"                    3. Once connected, use \"Read controllers\" to auto-detect connected devices<br>"
msgstr ""
"<b>Noțiuni introductive:</b><br>\n"
"                    1. Utilizați \"Hardware Manager → Add Module\" pentru a înregistra numărul de serie al modulului<br>\n"
"                    2. Configurați setările de rețea ale modulului pentru a vă conecta la această instanță Odoo<br>\n"
"                    3. Odată conectat, utilizați \"Read controllers\" pentru a detecta automat dispozitivele conectate<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Glass Break Detectors</b> - Detect breaking glass"
msgstr ""
"<b>Detectoare de spargere a sticlei</b> - Detectează spargerea sticlei"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid ""
"<b>Hardware Status</b> - Power cycles, wiring errors, communication issues"
msgstr ""
"<b>Stare hardware</b> - Cicluri de alimentare, erori de cablaj, probleme de "
"comunicare"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>How to use:</b><br>\n"
"                    1. Click on a time schedule to open it<br>\n"
"                    2. Click the \"Details\" button to edit access hours<br>\n"
"                    3. Set up to 4 time periods per day (e.g., 8:00-12:00 and 13:00-17:00)<br>\n"
"                    4. Save your changes - they sync automatically to controllers"
msgstr ""
"<b>Cum se utilizează:</b><br>\n"
"                    1. Faceți clic pe un program de timp pentru a-l deschide<br>\n"
"                    2. Faceți clic pe butonul \"Detalii\" pentru a edita orele de acces<br>\n"
"                    3. Configurați până la 4 perioade de timp pe zi (ex.: 8:00-12:00 și 13:00-17:00)<br>\n"
"                    4. Salvați modificările - acestea se sincronizează automat cu controlerele"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_card_type_action
msgid ""
"<b>Important:</b> Doors must be configured to accept specific card types. \n"
"                    A card will only open doors that accept its type AND when the card owner has proper access rights."
msgstr ""
"<b>Important:</b> Ușile trebuie configurate pentru a accepta tipuri specifice de carduri. \n"
"                    O cartelă va deschide doar ușile care acceptă tipul său ȘI atunci când proprietarul cartelei are drepturile de acces corespunzătoare."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>Key concepts:</b><br>\n"
"                    • <b>TS 0</b> = \"Not using TS\" - Always allows access (no time restrictions)<br>\n"
"                    • <b>TS 1-15</b> = Custom schedules with specific access hours<br>\n"
"                    • <b>Empty schedule</b> = Blocks all access when assigned to a door<br>\n"
"                    • <b>Holiday settings</b> = Override normal weekday schedules on holidays"
msgstr ""
"<b>Concepte cheie:</b><br>\n"
"                    • <b>TS 0</b> = \"Fără TS\" - Permite întotdeauna accesul (fără restricții de timp)<br>\n"
"                    • <b>TS 1-15</b> = Programe personalizate cu ore de acces specifice<br>\n"
"                    • <b>Program gol</b> = Blochează tot accesul când este atribuit unei uși<br>\n"
"                    • <b>Setări sărbători</b> = Suprascrie programele normale ale zilelor lucrătoare în zilele de sărbătoare"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Module Status Indicators:</b><br>\n"
"                    🟢 Green: Active and communicating (contacted within last 10 minutes)<br>\n"
"                    🟡 Yellow: Active but not communicating (check network connection)<br>\n"
"                    🔴 Red: Disabled (enable to allow communication)<br>"
msgstr ""
"<b>Indicatori de stare ai modulului:</b><br>\n"
"                    🟢 Verde: Activ și comunică (contactat în ultimele 10 minute)<br>\n"
"                    🟡 Galben: Activ, dar nu comunică (verificați conexiunea la rețea)<br>\n"
"                    🔴 Roșu: Dezactivat (activați pentru a permite comunicarea)<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Monitor Status</b> - See if all alarms in a group are armed, disarmed, or"
" mixed"
msgstr ""
"<b>Monitorizare stare</b> - Vizualizați dacă toate alarmele dintr-un grup "
"sunt armate, dezarmate sau în stare mixtă"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Motion Detectors</b> - Detect movement in protected areas"
msgstr ""
"<b>Detectoare de mișcare</b> - Detectează mișcarea în zonele protejate"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Need Help?</b><br>\n"
"                    • Check module IP address and network connectivity<br>\n"
"                    • Ensure the security key matches between Odoo and the module<br>\n"
"                    • Verify the module is not behind a restrictive firewall<br>\n"
"                    • Contact support if you continue experiencing issues"
msgstr ""
"<b>Aveți nevoie de ajutor?</b><br>\n"
"                    • Verificați adresa IP a modulului și conectivitatea de rețea<br>\n"
"                    • Asigurați-vă că cheia de securitate coincide între Odoo și modul<br>\n"
"                    • Verificați că modulul nu se află în spatele unui firewall restrictiv<br>\n"
"                    • Contactați asistența dacă problemele persistă"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Organize by Area</b> - Group sensors by floor, building, or department"
msgstr ""
"<b>Organizați pe zone</b> - Grupați senzorii pe etaj, clădire sau "
"departament"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_card_action
msgid ""
"<b>Quick tips:</b><br>\n"
"                    • Card numbers must be exactly 10 digits<br>\n"
"                    • Assign cards to employees or contacts, not both<br>\n"
"                    • Use activation/deactivation dates for temporary access<br>\n"
"                    • Card types determine which doors can be opened<br>\n"
"                    • Access rights come from the owner's access groups"
msgstr ""
"<b>Sfaturi rapide:</b><br>\n"
"                    • Numerele de cartelă trebuie să aibă exact 10 cifre<br>\n"
"                    • Atribuiți cardurile angajaților sau contactelor, nu ambelor<br>\n"
"                    • Utilizați date de activare/dezactivare pentru acces temporar<br>\n"
"                    • Tipurile de carduri determină ce uși pot fi deschise<br>\n"
"                    • Drepturile de acces provin din grupurile de acces ale proprietarului"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_reader_action
msgid ""
"<b>Reader Modes:</b><br>\n"
"                    • <b>Card Only</b> - Simple card scan for access<br>\n"
"                    • <b>Card + PIN</b> - Enhanced security with PIN verification<br>\n"
"                    • <b>Card + Workcode</b> - For tracking time on specific projects<br>\n"
"                    • <b>Card or PIN</b> - Flexible access with either method"
msgstr ""
"<b>Moduri cititor:</b><br>\n"
"                    • <b>Doar cartelă</b> - Scanare simplă a cartelei pentru acces<br>\n"
"                    • <b>Cartelă + PIN</b> - Securitate sporită cu verificare PIN<br>\n"
"                    • <b>Cartelă + Cod de lucru</b> - Pentru urmărirea timpului pe proiecte specifice<br>\n"
"                    • <b>Cartelă sau PIN</b> - Acces flexibil cu oricare dintre metode"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_reader_action
msgid ""
"<b>Reader Types:</b><br>\n"
"                    • <b>In (Entry)</b> - Records when someone enters an area<br>\n"
"                    • <b>Out (Exit)</b> - Records when someone leaves an area"
msgstr ""
"<b>Tipuri de cititor:</b><br>\n"
"                    • <b>Intrare</b> - Înregistrează când cineva intră într-o zonă<br>\n"
"                    • <b>Ieșire</b> - Înregistrează când cineva iese dintr-o zonă"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid "<b>Real-time occupancy:</b> See who is currently in each zone"
msgstr ""
"<b>Ocupare în timp real:</b> Vizualizați cine se află în prezent în fiecare "
"zonă"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid ""
"<b>Relay Controllers</b> - Control multiple relay outputs for various "
"equipment"
msgstr ""
"<b>Controlere cu relee</b> - Controlați multiple ieșiri cu relee pentru "
"diverse echipamente"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Safety compliance:</b> Monitor zone capacity for emergency evacuations"
msgstr ""
"<b>Conformitate privind siguranța:</b> Monitorizați capacitatea zonei pentru"
" evacuări de urgență"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Security Alerts</b> - Forced doors, overtime, tamper attempts"
msgstr ""
"<b>Alerte de securitate</b> - Uși forțate, depășire orar, tentative de "
"manipulare neautorizată"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Temperature Controllers</b> - Monitor environmental conditions"
msgstr "<b>Controlere de temperatură</b> - Monitorizați condițiile de mediu"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Time Schedule Errors</b> - Access outside allowed hours"
msgstr "<b>Erori program de timp</b> - Acces în afara orelor permise"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Turnstile Controllers</b> - Manage turnstile access points"
msgstr ""
"<b>Controlere de turnichet</b> - Gestionați punctele de acces cu turnichet"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid ""
"<b>Unknown Cards</b> - Unregistered card presentations for easy enrollment"
msgstr ""
"<b>Carduri necunoscute</b> - Prezentări de carduri neînregistrate pentru "
"înrolare facilă"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>What are Modules?</b><br>\n"
"                    Modules (WebStacks) are network devices that manage communication between Odoo and your access control hardware (controllers, doors, and card readers)."
msgstr ""
"<b>Ce sunt modulele?</b><br>\n"
"                    Modulele (WebStacks) sunt dispozitive de rețea care gestionează comunicarea dintre Odoo și hardware-ul dumneavoastră de control acces (controlere, uși și cititoare de carduri)."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Window Sensors</b> - Alert when windows are opened"
msgstr "<b>Senzori de fereastră</b> - Alertează când ferestrele sunt deschise"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Zone Controls</b> - Security zone arming/disarming"
