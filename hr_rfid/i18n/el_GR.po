#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"\"After Hours Protection\" - Motion detectors that should be armed at night"
msgstr ""
"\"Προστασία Εκτός Ωραρίου\" - Ανιχνευτές κίνησης που πρέπει να "
"ενεργοποιούνται τη νύχτα"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid "\"First Floor Security\" - All sensors on the first floor"
msgstr "\"Ασφάλεια Πρώτου Ορόφου\" - Όλοι οι αισθητήρες στον πρώτο όροφο"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid "\"Warehouse Perimeter\" - All door and window sensors around the warehouse"
msgstr ""
"\"Περίμετρος Αποθήκης\" - Όλοι οι αισθητήρες πορτών και παραθύρων γύρω από "
"την αποθήκη"

#. module: hr_rfid
#. odoo-python
#: code:addons/hr_rfid/models/hr_rfid_ctrl_iotable.py:0
