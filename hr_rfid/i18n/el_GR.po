"'Αναδιπλούμενη Κάρτα - %s - %s' % ((object.name or 'Access "
"Badge').replace('/',''), object.get_owner().name.replace('/',''))"

#. module: hr_rfid
#: model:ir.actions.report,print_report_name:hr_rfid.action_report_hr_employee_foldable_badge
#: model:ir.actions.report,print_report_name:hr_rfid.action_report_res_partner_foldable_badge
msgid ""
"'Foldable Badge - %s' % (object.name or 'Access Badge').replace('/','')"
