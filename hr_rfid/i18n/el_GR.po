#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid ""
"Controllers are hardware devices that manage access control, alarms, and other security features. \n"
"                    Each controller connects to card readers, door locks, sensors, and other equipment."
msgstr ""
