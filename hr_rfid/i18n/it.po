#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_access_group_action
msgid ""
"<strong>How long</strong> the access is valid (activation and expiration "
"dates)"
msgstr ""
"<strong>Per quanto tempo</strong> l'accesso è valido (date di attivazione e "
"scadenza)"

#. module: hr_rfid
#: model_terms:ir.ui.view,arch_db:hr_rfid.hr_rfid_controller_ts_wiz
msgid ""
"<strong>How to configure access times:</strong><br/>\n"
"                                • Each day can have up to 4 separate access periods<br/>\n"
"                                • Enter times in 24-hour format (e.g., 8:30 = 8:30, 17:45 = 17:45)<br/>\n"
"                                • Leave begin and end at 0:00 to skip an interval<br/>\n"
"                                • Holiday settings override the regular weekday schedule<br/>\n"
"                                • Changes are synchronized to all controllers using this schedule"
msgstr ""
"<strong>Come configurare gli orari di accesso:</strong><br/>\n"
"                                • Ogni giorno può avere fino a 4 periodi di accesso separati<br/>\n"
"                                • Inserisci gli orari in formato 24 ore (es. 8:30 = 8:30, 17:45 = 17:45)<br/>\n"
"                                • Lascia inizio e fine a 0:00 per saltare un intervallo<br/>\n"
"                                • Le impostazioni festività sostituiscono la pianificazione ordinaria dei giorni feriali<br/>\n"
"                                • Le modifiche vengono sincronizzate con tutti i controller che utilizzano questa pianificazione"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_access_group_action
