#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_res_partner__hr_rfid_pin_code
#: model:ir.model.fields,help:hr_rfid.field_res_users__hr_rfid_pin_code
msgid ""
"4-digit PIN code for secure door access. Use this along with an RFID card "
"for high-security areas. Default \"0000\" means no PIN required - the card "
"alone grants access. Change this to add an extra security layer."
msgstr ""
"Codice PIN a 4 cifre per l'accesso sicuro alla porta. Utilizzarlo insieme a "
"una tessera RFID per le aree ad alta sicurezza. Il valore predefinito "
"\"0000\" indica che non è richiesto alcun PIN - la tessera da sola concede "
"l'accesso. Modificarlo per aggiungere un ulteriore livello di sicurezza."

#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_hr_employee__hr_rfid_pin_code
msgid ""
"4-digit PIN code for secure door access. Used in combination with RFID cards"
" for two-factor authentication. Default '0000' means no PIN required. The "
"PIN must be entered on door readers when accessing restricted areas."
msgstr ""
"Codice PIN a 4 cifre per l'accesso sicuro alla porta. Utilizzato in "
"combinazione con tessere RFID per l'autenticazione a due fattori. Il valore "
"predefinito '0000' indica che non è richiesto alcun PIN. Il PIN deve essere "
"inserito sui lettori della porta per accedere alle aree riservate."

#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_hr_rfid_webstack__key
msgid ""
"4-digit security key for module authentication. Change this from the default"
" \"0000\" to secure your module. The module must have the same key "
"configured."
msgstr ""
"Chiave di sicurezza a 4 cifre per l'autenticazione del modulo. Modificarla "
"dal valore predefinito \"0000\" per proteggere il modulo. Il modulo deve "
"avere la stessa chiave configurata."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid ""
"<b>Access Controllers</b> - Manage doors, readers, and access permissions"
msgstr ""
"<b>Controller di accesso</b> - Gestisci porte, lettori e permessi di accesso"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Access Denied</b> - Failed attempts due to invalid permissions"
msgstr ""
"<b>Accesso Negato</b> - Tentativi falliti a causa di permessi non validi"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Access Granted</b> - Successful entry/exit through doors"
msgstr "<b>Accesso Concesso</b> - Entrate/uscite riuscite attraverso le porte"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Access restrictions:</b> Limit zones to specific departments or employee "
"groups"
msgstr ""
"<b>Restrizioni di accesso:</b> Limita le zone a reparti specifici o gruppi "
"di dipendenti"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Alarm Controllers</b> - Monitor security zones and sensors"
msgstr ""
"<b>Controller di allarme</b> - Monitora le zone di sicurezza e i sensori"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Anti-Passback Violations</b> - Improper entry/exit sequences"
msgstr ""
"<b>Violazioni Anti-Passback</b> - Sequenze di entrata/uscita non corrette"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid "<b>Anti-pass back:</b> Prevent tailgating and ensure accurate tracking"
msgstr ""
"<b>Anti-passback:</b> Previeni il tailgating e garantisci un tracciamento "
"accurato"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Arm/Disarm Multiple Alarms</b> - Control all sensors in a group with one "
"click"
msgstr ""
"<b>Attiva/Disattiva Allarmi Multipli</b> - Controlla tutti i sensori di un "
"gruppo con un clic"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Attendance tracking:</b> Automatically track work hours based on zone "
"entry/exit"
msgstr ""
"<b>Rilevazione presenze:</b> Registra automaticamente le ore lavorative in "
"base alle entrate/uscite dalla zona"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>Common examples:</b><br>\n"
"                    • Regular hours: Mon-Fri 8:00-17:00<br>\n"
"                    • 24/7 access: All days 0:00-24:00<br>\n"
"                    • Weekend only: Sat-Sun 8:00-20:00<br>\n"
"                    • Night shift: All days 22:00-6:00"
msgstr ""
"<b>Esempi comuni:</b><br>\n"
"                    • Orario standard: Lun-Ven 8:00-17:00<br>\n"
"                    • Accesso 24/7: Tutti i giorni 0:00-24:00<br>\n"
"                    • Solo weekend: Sab-Dom 8:00-20:00<br>\n"
"                    • Turno notturno: Tutti i giorni 22:00-6:00"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_workcode_action
msgid ""
"<b>Common workcode setup:</b><br>\n"
"                    • 0001 - Start Work (Clock In)<br>\n"
"                    • 0002 - Start Break (Lunch/Rest)<br>\n"
"                    • 0003 - End Break (Return from Break)<br>\n"
"                    • 0004 - End Work (Clock Out)<br>"
msgstr ""
"<b>Configurazione tipica dei codici di lavoro:</b><br>\n"
"                    • 0001 - Inizio lavoro (Entrata)<br>\n"
"                    • 0002 - Inizio pausa (Pranzo/Riposo)<br>\n"
"                    • 0003 - Fine pausa (Rientro dalla pausa)<br>\n"
"                    • 0004 - Fine lavoro (Uscita)<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Create Hierarchies</b> - Build parent-child relationships (e.g., Campus →"
" Building → Floor)"
msgstr ""
"<b>Crea Gerarchie</b> - Definisci relazioni padre-figlio (es. Campus → "
"Edificio → Piano)"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Door Contacts</b> - Monitor if doors are opened when armed"
msgstr ""
"<b>Contatti Porta</b> - Monitora l'apertura delle porte quando il sistema è "
"attivato"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Emergency Events</b> - Fire alarms, emergency buttons, evacuations"
msgstr ""
"<b>Eventi di Emergenza</b> - Allarmi antincendio, pulsanti di emergenza, "
"evacuazioni"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Environmental</b> - Temperature monitoring and alerts"
msgstr "<b>Ambientale</b> - Monitoraggio della temperatura e avvisi"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid "<b>Example Groups:</b>"
msgstr "<b>Gruppi di Esempio:</b>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Getting Started:</b><br>\n"
"                    1. Use \"Hardware Manager → Add Module\" to register your module's serial number<br>\n"
"                    2. Configure the module's network settings to connect to this Odoo instance<br>\n"
"                    3. Once connected, use \"Read controllers\" to auto-detect connected devices<br>"
msgstr ""
"<b>Per Iniziare:</b><br>\n"
"                    1. Usa \"Gestione Hardware → Aggiungi Modulo\" per registrare il numero seriale del modulo<br>\n"
"                    2. Configura le impostazioni di rete del modulo per connettersi a questa istanza Odoo<br>\n"
"                    3. Una volta connesso, usa \"Leggi controller\" per rilevare automaticamente i dispositivi collegati<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Glass Break Detectors</b> - Detect breaking glass"
msgstr ""
"<b>Rilevatori di Rottura del Vetro</b> - Rilevano la rottura del vetro"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid ""
"<b>Hardware Status</b> - Power cycles, wiring errors, communication issues"
msgstr ""
"<b>Stato Hardware</b> - Cicli di alimentazione, errori di cablaggio, "
"problemi di comunicazione"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>How to use:</b><br>\n"
"                    1. Click on a time schedule to open it<br>\n"
"                    2. Click the \"Details\" button to edit access hours<br>\n"
"                    3. Set up to 4 time periods per day (e.g., 8:00-12:00 and 13:00-17:00)<br>\n"
"                    4. Save your changes - they sync automatically to controllers"
msgstr ""
"<b>Come si usa:</b><br>\n"
"                    1. Clicca su una pianificazione oraria per aprirla<br>\n"
"                    2. Clicca il pulsante \"Dettagli\" per modificare gli orari di accesso<br>\n"
"                    3. Imposta fino a 4 fasce orarie al giorno (es. 8:00-12:00 e 13:00-17:00)<br>\n"
"                    4. Salva le modifiche - vengono sincronizzate automaticamente con i controller"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_card_type_action
msgid ""
"<b>Important:</b> Doors must be configured to accept specific card types. \n"
"                    A card will only open doors that accept its type AND when the card owner has proper access rights."
msgstr ""
"<b>Importante:</b> Le porte devono essere configurate per accettare tipi di tessera specifici. \n"
"                    Una tessera aprirà solo le porte che ne accettano il tipo E quando il titolare dispone dei diritti di accesso appropriati."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>Key concepts:</b><br>\n"
"                    • <b>TS 0</b> = \"Not using TS\" - Always allows access (no time restrictions)<br>\n"
"                    • <b>TS 1-15</b> = Custom schedules with specific access hours<br>\n"
"                    • <b>Empty schedule</b> = Blocks all access when assigned to a door<br>\n"
"                    • <b>Holiday settings</b> = Override normal weekday schedules on holidays"
msgstr ""
"<b>Concetti chiave:</b><br>\n"
"                    • <b>TS 0</b> = \"Non utilizza TS\" - Consente sempre l'accesso (nessuna restrizione oraria)<br>\n"
"                    • <b>TS 1-15</b> = Pianificazioni personalizzate con orari di accesso specifici<br>\n"
"                    • <b>Pianificazione vuota</b> = Blocca tutti gli accessi quando assegnata a una porta<br>\n"
"                    • <b>Impostazioni festività</b> = Sostituisce le pianificazioni ordinarie dei giorni feriali durante le festività"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Module Status Indicators:</b><br>\n"
"                    🟢 Green: Active and communicating (contacted within last 10 minutes)<br>\n"
"                    🟡 Yellow: Active but not communicating (check network connection)<br>\n"
"                    🔴 Red: Disabled (enable to allow communication)<br>"
msgstr ""
"<b>Indicatori di Stato del Modulo:</b><br>\n"
"                    🟢 Verde: Attivo e in comunicazione (contattato negli ultimi 10 minuti)<br>\n"
"                    🟡 Giallo: Attivo ma non in comunicazione (verificare la connessione di rete)<br>\n"
"                    🔴 Rosso: Disabilitato (abilitare per consentire la comunicazione)<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Monitor Status</b> - See if all alarms in a group are armed, disarmed, or"
" mixed"
msgstr ""
"<b>Monitora Stato</b> - Verifica se tutti gli allarmi di un gruppo sono "
"attivati, disattivati o in stato misto"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Motion Detectors</b> - Detect movement in protected areas"
msgstr ""
"<b>Rilevatori di Movimento</b> - Rilevano movimenti nelle aree protette"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Need Help?</b><br>\n"
"                    • Check module IP address and network connectivity<br>\n"
"                    • Ensure the security key matches between Odoo and the module<br>\n"
"                    • Verify the module is not behind a restrictive firewall<br>\n"
"                    • Contact support if you continue experiencing issues"
msgstr ""
"<b>Hai bisogno di aiuto?</b><br>\n"
"                    • Verifica l'indirizzo IP del modulo e la connettività di rete<br>\n"
"                    • Assicurati che la chiave di sicurezza corrisponda tra Odoo e il modulo<br>\n"
"                    • Verifica che il modulo non sia protetto da un firewall restrittivo<br>\n"
"                    • Contatta il supporto se il problema persiste"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Organize by Area</b> - Group sensors by floor, building, or department"
msgstr ""
"<b>Organizza per Area</b> - Raggruppa i sensori per piano, edificio o "
"reparto"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_card_action
msgid ""
"<b>Quick tips:</b><br>\n"
"                    • Card numbers must be exactly 10 digits<br>\n"
"                    • Assign cards to employees or contacts, not both<br>\n"
"                    • Use activation/deactivation dates for temporary access<br>\n"
"                    • Card types determine which doors can be opened<br>\n"
"                    • Access rights come from the owner's access groups"
msgstr ""
"<b>Suggerimenti rapidi:</b><br>\n"
"                    • I numeri di tessera devono essere esattamente di 10 cifre<br>\n"
"                    • Assegna le tessere a dipendenti o contatti, non a entrambi<br>\n"
"                    • Utilizza le date di attivazione/disattivazione per gli accessi temporanei<br>\n"
"                    • I tipi di tessera determinano quali porte possono essere aperte<br>\n"
"                    • I diritti di accesso derivano dai gruppi di accesso del titolare"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_reader_action
msgid ""
"<b>Reader Modes:</b><br>\n"
"                    • <b>Card Only</b> - Simple card scan for access<br>\n"
"                    • <b>Card + PIN</b> - Enhanced security with PIN verification<br>\n"
"                    • <b>Card + Workcode</b> - For tracking time on specific projects<br>\n"
"                    • <b>Card or PIN</b> - Flexible access with either method"
msgstr ""
"<b>Modalità del Lettore:</b><br>\n"
"                    • <b>Solo Tessera</b> - Scansione semplice della tessera per l'accesso<br>\n"
"                    • <b>Tessera + PIN</b> - Sicurezza avanzata con verifica PIN<br>\n"
"                    • <b>Tessera + Codice di Lavoro</b> - Per il tracciamento del tempo su progetti specifici<br>\n"
"                    • <b>Tessera o PIN</b> - Accesso flessibile con entrambi i metodi"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_reader_action
msgid ""
"<b>Reader Types:</b><br>\n"
"                    • <b>In (Entry)</b> - Records when someone enters an area<br>\n"
"                    • <b>Out (Exit)</b> - Records when someone leaves an area"
msgstr ""
"<b>Tipi di Lettore:</b><br>\n"
"                    • <b>In (Entrata)</b> - Registra quando qualcuno entra in un'area<br>\n"
"                    • <b>Out (Uscita)</b> - Registra quando qualcuno lascia un'area"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid "<b>Real-time occupancy:</b> See who is currently in each zone"
msgstr ""
"<b>Occupazione in tempo reale:</b> Visualizza chi si trova attualmente in "
"ciascuna zona"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid ""
"<b>Relay Controllers</b> - Control multiple relay outputs for various "
"equipment"
msgstr ""
"<b>Controller Relè</b> - Controlla più uscite relè per vari apparecchi"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Safety compliance:</b> Monitor zone capacity for emergency evacuations"
msgstr ""
"<b>Conformità alla sicurezza:</b> Monitora la capacità delle zone per le "
"evacuazioni di emergenza"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Security Alerts</b> - Forced doors, overtime, tamper attempts"
msgstr ""
"<b>Avvisi di Sicurezza</b> - Porte forzate, superamento orario, tentativi di"
" manomissione"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Temperature Controllers</b> - Monitor environmental conditions"
msgstr ""
"<b>Controller di Temperatura</b> - Monitorano le condizioni ambientali"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Time Schedule Errors</b> - Access outside allowed hours"
msgstr ""
"<b>Errori di Pianificazione Oraria</b> - Accessi al di fuori degli orari "
"consentiti"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Turnstile Controllers</b> - Manage turnstile access points"
msgstr ""
"<b>Controller Tornelli</b> - Gestiscono i punti di accesso con tornello"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid ""
"<b>Unknown Cards</b> - Unregistered card presentations for easy enrollment"
msgstr ""
"<b>Tessere Sconosciute</b> - Presentazioni di tessere non registrate per una"
" facile registrazione"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>What are Modules?</b><br>\n"
"                    Modules (WebStacks) are network devices that manage communication between Odoo and your access control hardware (controllers, doors, and card readers)."
msgstr ""
"<b>Cosa sono i Moduli?</b><br>\n"
"                    I moduli (WebStack) sono dispositivi di rete che gestiscono la comunicazione tra Odoo e l'hardware di controllo accessi (controller, porte e lettori di tessere)."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Window Sensors</b> - Alert when windows are opened"
msgstr "<b>Sensori di Finestra</b> - Segnalano l'apertura delle finestre"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
