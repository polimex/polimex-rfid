#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"\"After Hours Protection\" - Motion detectors that should be armed at night"
msgstr ""
"\"After Hours Protection\" - Detectores de movimiento que deben armarse por "
"la noche"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid "\"First Floor Security\" - All sensors on the first floor"
msgstr "\"First Floor Security\" - Todos los sensores en la primera planta"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"\"Warehouse Perimeter\" - All door and window sensors around the warehouse"
msgstr ""
"\"Warehouse Perimeter\" - Todos los sensores de puertas y ventanas alrededor "
"del almacén"

