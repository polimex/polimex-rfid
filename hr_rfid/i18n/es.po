#: model_terms:ir.ui.view,arch_db:hr_rfid.emergency_group_view_kanban
#: model_terms:ir.ui.view,arch_db:hr_rfid.hr_rfid_controller_view_kanban
#: model_terms:ir.ui.view,arch_db:hr_rfid.hr_rfid_ctrl_alarm_group_view_kanban
