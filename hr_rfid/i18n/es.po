#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_res_partner__hr_rfid_pin_code
#: model:ir.model.fields,help:hr_rfid.field_res_users__hr_rfid_pin_code
msgid ""
"4-digit PIN code for secure door access. Use this along with an RFID card "
"for high-security areas. Default \"0000\" means no PIN required - the card "
"alone grants access. Change this to add an extra security layer."
msgstr ""
"Código PIN de 4 dígitos para el acceso seguro a puertas. Utilícelo junto con "
"una tarjeta RFID para áreas de alta seguridad. El valor predeterminado "
"\"0000\" significa que no se requiere PIN; la tarjeta por sí sola concede "
"acceso. Cámbielo para añadir una capa de seguridad adicional."

#. module: hr_rfid
#: model:ir.model.fields,help:hr_rfid.field_hr_employee__hr_rfid_pin_code
msgid ""
"4-digit PIN code for secure door access. Used in combination with RFID cards "
"for two-factor authentication. Default '0000' means no PIN required. The PIN "
"must be entered on door readers when accessing restricted areas."
msgstr ""
"Código PIN de 4 dígitos para el acceso seguro a puertas. Se utiliza en "
"combinación con tarjetas RFID para la autenticación de dos factores. El "
"valor predeterminado '0000' significa que no se requiere PIN. El PIN debe "
"introducirse en los lectores de puerta al acceder a áreas restringidas."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid ""
"<b>Access Controllers</b> - Manage doors, readers, and access permissions"
msgstr ""
"<b>Controladores de Acceso</b> - Gestionar puertas, lectores y permisos de "
"acceso"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Access Denied</b> - Failed attempts due to invalid permissions"
msgstr "<b>Acceso Denegado</b> - Intentos fallidos por permisos no válidos"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Access Granted</b> - Successful entry/exit through doors"
msgstr "<b>Acceso Concedido</b> - Entrada/salida exitosa a través de puertas"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Access restrictions:</b> Limit zones to specific departments or employee "
"groups"
msgstr ""
"<b>Restricciones de acceso:</b> Limitar zonas a departamentos o grupos de "
"empleados específicos"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Alarm Controllers</b> - Monitor security zones and sensors"
msgstr ""
"<b>Controladores de Alarma</b> - Supervisar zonas de seguridad y sensores"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Anti-Passback Violations</b> - Improper entry/exit sequences"
msgstr ""
"<b>Violaciones de Anti-Passback</b> - Secuencias incorrectas de entrada/"
"salida"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid "<b>Anti-pass back:</b> Prevent tailgating and ensure accurate tracking"
msgstr ""
"<b>Anti-passback:</b> Prevenir el acceso no autorizado por seguimiento y "
"garantizar un rastreo preciso"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Arm/Disarm Multiple Alarms</b> - Control all sensors in a group with one "
"click"
msgstr ""
"<b>Armar/Desarmar Múltiples Alarmas</b> - Controlar todos los sensores de un "
"grupo con un solo clic"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Attendance tracking:</b> Automatically track work hours based on zone "
"entry/exit"
msgstr ""
"<b>Registro de asistencia:</b> Registrar automáticamente las horas de "
"trabajo según la entrada/salida de zonas"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>Common examples:</b><br>\n"
"                    • Regular hours: Mon-Fri 8:00-17:00<br>\n"
"                    • 24/7 access: All days 0:00-24:00<br>\n"
"                    • Weekend only: Sat-Sun 8:00-20:00<br>\n"
"                    • Night shift: All days 22:00-6:00"
msgstr ""
"<b>Ejemplos comunes:</b><br>\n"
"                    • Horario regular: Lun-Vie 8:00-17:00<br>\n"
"                    • Acceso 24/7: Todos los días 0:00-24:00<br>\n"
"                    • Solo fines de semana: Sáb-Dom 8:00-20:00<br>\n"
"                    • Turno nocturno: Todos los días 22:00-6:00"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_workcode_action
msgid ""
"<b>Common workcode setup:</b><br>\n"
"                    • 0001 - Start Work (Clock In)<br>\n"
"                    • 0002 - Start Break (Lunch/Rest)<br>\n"
"                    • 0003 - End Break (Return from Break)<br>\n"
"                    • 0004 - End Work (Clock Out)<br>"
msgstr ""
"<b>Configuración común de códigos de trabajo:</b><br>\n"
"                    • 0001 - Inicio de trabajo (Entrada)<br>\n"
"                    • 0002 - Inicio de descanso (Almuerzo/Descanso)<br>\n"
"                    • 0003 - Fin de descanso (Regreso del descanso)<br>\n"
"                    • 0004 - Fin de trabajo (Salida)<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Create Hierarchies</b> - Build parent-child relationships (e.g., Campus → "
"Building → Floor)"
msgstr ""
"<b>Crear Jerarquías</b> - Establecer relaciones padre-hijo (por ejemplo, "
"Campus → Edificio → Planta)"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Door Contacts</b> - Monitor if doors are opened when armed"
msgstr ""
"<b>Contactos de Puerta</b> - Supervisar si las puertas se abren cuando están "
"armadas"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Emergency Events</b> - Fire alarms, emergency buttons, evacuations"
msgstr ""
"<b>Eventos de Emergencia</b> - Alarmas de incendio, botones de emergencia, "
"evacuaciones"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Environmental</b> - Temperature monitoring and alerts"
msgstr "<b>Ambiental</b> - Supervisión de temperatura y alertas"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid "<b>Example Groups:</b>"
msgstr "<b>Grupos de ejemplo:</b>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Getting Started:</b><br>\n"
"                    1. Use \"Hardware Manager → Add Module\" to register "
"your module's serial number<br>\n"
"                    2. Configure the module's network settings to connect to "
"this Odoo instance<br>\n"
"                    3. Once connected, use \"Read controllers\" to auto-"
"detect connected devices<br>"
msgstr ""
"<b>Primeros pasos:</b><br>\n"
"                    1. Use \"Hardware Manager → Add Module\" para registrar "
"el número de serie del módulo<br>\n"
"                    2. Configure los ajustes de red del módulo para "
"conectarse a esta instancia de Odoo<br>\n"
"                    3. Una vez conectado, use \"Read controllers\" para "
"detectar automáticamente los dispositivos conectados<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Glass Break Detectors</b> - Detect breaking glass"
msgstr "<b>Detectores de Rotura de Cristal</b> - Detectar la rotura de cristal"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid ""
"<b>Hardware Status</b> - Power cycles, wiring errors, communication issues"
msgstr ""
"<b>Estado del Hardware</b> - Ciclos de alimentación, errores de cableado, "
"problemas de comunicación"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>How to use:</b><br>\n"
"                    1. Click on a time schedule to open it<br>\n"
"                    2. Click the \"Details\" button to edit access "
"hours<br>\n"
"                    3. Set up to 4 time periods per day (e.g., 8:00-12:00 "
"and 13:00-17:00)<br>\n"
"                    4. Save your changes - they sync automatically to "
"controllers"
msgstr ""
"<b>Cómo usar:</b><br>\n"
"                    1. Haga clic en un horario de acceso para abrirlo<br>\n"
"                    2. Haga clic en el botón \"Details\" para editar las "
"horas de acceso<br>\n"
"                    3. Configure hasta 4 períodos de tiempo por día (por "
"ejemplo, 8:00-12:00 y 13:00-17:00)<br>\n"
"                    4. Guarde los cambios; se sincronizan automáticamente "
"con los controladores"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_card_type_action
msgid ""
"<b>Important:</b> Doors must be configured to accept specific card types. \n"
"                    A card will only open doors that accept its type AND "
"when the card owner has proper access rights."
msgstr ""
"<b>Importante:</b> Las puertas deben configurarse para aceptar tipos de "
"tarjeta específicos.\n"
"                    Una tarjeta solo abrirá las puertas que acepten su tipo "
"Y cuando el titular de la tarjeta tenga los derechos de acceso adecuados."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_time_schedule_action
msgid ""
"<b>Key concepts:</b><br>\n"
"                    • <b>TS 0</b> = \"Not using TS\" - Always allows access "
"(no time restrictions)<br>\n"
"                    • <b>TS 1-15</b> = Custom schedules with specific access "
"hours<br>\n"
"                    • <b>Empty schedule</b> = Blocks all access when "
"assigned to a door<br>\n"
"                    • <b>Holiday settings</b> = Override normal weekday "
"schedules on holidays"
msgstr ""
"<b>Conceptos clave:</b><br>\n"
"                    • <b>TS 0</b> = \"Sin usar TS\" - Siempre permite el "
"acceso (sin restricciones de tiempo)<br>\n"
"                    • <b>TS 1-15</b> = Horarios personalizados con horas de "
"acceso específicas<br>\n"
"                    • <b>Horario vacío</b> = Bloquea todo el acceso cuando "
"se asigna a una puerta<br>\n"
"                    • <b>Configuración de festivos</b> = Anula los horarios "
"normales de días laborables en días festivos"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Module Status Indicators:</b><br>\n"
"                    🟢 Green: Active and communicating (contacted within "
"last 10 minutes)<br>\n"
"                    🟡 Yellow: Active but not communicating (check network "
"connection)<br>\n"
"                    🔴 Red: Disabled (enable to allow communication)<br>"
msgstr ""
"<b>Indicadores de Estado del Módulo:</b><br>\n"
"                    🟢 Verde: Activo y comunicándose (contactado en los "
"últimos 10 minutos)<br>\n"
"                    🟡 Amarillo: Activo pero sin comunicación (verificar la "
"conexión de red)<br>\n"
"                    🔴 Rojo: Deshabilitado (habilitar para permitir la "
"comunicación)<br>"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Monitor Status</b> - See if all alarms in a group are armed, disarmed, or "
"mixed"
msgstr ""
"<b>Supervisar Estado</b> - Ver si todas las alarmas de un grupo están "
"armadas, desarmadas o en estado mixto"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Motion Detectors</b> - Detect movement in protected areas"
msgstr ""
"<b>Detectores de Movimiento</b> - Detectar movimiento en áreas protegidas"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>Need Help?</b><br>\n"
"                    • Check module IP address and network connectivity<br>\n"
"                    • Ensure the security key matches between Odoo and the "
"module<br>\n"
"                    • Verify the module is not behind a restrictive "
"firewall<br>\n"
"                    • Contact support if you continue experiencing issues"
msgstr ""
"<b>¿Necesita ayuda?</b><br>\n"
"                    • Verifique la dirección IP del módulo y la conectividad "
"de red<br>\n"
"                    • Asegúrese de que la clave de seguridad coincida entre "
"Odoo y el módulo<br>\n"
"                    • Verifique que el módulo no esté detrás de un "
"cortafuegos restrictivo<br>\n"
"                    • Contacte con el soporte si continúa experimentando "
"problemas"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_group_action
msgid ""
"<b>Organize by Area</b> - Group sensors by floor, building, or department"
msgstr ""
"<b>Organizar por Área</b> - Agrupar sensores por planta, edificio o "
"departamento"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_card_action
msgid ""
"<b>Quick tips:</b><br>\n"
"                    • Card numbers must be exactly 10 digits<br>\n"
"                    • Assign cards to employees or contacts, not both<br>\n"
"                    • Use activation/deactivation dates for temporary "
"access<br>\n"
"                    • Card types determine which doors can be opened<br>\n"
"                    • Access rights come from the owner's access groups"
msgstr ""
"<b>Consejos rápidos:</b><br>\n"
"                    • Los números de tarjeta deben tener exactamente 10 "
"dígitos<br>\n"
"                    • Asigne tarjetas a empleados o contactos, no a "
"ambos<br>\n"
"                    • Use fechas de activación/desactivación para el acceso "
"temporal<br>\n"
"                    • Los tipos de tarjeta determinan qué puertas se pueden "
"abrir<br>\n"
"                    • Los derechos de acceso provienen de los grupos de "
"acceso del titular"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_reader_action
msgid ""
"<b>Reader Modes:</b><br>\n"
"                    • <b>Card Only</b> - Simple card scan for access<br>\n"
"                    • <b>Card + PIN</b> - Enhanced security with PIN "
"verification<br>\n"
"                    • <b>Card + Workcode</b> - For tracking time on specific "
"projects<br>\n"
"                    • <b>Card or PIN</b> - Flexible access with either method"
msgstr ""
"<b>Modos del Lector:</b><br>\n"
"                    • <b>Solo Tarjeta</b> - Lectura simple de tarjeta para "
"el acceso<br>\n"
"                    • <b>Tarjeta + PIN</b> - Seguridad mejorada con "
"verificación de PIN<br>\n"
"                    • <b>Tarjeta + Código de Trabajo</b> - Para el registro "
"de tiempo en proyectos específicos<br>\n"
"                    • <b>Tarjeta o PIN</b> - Acceso flexible con cualquiera "
"de los dos métodos"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_reader_action
msgid ""
"<b>Reader Types:</b><br>\n"
"                    • <b>In (Entry)</b> - Records when someone enters an "
"area<br>\n"
"                    • <b>Out (Exit)</b> - Records when someone leaves an area"
msgstr ""
"<b>Tipos de Lector:</b><br>\n"
"                    • <b>Entrada (In)</b> - Registra cuando alguien entra en "
"un área<br>\n"
"                    • <b>Salida (Out)</b> - Registra cuando alguien sale de "
"un área"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid "<b>Real-time occupancy:</b> See who is currently in each zone"
msgstr ""
"<b>Ocupación en tiempo real:</b> Ver quién está actualmente en cada zona"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid ""
"<b>Relay Controllers</b> - Control multiple relay outputs for various "
"equipment"
msgstr ""
"<b>Controladores de Relé</b> - Controlar múltiples salidas de relé para "
"diversos equipos"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_zone_action
msgid ""
"<b>Safety compliance:</b> Monitor zone capacity for emergency evacuations"
msgstr ""
"<b>Cumplimiento de seguridad:</b> Supervisar la capacidad de la zona para "
"evacuaciones de emergencia"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid "<b>Security Alerts</b> - Forced doors, overtime, tamper attempts"
msgstr ""
"<b>Alertas de Seguridad</b> - Puertas forzadas, tiempo excedido, intentos de "
"manipulación"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Temperature Controllers</b> - Monitor environmental conditions"
msgstr ""
"<b>Controladores de Temperatura</b> - Supervisar las condiciones ambientales"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_user_action
msgid "<b>Time Schedule Errors</b> - Access outside allowed hours"
msgstr ""
"<b>Errores de Horario de Acceso</b> - Acceso fuera de las horas permitidas"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_action
msgid "<b>Turnstile Controllers</b> - Manage turnstile access points"
msgstr ""
"<b>Controladores de Torniquete</b> - Gestionar los puntos de acceso con "
"torniquete"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_event_system_action
msgid ""
"<b>Unknown Cards</b> - Unregistered card presentations for easy enrollment"
msgstr ""
"<b>Tarjetas Desconocidas</b> - Presentaciones de tarjetas no registradas "
"para una inscripción sencilla"

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_webstack_action
msgid ""
"<b>What are Modules?</b><br>\n"
"                    Modules (WebStacks) are network devices that manage "
"communication between Odoo and your access control hardware (controllers, "
"doors, and card readers)."
msgstr ""
"<b>¿Qué son los Módulos?</b><br>\n"
"                    Los módulos (WebStacks) son dispositivos de red que "
"gestionan la comunicación entre Odoo y el hardware de control de acceso "
"(controladores, puertas y lectores de tarjeta)."

#. module: hr_rfid
#: model_terms:ir.actions.act_window,help:hr_rfid.hr_rfid_ctrl_alarm_action
msgid "<b>Window Sensors</b> - Alert when windows are opened"
msgstr "<b>Sensores de Ventana</b> - Alertar cuando se abren las ventanas"

