            <field name="model_id" ref="model_hr_rfid_card_door_rel"/>
            <field name="global" eval="True"/>
            <!-- A sharing company manages the grants of its OWN cards; only the door owner may touch the grants made by others. -->
            <field name="domain_force">['|', ('card_id.company_id', 'in', company_ids), ('door_id.company_id', 'in', company_ids + [False])]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
