        <!-- The relation models had NO multi-company rule at all: any internal
             user could enumerate every card-door grant in the database. Scope
             them to: my company's card / my company's (or shared-with-me) door.
             The owner company keeps seeing every grant on its own hardware. -->
        <record id="ir_rule_hr_rfid_card_door_rel_multi_company" model="ir.rule">
            <field name="name">HR RFID Card-Door Relations: Multi Company</field>
            <field name="model_id" ref="model_hr_rfid_card_door_rel"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('card_id.company_id', 'in', company_ids), '|', ('door_id.company_id', 'in', company_ids + [False]), ('door_id.webstack_id.shared_company_ids', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

