            <field name="model_id" ref="model_hr_rfid_access_group_door_rel"/>
            <field name="global" eval="True"/>
            <!-- A sharing company manages the grants of its OWN access groups; only the door owner may remove the grants of others. -->
            <field name="domain_force">['|', ('access_group_id.company_id', 'in', company_ids), ('door_id.company_id', 'in', company_ids + [False])]</field>
