            <field name="global" eval="True"/>
            <!-- Owner only: a command row carries the owner's card numbers and
                 PIN codes, and creating one sends it straight to the physical
                 controller. A sharing company's grants are delivered by the
                 server itself, so it never needs the queue. -->
            <field name="domain_force">[('webstack_id.company_id', 'in', company_ids)]</field>
