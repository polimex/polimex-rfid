<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Cron jobs for HR RFID module
         These scheduled actions handle card activation/deactivation,
         controller clock synchronization, and status monitoring.

         Odoo 19 cron features used:
         - noupdate="1" allows users to customize intervals
         - priority field controls execution order (lower = higher priority)
         - state defaults to 'code' (omitted for cleaner XML)
    -->
    <data noupdate="1">

        <!-- High priority: Card activation/deactivation check
             Runs every minute to ensure cards are activated/deactivated on time -->
        <record id="hr_rfid_set_card_active_inactive_status" model="ir.cron">
            <field name="name">HR RFID: Check card activation status</field>
            <field name="model_id" ref="model_hr_rfid_card"/>
            <field name="code">model.do_cron_jobs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="priority">5</field>
        </record>

        <!-- Medium priority: Controller clock synchronization
             Runs every 3 hours to keep controller clocks in sync -->
        <record id="hr_rfid_sync_ctrl_clock_cron" model="ir.cron">
            <field name="name">HR RFID: Synchronize controller clocks</field>
            <field name="model_id" ref="model_hr_rfid_command"/>
            <field name="code">model._sync_clocks()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">3</field>
            <field name="interval_type">hours</field>
            <field name="priority">10</field>
        </record>

        <!-- Medium priority: Controller status monitoring
             Runs every 5 minutes to read controller statuses -->
        <record id="hr_rfid_read_ctrl_status_cron" model="ir.cron">
            <field name="name">HR RFID: Read controller statuses</field>
            <field name="model_id" ref="model_hr_rfid_command"/>
            <field name="code">model._read_statuses()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="priority">10</field>
        </record>

    </data>
</odoo>
