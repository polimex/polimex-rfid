<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ONBOARDING STEPS -->
        <record id="onboarding_step_module_settings" model="onboarding.onboarding.step">
            <field name="title">Configure RFID Settings</field>
            <field name="description">Set timezone and module parameters for your RFID system.</field>
            <field name="button_text">Open Settings</field>
            <field name="done_text">Settings configured!</field>
            <field name="done_icon">fa-cog</field>
            <field name="panel_step_open_action_name">action_open_step_rfid_settings</field>
            <field name="step_image" type="base64" file="base/static/img/onboarding_cog.png"/>
            <field name="step_image_filename">onboarding_cog.png</field>
            <field name="step_image_alt">Configure RFID Settings</field>
            <field name="is_per_company">True</field>
            <field name="sequence">1</field>
        </record>

        <record id="onboarding_step_add_webstack" model="onboarding.onboarding.step">
            <field name="title">Add Hardware Module</field>
            <field name="description">Register your first RFID network module (WebStack).</field>
            <field name="button_text">Add Module</field>
            <field name="done_text">Module registered!</field>
            <field name="done_icon">fa-server</field>
            <field name="panel_step_open_action_name">action_open_step_add_webstack</field>
            <field name="step_image" type="base64" file="base/static/img/onboarding_company-data.png"/>
            <field name="step_image_filename">onboarding_company-data.png</field>
            <field name="step_image_alt">Add Hardware Module</field>
            <field name="is_per_company">True</field>
            <field name="sequence">2</field>
        </record>

        <record id="onboarding_step_scan_controllers" model="onboarding.onboarding.step">
            <field name="title">Discover Controllers</field>
            <field name="description">Scan for RFID controllers connected to your module.</field>
            <field name="button_text">View Modules</field>
            <field name="done_text">Controllers found!</field>
            <field name="done_icon">fa-search</field>
            <field name="panel_step_open_action_name">action_open_step_scan_controllers</field>
            <field name="step_image" type="base64" file="base/static/img/onboarding_looking_glass.png"/>
            <field name="step_image_filename">onboarding_looking_glass.png</field>
            <field name="step_image_alt">Discover Controllers</field>
            <field name="is_per_company">True</field>
            <field name="sequence">3</field>
        </record>

        <record id="onboarding_step_create_access_group" model="onboarding.onboarding.step">
            <field name="title">Create Access Group</field>
            <field name="description">Define which doors can be accessed and when.</field>
            <field name="button_text">Create Group</field>
            <field name="done_text">Access group ready!</field>
            <field name="done_icon">fa-key</field>
            <field name="panel_step_open_action_name">action_open_step_create_access_group</field>
            <field name="step_image" type="base64" file="base/static/img/onboarding_puzzle.png"/>
            <field name="step_image_filename">onboarding_puzzle.png</field>
            <field name="step_image_alt">Create Access Group</field>
            <field name="is_per_company">True</field>
            <field name="sequence">4</field>
        </record>

        <record id="onboarding_step_register_card" model="onboarding.onboarding.step">
            <field name="title">Register First Card</field>
            <field name="description">Add an RFID card and assign it to an employee.</field>
            <field name="button_text">Add Card</field>
            <field name="done_text">Card registered!</field>
            <field name="done_icon">fa-id-card</field>
            <field name="panel_step_open_action_name">action_open_step_register_card</field>
            <field name="step_image" type="base64" file="base/static/img/onboarding_sample-quotation.png"/>
            <field name="step_image_filename">onboarding_sample-quotation.png</field>
            <field name="step_image_alt">Register First Card</field>
            <field name="is_per_company">True</field>
            <field name="sequence">5</field>
        </record>

        <!-- ONBOARDING PANEL -->
        <record id="onboarding_rfid_setup" model="onboarding.onboarding">
            <field name="name">RFID System Setup</field>
            <field name="route_name">hr_rfid_setup</field>
            <field name="step_ids" eval="[
                Command.link(ref('hr_rfid.onboarding_step_module_settings')),
                Command.link(ref('hr_rfid.onboarding_step_add_webstack')),
                Command.link(ref('hr_rfid.onboarding_step_scan_controllers')),
                Command.link(ref('hr_rfid.onboarding_step_create_access_group')),
                Command.link(ref('hr_rfid.onboarding_step_register_card')),
            ]"/>
            <field name="panel_close_action_name">action_close_panel_rfid_setup</field>
            <field name="text_completed">Your RFID system is ready! Access events will appear here as users scan their cards.</field>
        </record>

    </data>
</odoo>
