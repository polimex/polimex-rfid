<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="emergency_group_form_view" model="ir.ui.view">
            <field name="name">emergency.group.form.view</field>
            <field name="model">hr.rfid.ctrl.emergency.group</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                        <field name="state"
                               widget="statusbar"
                               statusbar_colors="{'emergency':'red', 'normal':'green'}"
                               statusbar_visible=" "/>
                    </header>

                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <div id="control_buttons" invisible="controller_ids==0">
                                <button name="emergency_on"
                                        type="object"
                                        groups="hr_rfid.hr_rfid_view_emergency_on_off"
                                        invisible="state in ['emergency','normal']"
                                        confirm="Are you sure to turn Emergency mode for the group"
                                        class="oe_stat_button oe_read_only" icon="fa-free-code-camp">
                                    Emergency On
                                </button>
                                <button name="emergency_off"
                                        type="object"
                                        groups="hr_rfid.hr_rfid_view_emergency_on_off"
                                        invisible="state in ['emergency','normal']"
                                        confirm="Are you sure to turn Emergency mode for the group"
                                        class="oe_stat_button oe_read_only" icon="fa-fire">
                                    Emergency Off
                                </button>
                            </div>
                        </div>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Set friendly name"/>
                            </h1>
                        </div>
                        <group class="oe_edit_only">
                            <field name="controller_ids" widget="many2many_tags"/>
                        </group>
                        <group class="oe_read_only">
                            <field name="controller_ids" >
                                <list edit="0" create="0">
                                    <field name="name"/>
                                    <field name="webstack_id"/>
                                    <field name="emergency_state"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                     <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="emergency_group_list_view" model="ir.ui.view">
            <field name="name">emergency.group.list.view</field>
            <field name="model">hr.rfid.ctrl.emergency.group</field>
            <field name="arch" type="xml">
                <list string="" sample="1">
                    <field name="name"/>
                    <field name="controller_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record id="emergency_group_view_kanban" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.emergency.group.kanban</field>
            <field name="model">hr.rfid.ctrl.emergency.group</field>
            <field name="arch" type="xml">
                <kanban group_create="false"
                        group_edit="false"
                        quick_create="false">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="controller_ids"/>
                    <templates>
                        <!-- Main card template (required) -->
                        <t t-name="card">
                            <div class="oe_kanban_global_click position-relative">
                                <div class="oe_kanban_details">
                                    <div class="position-absolute top-0 end-0 mt-2 me-2">
                                        <span t-if="record.state.raw_value == 'emergency'"
                                              class="fa fa-fire text-danger" title="Emergency"/>
                                        <span t-if="record.state.raw_value == 'normal'"
                                              class="fa fa-free-code-camp text-success" title="Normal"/>
                                    </div>
                                    <div class="o_kanban_record_top mb-2">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                    <ul class="list-unstyled text-muted small">
                                        <li>
                                            <span class="text-muted">State:</span>
                                            <field name="state"
                                                   decoration-success="state == 'normal'"
                                                   decoration-danger="state == 'emergency'"/>
                                        </li>
                                        <li t-if="record.controller_ids.raw_value.length > 0">
                                            <i class="fa fa-microchip me-1"/> <t t-esc="record.controller_ids.raw_value.length"/> controller(s)
                                        </li>
                                    </ul>
                                </div>
                                <div class="oe_kanban_footer">
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <button name="emergency_on" type="object" title="Activate emergency mode"
                                                    groups="hr_rfid.hr_rfid_view_emergency_on_off"
                                                    class="btn btn-link btn-sm ps-0 pe-1">
                                                <i class="fa fa-fire text-danger"/>
                                            </button>
                                            <button name="emergency_off" type="object" title="Deactivate emergency mode"
                                                    groups="hr_rfid.hr_rfid_view_emergency_on_off"
                                                    class="btn btn-link btn-sm ps-0 pe-1">
                                                <i class="fa fa-free-code-camp text-success"/>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                        
                        <!-- Menu template (optional) -->
                        <t t-name="menu" t-if="!selection_mode" groups="base.group_user">
                            <a role="menuitem" type="object" name="emergency_on" class="dropdown-item">Emergency On</a>
                            <a role="menuitem" type="object" name="emergency_off" class="dropdown-item">Emergency Off</a>
                            <div role="separator" class="dropdown-divider"/>
                            <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        </t>
                        
                        <!-- Tooltip template (optional) -->
                        <t t-name="tooltip">
                            <div>
                                <field name="name" class="fw-bold"/>
                                <div class="text-muted">
                                    <span>State: </span><field name="state"/>
                                    <div t-if="record.controller_ids.raw_value.length > 0">
                                        <span>Controllers: </span><t t-esc="record.controller_ids.raw_value.length"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <record id="emergency_group_act" model="ir.actions.act_window">
            <field name="name">Emergency distribution group</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.rfid.ctrl.emergency.group</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Please create a new group from the Create button
                </p>
                <p>
                    Emergency distribution group manage the emergency signal from one controller to a group.
                    The function decrease installation cost and manage the
                </p>
            </field>
        </record>

    </data>
</odoo>