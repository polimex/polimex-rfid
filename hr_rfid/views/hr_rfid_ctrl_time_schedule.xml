<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <!-- Create TS based on company -->
        <function model="hr.rfid.time.schedule" name="set_company_ts"/>

        <!--        Wizard for Time Schedules-->

        <record id="hr_rfid_controller_ts_wiz" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.ts.week.wizard</field>
            <field name="model">hr.rfid.ctrl.ts.week.wiz</field>
            <field name="arch" type="xml">
                <form string="View/Modify Time Schedule">
                    <div>
                        <h1>Time schedule data for
                            <field name="ts_id" readonly="1" options="{'clickable': '0'}" class="oe_inline"/>
                        </h1>
                        <br/>
                        <div class="alert alert-info" role="alert">
                            <p class="mb-0">
                                <strong>How to configure access times:</strong><br/>
                                • Each day can have up to 4 separate access periods<br/>
                                • Enter times in 24-hour format (e.g., 8:30 = 8:30, 17:45 = 17:45)<br/>
                                • Leave begin and end at 0:00 to skip an interval<br/>
                                • Holiday settings override the regular weekday schedule<br/>
                                • Changes are synchronized to all controllers using this schedule
                            </p>
                        </div>
                        <field name="interval_ids" options="{'no_create': True, 'no_open': True, 'no_edit':True}">
                            <list create="false" delete="false" editable="bottom" multi_edit="1"
                                  default_order="day asc">
                                <field name="day"/>
                                <field name="number"/>
                                <field name="begin" widget="float_time"/>
                                <field name="end" widget="float_time"/>
                            </list>
                        </field>
                    </div>
                    <footer>
                        <button name="save_ts" type="object" string="Save" class="oe_highlight"/>
                        <button special="cancel" string="Close" class="oe_highlight"/>
                    </footer>
                </form>
            </field>
        </record>


        <record id="hr_rfid_ctrl_ts_week_wiz_action" model="ir.actions.act_window">
            <field name="name">Time Schedule Wizard</field>
            <field name="res_model">hr.rfid.ctrl.ts.week.wiz</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="hr_rfid_controller_ts_wiz"/>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_hr_rfid_time_schedule"/>
            <field name="binding_view_types">form</field>
            <field name="help" type="html">
                <p>
                    Configure access hours for each day of the week.
                    You can define up to 4 time periods per day when access is allowed.
                </p>
            </field>
        </record>

        <record id="hr_rfid_time_schedule_view_form" model="ir.ui.view">
            <field name="name">hr.rfid.time.schedule.form</field>
            <field name="model">hr.rfid.time.schedule</field>
            <field name="arch" type="xml">
                <form create="0" delete="0">
                    <header>
                        <field name="is_empty" invisible="1"/>
                        <button name="reset_ts_data" string="Reset" type="object"
                                confirm="Are you sure you want to reset the time schedule data?"
                                invisible="is_empty"
                        />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="%(hr_rfid_ctrl_ts_week_wiz_action)d"
                                    string="Time Schedule Wizard" type="action" icon="fa-calendar">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Details</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Friendly name"/>
                            </h1>
                        </div>
                        <group>
                            <field name="number"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Debug Information" groups="base.group_no_one" colspan="4">
                            <field name="controller_ids" readonly="1"/>
                            <field name="access_group_door_ids" readonly="1">
                                <list>
                                    <field name="access_group_id"/>
                                    <field name="door_id"/>
                                    <field name="alarm_rights"/>
                                </list>
                            </field>
                            <field name="ts_data" readonly="1"/>
                        </group>
                    </sheet>
                     <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="hr_rfid_time_schedule_view_kanban" model="ir.ui.view">
            <field name="name">hr.rfid.time.schedule.kanban</field>
            <field name="model">hr.rfid.time.schedule</field>
            <field name="arch" type="xml">
                <kanban sample="1" create="0" delete="0">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="number"/>
                    <field name="is_empty"/>
                    <templates>
                        <!-- Main card template (required) -->
                        <t t-name="card">
                            <main>
                                <field name="name" class="fw-bold fs-5 mb-1"/>
                                <div class="text-muted">
                                    <span>TS Number: </span>
                                    <field name="number" class="fw-bold"/>
                                </div>
                                <div t-if="record.is_empty.raw_value and record.number.raw_value > 0" class="text-danger mt-2">
                                    <i class="fa fa-warning me-1"/>TS is empty
                                </div>
                                <div t-elif="!record.is_empty.raw_value" class="text-success mt-2">
                                    <i class="fa fa-check-circle me-1"/>TS is not empty
                                </div>
                            </main>
                        </t>
                        
                        <!-- Menu template (optional) -->
                        <t t-name="menu" t-if="!selection_mode" groups="base.group_user">
                            <a role="menuitem" type="open" class="dropdown-item">Edit</a>
                        </t>
                        
                        <!-- Tooltip template (optional) -->
                        <t t-name="tooltip">
                            <div>
                                <field name="name" class="fw-bold"/>
                                <div class="text-muted">
                                    <span>TS #</span><field name="number"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="hr_rfid_time_schedule_view_list" model="ir.ui.view">
            <field name="name">hr.rfid.time.schedule.list</field>
            <field name="model">hr.rfid.time.schedule</field>
            <field name="arch" type="xml">
                <list sample="1" create="false" delete="false">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="hr_rfid_time_schedule_action" model="ir.actions.act_window">
            <field name="name">Time Schedules</field>
            <field name="res_model">hr.rfid.time.schedule</field>
            <field name="view_mode">kanban,list,form,search</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Time Schedules control when access is allowed
                </p>
                <p>
                    Time schedules define when doors can be accessed throughout the week. 
                    Each schedule contains up to 4 time periods per day for all 7 days of 
                    the week, plus special settings for holidays.
                </p>
                <p>
                    <b>Key concepts:</b><br/>
                    • <b>TS 0</b> = "Not using TS" - Always allows access (no time restrictions)<br/>
                    • <b>TS 1-15</b> = Custom schedules with specific access hours<br/>
                    • <b>Empty schedule</b> = Blocks all access when assigned to a door<br/>
                    • <b>Holiday settings</b> = Override normal weekday schedules on holidays
                </p>
                <p>
                    <b>How to use:</b><br/>
                    1. Click on a time schedule to open it<br/>
                    2. Click the "Details" button to edit access hours<br/>
                    3. Set up to 4 time periods per day (e.g., 8:00-12:00 and 13:00-17:00)<br/>
                    4. Save your changes - they sync automatically to controllers
                </p>
                <p>
                    <b>Common examples:</b><br/>
                    • Regular hours: Mon-Fri 8:00-17:00<br/>
                    • 24/7 access: All days 0:00-24:00<br/>
                    • Weekend only: Sat-Sun 8:00-20:00<br/>
                    • Night shift: All days 22:00-6:00
                </p>
            </field>
        </record>
    </data>
</odoo>
