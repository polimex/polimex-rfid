<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_rfid_door_open_close_wiz_form" model="ir.ui.view">
            <field name="name">hr.rfid.door.open.close.wiz.form</field>
            <field name="model">hr.rfid.door.open.close.wiz</field>
            <field name="arch" type="xml">
                <form string="Open/close door">
                    <p>Remotely unlock the selected doors for the duration you set below, or close them immediately. The command is queued for the controller and runs as soon as it polls in.</p>
                    <group>
                        <field name="doors" readonly="1">
                            <list editable="top">
                                <field name="name"/>
                                <field name="controller_id"/>
                                <field name="card_type"/>
                            </list>
                        </field>
                        <field name="time"/>
                    </group>
                    <footer>
                        <button name="open_doors" type="object" string="Open doors" class="oe_highlight"/>
                        <button name="close_doors" type="object" string="Close doors" class="oe_highlight"/>
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="hr_rfid_door_open_close_wiz_action" model="ir.actions.act_window">
            <field name="name">Open/close door</field>
            <field name="res_model">hr.rfid.door.open.close.wiz</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="hr_rfid_door_open_close_wiz_form"/>
            <field name="target">new</field>
            <field name="help" type="html">
                <p>
                    Remotely control door locks. You can temporarily unlock doors for a specified
                    duration or lock them immediately. This sends commands directly to the door controllers.
                </p>
            </field>
        </record>

        <record id="hr_rfid_door_action" model="ir.actions.act_window">
            <field name="name">Doors</field>
            <field name="res_model">hr.rfid.door</field>
            <field name="view_mode">kanban,list,form,search</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No doors configured yet
                </p>
                <p>
                    Doors are physical access points controlled by RFID readers. Each door is managed by a controller
                    and can be part of multiple access groups. You can configure unlock times, alarm settings, and
                    monitor access events for each door.
                </p>
                <p>
                    Doors are automatically created when controllers are configured. To add new doors, configure them
                    on the physical controller first, then sync with the system.
                </p>
            </field>
        </record>

        <record id="hr_rfid_door_view_form" model="ir.ui.view">
            <field name="name">hr.rfid.door.form</field>
            <field name="model">hr.rfid.door</field>
            <field name="arch" type="xml">
                <form create="false" delete="false">
                    <field name="card_rel_ids" invisible="1"/>
                    <field name="access_group_ids" invisible="1"/>
                    <field name="reader_ids" invisible="1"/>
                    <field name="zone_ids" invisible="1"/>
                    <field name="alarm_line_ids" invisible="1"/>
                    <field name="th_id" invisible="1"/>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="button_act_window"
                                    context="{'res_model':'hr.rfid.ctrl.th.log'}"
                                    type="object"
                                    invisible="not th_id"
                                    class="oe_stat_button" icon="fa-thermometer-full">
                                Temp Log
                            </button>
                            <button name="button_act_window"
                                    context="{'res_model':'hr.rfid.event.user'}"
                                    type="object"
                                    invisible="user_event_count &gt; 0"
                                    class="oe_stat_button" icon="fa-list-alt">
                                <field name="user_event_count" widget="statinfo" string="User Events"/>
                            </button>
                            <button name="button_act_window"
                                    context="{'res_model':'hr.rfid.event.system'}"
                                    type="object"
                                    invisible="system_event_count &gt; 0"
                                    class="oe_stat_button" icon="fa-list-alt">
                                <field name="system_event_count" widget="statinfo" string="System Events"/>
                            </button>
                            <button name="button_act_window"
                                    context="{'res_model':'hr.rfid.access.group'}"
                                    type="object"
                                    invisible="not access_group_ids"
                                    class="oe_stat_button" icon="fa-list-alt">
                                <field name="access_group_count" widget="statinfo" string="in Access Groups"/>
                            </button>
                            <button name="button_act_window"
                                    context="{'res_model':'hr.rfid.reader'}"
                                    type="object"
                                    invisible="not reader_ids"
                                    class="oe_stat_button" icon="fa-list-alt">
                                <field name="reader_count" widget="statinfo" string="Readers"/>
                            </button>
                            <button name="button_act_window"
                                    context="{'res_model':'hr.rfid.ctrl.alarm'}"
                                    type="object"
                                    invisible="not alarm_line_ids"
                                    class="oe_stat_button" icon="fa-list-alt">
                                <field name="alarm_lines_count" widget="statinfo" string="Alarm Lines"/>
                            </button>
                            <button name="button_act_window"
                                    context="{'res_model':'hr.rfid.card'}"
                                    type="object"
                                    invisible="not card_rel_ids"
                                    class="oe_stat_button" icon="fa-list-alt">
                                <field name="card_count" widget="statinfo" string="Cards"/>
                            </button>
                            <button name="button_act_window"
                                    context="{'res_model':'hr.rfid.zone'}"
                                    type="object"
                                    invisible="not zone_ids"
                                    class="oe_stat_button" icon="fa-list-alt">
                                <field name="zone_count" widget="statinfo" string="in Zones"/>
                            </button>

                        </div>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Enter friendly door name"/>
                            </h1>
                        </div>
                        <field name="emergency_state" invisible="1"/>
                        <widget name="web_ribbon" title="Emergency Opened" bg_color="bg-danger"
                                invisible="emergency_state not in ['soft', 'hard']"/>
                        <group>
                            <group name="setup">
                                <field name="card_type"/>
                                <field name="apb_mode"/>
                                <field name="lock_time" min="0" max="99"/>
                            </group>
                            <group name="location">
                                <field name="controller_id" readonly="1"/>
                                <field name="number" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="hotel_readers" invisible="1"/>
                            <group invisible="hotel_readers==0">
                                <field name="hb_card_present" readonly="1"/>
                                <field name="hb_clean" readonly="1"/>
                                <field name="hb_dnd" readonly="1"/>
                            </group>
                        </group>
                        <group string="Debug Information" groups="base.group_no_one" colspan="4">
                            <field name="lock_state" readonly="1"/>
                            <field name="lock_output" readonly="1"/>
                            <field name="alarm_line_ids" readonly="1"/>
                            <field name="alarm_state" readonly="1"/>
                            <field name="th_id" readonly="1"/>
                        </group>
                    </sheet>
                     <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="hr_rfid_door_view_list" model="ir.ui.view">
            <field name="name">hr.rfid.door.list</field>
            <field name="model">hr.rfid.door</field>
            <field name="arch" type="xml">
                <list create="false" delete="false" sample="1">
                    <field name="name"/>
                    <field name="controller_id"/>
                    <field name="webstack_id" optional="show"/>
                    <field name="card_type" optional="show"/>
                    <field name="apb_mode" optional="show"/>
                    <button name="open_door" string="Open" invisible="1"
                            groups="hr_rfid.hr_rfid_view_door_open_close"
                            class="oe_stat_button" icon="fa-1x fa-unlock" type="object"/>
                    <button name="arm_door" string="Arm" invisible="1"
                            groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                            class="oe_stat_button text-danger"
                            icon="fa-1x fa-shield" type="object"/>
                    <button name="disarm_door" string="Disarm" invisible="1"
                            groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                            class="oe_stat_button text-success" icon="fa-1x fa-shield" type="object"/>

                </list>
            </field>
        </record>

        <record id="hr_rfid_door_view_kanban" model="ir.ui.view">
            <field name="name">hr.rfid.door.kanban</field>
            <field name="model">hr.rfid.door</field>
            <field name="arch" type="xml">
                <kanban sample="1" group_create="false"
                        group_edit="false"
                        quick_create="false"
                        create="false">
                    <field name="id"/>
                    <field name="card_type"/>
                    <field name="user_event_count"/>
                    <field name="system_event_count"/>
                    <field name="access_group_count"/>
                    <field name="card_count"/>
                    <field name="zone_count"/>
                    <field name="alarm_line_ids"/>
                    <field name="lock_state"/>
                    <field name="alarm_state"/>
                    <field name="temperature"/>
                    <field name="humidity"/>
                    <field name="siren_state"/>
                    <field name="emergency_state"/>
                    <templates>
                        <!-- Main card template (required) -->
                        <t t-name="card">
                            <div class="oe_kanban_global_click position-relative">
                                <div class="oe_kanban_details">
                                    <div class="position-absolute top-0 end-0 mt-2 me-2">
                                        <span t-if="record.siren_state.raw_value and record.alarm_state.raw_value != 'no_alarm'"
                                              class="fa fa-bell text-danger me-1" title="Siren On"/>
                                        <span t-if="record.alarm_state.raw_value == 'arm'"
                                              class="fa fa-shield text-danger me-1" title="Armed"/>
                                        <span t-if="record.alarm_state.raw_value == 'disarm'"
                                              class="fa fa-shield text-success me-1" title="Disarmed"/>
                                        <span t-if="record.alarm_state.raw_value == 'no-alarm'"
                                              class="fa fa-shield text-warning me-1" title="No Alarm"/>
                                        <span t-if="record.lock_state.raw_value"
                                              class="fa fa-unlock text-success" title="Unlocked"/>
                                        <span t-if="!record.lock_state.raw_value"
                                              class="fa fa-lock text-danger" title="Locked"/>
                                        <span t-if="record.emergency_state.raw_value == 'soft'"
                                              class="fa fa-free-code-camp text-danger ms-1" title="Software Emergency"/>
                                        <span t-if="record.emergency_state.raw_value == 'hard'"
                                              class="fa fa-fire text-danger ms-1" title="Hardware Emergency"/>
                                    </div>
                                    <div class="o_kanban_record_top mb-2">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                    <ul class="list-unstyled text-muted small">
                                        <li t-if="record.card_type.raw_value">
                                            <span class="text-muted">Type:</span> <field name="card_type"/>
                                        </li>
                                        <li t-if="record.emergency_state.raw_value">
                                            <i t-att-class="record.emergency_state.raw_value == 'off' ? 'fa fa-free-code-camp text-success me-1' : 'fa fa-fire text-danger me-1'" title="Emergency State"/>
                                            <field name="emergency_state" t-att-class="record.emergency_state.raw_value == 'off' ? 'text-success' : 'text-danger'"/>
                                        </li>
                                        <li t-if="record.temperature.raw_value">
                                            <i class="fa fa-thermometer-full text-info me-1" title="Temperature"/>
                                            <field name="temperature"/>℃
                                            <span class="ms-2">
                                                <i class="fa fa-tint text-info me-1" title="Humidity"/>
                                                <field name="humidity"/>%
                                            </span>
                                        </li>
                                    </ul>
                                </div>
                                <div class="oe_kanban_footer">
                                    <div class="o_kanban_record_bottom d-flex justify-content-between align-items-center">
                                        <div class="oe_kanban_bottom_left">
                                            <button name="siren_off" type="object" title="Turn off the siren"
                                                    groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                                                    t-if="record.siren_state.raw_value and record.alarm_state.raw_value != 'no_alarm'"
                                                    class="btn btn-link btn-sm ps-0 pe-1">
                                                <i class="fa fa-bell-slash-o text-success"/>
                                            </button>
                                            <button name="siren_on" type="object" title="Turn on the siren"
                                                    groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                                                    t-if="!record.siren_state.raw_value and record.alarm_state.raw_value != 'no_alarm'"
                                                    class="btn btn-link btn-sm ps-0 pe-1">
                                                <i class="fa fa-bell text-danger"/>
                                            </button>
                                            <button name="disarm_door" type="object" title="Disarm the door alarm"
                                                    groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                                                    t-if="record.alarm_state.raw_value == 'arm'"
                                                    class="btn btn-link btn-sm ps-0 pe-1">
                                                <i class="fa fa-universal-access text-success"/>
                                            </button>
                                            <button name="arm_door" type="object" title="Arm the door alarm"
                                                    groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                                                    t-if="record.alarm_state.raw_value == 'disarm'"
                                                    class="btn btn-link btn-sm ps-0 pe-1">
                                                <i class="fa fa-shield text-danger"/>
                                            </button>
                                            <button name="open_door" type="object" title="Unlock the door"
                                                    groups="hr_rfid.hr_rfid_view_door_open_close"
                                                    class="btn btn-link btn-sm ps-0 pe-1">
                                                <i class="fa fa-unlock text-success"/>
                                            </button>
                                            <button name="close_door" type="object" title="Lock the door"
                                                    groups="hr_rfid.hr_rfid_view_door_open_close"
                                                    class="btn btn-link btn-sm ps-0 pe-1">
                                                <i class="fa fa-lock text-danger"/>
                                            </button>
                                            <span t-if="record.user_event_count.value > 0" class="badge rounded-pill me-1">
                                                <a name="button_act_window" type="object"
                                                   context="{'res_model':'hr.rfid.event.user'}" class="text-reset text-decoration-none">
                                                    <i class="fa fa-list" title="User Events"/> <t t-esc="record.user_event_count.value"/>
                                                </a>
                                            </span>
                                            <span t-if="record.system_event_count.value > 0" class="badge rounded-pill me-1">
                                                <a name="button_act_window" type="object"
                                                   context="{'res_model':'hr.rfid.event.system'}" class="text-reset text-decoration-none">
                                                    <i class="fa fa-list" title="System Events"/> <t t-esc="record.system_event_count.value"/>
                                                </a>
                                            </span>
                                            <span t-if="record.access_group_count.value > 0" class="badge rounded-pill me-1">
                                                <a name="button_act_window" type="object"
                                                   context="{'res_model':'hr.rfid.access.group'}" class="text-reset text-decoration-none">
                                                    <i class="fa fa-users" title="Access Groups"/> <t t-esc="record.access_group_count.value"/>
                                                </a>
                                            </span>
                                            <span t-if="record.card_count.value > 0" class="badge rounded-pill me-1">
                                                <a name="button_act_window" type="object"
                                                   context="{'res_model':'hr.rfid.card'}" class="text-reset text-decoration-none">
                                                    <i class="fa fa-id-card" title="Cards"/> <t t-esc="record.card_count.value"/>
                                                </a>
                                            </span>
                                            <span t-if="record.zone_count.value > 0" class="badge rounded-pill me-1">
                                                <a name="button_act_window" type="object"
                                                   context="{'res_model':'hr.rfid.zone'}" class="text-reset text-decoration-none">
                                                    <i class="fa fa-map-marker" title="Zones"/> <t t-esc="record.zone_count.value"/>
                                                </a>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                        
                        <!-- Menu template (optional) -->
                        <t t-name="menu" t-if="!selection_mode" groups="base.group_user">
                            <a role="menuitem" class="dropdown-item" name="hr_rfid.hr_rfid_door_open_close_wiz_action"
                               type="action">Open/close door
                            </a>
                            <div role="separator" class="dropdown-divider"/>
                            <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                        </t>
                        
                        <!-- Tooltip template (optional) -->
                        <t t-name="tooltip">
                            <div>
                                <field name="name" class="fw-bold"/>
                                <div class="text-muted">
                                    <span>Type: </span><field name="card_type"/>
                                    <div t-if="record.alarm_state.raw_value">
                                        <span>Alarm: </span><field name="alarm_state"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!--    TODO delete buttons and move the actions-->
        <record id="action_open_door" model="ir.actions.server">
            <field name="name">Open door</field>
            <field name="model_id" ref="hr_rfid.model_hr_rfid_door"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">record.open_door()</field>
            <field name="binding_model_id" ref="hr_rfid.model_hr_rfid_door"/>
            <field name="binding_view_types">form</field>
            <field name="group_ids" eval="[(4,ref('hr_rfid.hr_rfid_view_door_open_close'))]"/>
        </record>

        <record id="action_close_door" model="ir.actions.server">
            <field name="name">Close door</field>
            <field name="model_id" ref="hr_rfid.model_hr_rfid_door"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">record.close_door()</field>
            <field name="binding_model_id" ref="hr_rfid.model_hr_rfid_door"/>
            <field name="binding_view_types">form</field>
            <field name="group_ids" eval="[(4,ref('hr_rfid.hr_rfid_view_door_open_close'))]"/>
        </record>

        <record id="hr_rfid_door_view_search" model="ir.ui.view">
            <field name="name">hr.rfid.door.search</field>
            <field name="model">hr.rfid.door</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="controller_id"/>
                    <field name="card_type"/>
                    <filter string="by Controller" name="groupby_controller"
                            context="{'group_by':'controller_id'}"/>
                    <filter string="by Card Type" name="groupby_card_type"
                            context="{'group_by':'card_type'}"/>
                    <searchpanel>
                        <field name="controller_id" icon="fa-info-circle" color="#875A7B"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="hr_rfid_door_open_close_wiz_act_window" model="ir.actions.act_window">
            <field name="name">Open/close door</field>
            <field name="binding_model_id" ref="hr_rfid.model_hr_rfid_door"/>
            <field name="res_model">hr.rfid.door.open.close.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="help" type="html">
                <p>
                    Remotely control door locks. You can temporarily unlock doors for a specified
                    duration or lock them immediately. This sends commands directly to the door controllers.
                </p>
            </field>
        </record>
    </data>
</odoo>