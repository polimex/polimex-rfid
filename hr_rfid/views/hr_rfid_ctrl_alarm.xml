<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_rfid_ctrl_alarm_list_view" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.alarm.list.view</field>
            <field name="model">hr.rfid.ctrl.alarm</field>
            <field name="arch" type="xml">
                <list string="Alarm line list" create="0" delete="0" sample="1"
                      decoration-success="state == 'normal'"
                      decoration-warning="state in ['short','open']"
                      decoration-info="state == 'disabled'"
                      decoration-danger="state in ['s1','s2','s12']">

                    <field name="name"/>
                    <field name="door_id"/>
                    <field name="controller_id" optional="show"/>
                    <field name="alarm_group_id" optional="show"/>
                    <field name="armed"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="hr_rfid_ctrl_alarm_form_view" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.alarm.form.view</field>
            <field name="model">hr.rfid.ctrl.alarm</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                        <field name="state"
                               widget="statusbar"
                               statusbar_colors="{'no_alarm':'gray', 'arm':'red', 'disarm':'green'}"
                               statusbar_visible=" "/>
                    </header>
                    <sheet>
                        <field name="enabled" invisible="1"/>
                        <widget name="web_ribbon" title="Disabled" bg_color="text-bg-danger"
                                invisible="enabled"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="disarm" type="object" class="oe_stat_button oe_read_only text-danger"
                                    icon="fa-shield"
                                    help="This alarm is currently ARMED and monitoring for intrusions. Click to DISARM and temporarily disable monitoring."
                                    groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                                    invisible="armed!='arm'">
                                Arm
                            </button>
                            <button name="arm" type="object" class="oe_stat_button oe_read_only text-success"
                                    icon="fa-shield"
                                    help="This alarm is currently DISARMED and not monitoring. Click to ARM and start monitoring for intrusions."
                                    groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                                    invisible="armed!='disarm'">
                                Disarm
                            </button>
                            <button name="return_action_to_open" type="object" class="oe_stat_button" icon="fa-list"
                                    context="{'xml_id':'hr_rfid_event_system'}"
                                    help="View technical events for this alarm line (arm/disarm actions, sensor faults, communication errors)"
                                    invisible="system_event_count==0">
                                <field name="system_event_count" widget="statinfo" string="System Events"/>
                            </button>
                            <button name="return_action_to_open" type="object" class="oe_stat_button" icon="fa-user"
                                    context="{'xml_id':'hr_rfid_event_user'}"
                                    help="View alarm triggers and user-related events (motion detected, door opened while armed)"
                                    invisible="user_event_count==0">
                                <field name="user_event_count" widget="statinfo" string="User Events"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="armed"/>
                                <field name="enableDC" widget="boolean_toggle"/>
                                <field name="enableAC" widget="boolean_toggle"/>
                                <field name="enabled" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="controller_id"/>
                                <field name="door_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="alarm_group_id"/>
                            </group>
                        </group>
                        <group string="Debug Information" groups="base.group_no_one" colspan="4">
                            <field name="line_number" readonly="1"/>
                            <field name="control_output" readonly="1"/>
                        </group>
                    </sheet>
                     <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="hr_rfid_ctrl_alarm_view_kanban" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.alarm.kanban</field>
            <field name="model">hr.rfid.ctrl.alarm</field>
            <field name="arch" type="xml">
                <kanban disable_drag_drop_record="true">
<!--                        group_create="false"-->
<!--                        group_edit="false"-->
<!--                        quick_create="false"-->
<!--                        create="false">-->
                    <field name="state"/>
                    <field name="armed"/>
                    <field name="door_id"/>
                    <field name="alarm_group_id"/>
                    <field name="user_event_count"/>
                    <field name="system_event_count"/>
                    <field name="siren_state"/>
                    <field name="enabled"/>
                    <templates>
                        <!-- Main card template (required) -->
                        <t t-name="card">
                            <div class="oe_kanban_global_click position-relative">
                                <widget name="web_ribbon" title="Disabled" bg_color="text-bg-danger"
                                        invisible="enabled" class="position-absolute"/>
                                <div class="oe_kanban_details">
                                    <div class="position-absolute top-0 end-0 mt-2 me-2">
                                        <span t-if="record.siren_state.raw_value and record.armed.raw_value != 'no_alarm'"
                                              class="fa fa-bell text-danger me-1" title="Siren On"/>
                                        <span t-if="record.armed.raw_value == 'arm'"
                                              class="fa fa-shield text-danger" title="Armed"/>
                                        <span t-if="record.armed.raw_value == 'disarm'"
                                              class="fa fa-shield text-success" title="Disarmed"/>
                                    </div>
                                    <div class="o_kanban_record_top mb-2">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                    <ul class="list-unstyled text-muted small">
                                        <li>
                                            <span class="text-muted">State:</span>
                                            <field name="state"
                                                   decoration-success="state == 'normal'"
                                                   decoration-warning="state in ['short','open']"
                                                   decoration-info="state == 'disabled'"
                                                   decoration-danger="state in ['s1','s2','s12']"/>
                                        </li>
                                        <li t-if="record.door_id.raw_value">
                                            <i class="fa fa-door-open me-1" title="Door"/>
                                            <field name="door_id"/>
                                        </li>
                                        <li t-if="record.alarm_group_id.raw_value">
                                            <i class="fa fa-users me-1" title="Group"/>
                                            <field name="alarm_group_id"/>
                                        </li>
                                    </ul>
                                </div>
                                <div class="oe_kanban_footer">
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <button name="arm" type="object" title="Arm the alarm line"
                                                    t-if="record.armed.raw_value == 'disarm'"
                                                    groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                                                    class="btn btn-link btn-sm ps-0 pe-1">
                                                <i class="fa fa-shield text-danger"/>
                                            </button>
                                            <button name="disarm" type="object" title="Disarm the alarm line"
                                                    t-if="record.armed.raw_value == 'arm'"
                                                    groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                                                    class="btn btn-link btn-sm ps-0 pe-1">
                                                <i class="fa fa-universal-access text-success"/>
                                            </button>
                                            <span t-if="record.user_event_count.value > 0"
                                                  class="badge rounded-pill me-1">
                                                <a name="return_action_to_open" type="object"
                                                   context="{'xml_id':'hr_rfid_event_user'}" class="text-reset text-decoration-none">
                                                    <i class="fa fa-user" title="User Events"/>
                                                    <t t-esc="record.user_event_count.value"/>
                                                </a>
                                            </span>
                                            <span t-if="record.system_event_count.value > 0"
                                                  class="badge rounded-pill me-1">
                                                <a name="return_action_to_open" type="object"
                                                   context="{'xml_id':'hr_rfid_event_system'}" class="text-reset text-decoration-none">
                                                    <i class="fa fa-microchip" title="System Events"/>
                                                    <t t-esc="record.system_event_count.value"/>
                                                </a>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                        
                        <!-- Menu template (optional) -->
                        <t t-name="menu" t-if="!selection_mode" groups="base.group_user">
                            <a role="menuitem" type="object" name="arm" class="dropdown-item"
                               t-if="record.armed.raw_value == 'disarm'">Arm</a>
                            <a role="menuitem" type="object" name="disarm" class="dropdown-item" 
                               t-if="record.armed.raw_value == 'arm'">Disarm</a>
                            <div role="separator" class="dropdown-divider"/>
                            <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                        </t>
                        
                        <!-- Tooltip template (optional) -->
                        <t t-name="tooltip">
                            <div>
                                <field name="name" class="fw-bold"/>
                                <div class="text-muted">
                                    <span>State: </span><field name="state"/>
                                    <div t-if="record.door_id.raw_value">
                                        <span>Door: </span><field name="door_id"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="hr_rfid_ctrl_alarm_search_view" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.alarm.search.view</field>
            <field name="model">hr.rfid.ctrl.alarm</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="name"/>
                    <field name="door_id"/>
                    <field name="controller_id"/>
                    <searchpanel>
                        <field name="controller_id" icon="fa-info-circle" color="#875A7B"/>
                        <field name="door_id" icon="fa-info-circle" color="#875A7B"/>
                    </searchpanel>

                </search>
            </field>
        </record>

        <record id="hr_rfid_ctrl_alarm_action" model="ir.actions.act_window">
            <field name="name">Alarm Lines</field>
            <field name="res_model">hr.rfid.ctrl.alarm</field>
            <field name="view_mode">kanban,list,form,search</field>
            <field name="view_id" ref="hr_rfid_ctrl_alarm_view_kanban"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No alarm lines configured yet
                </p>
                <p>
                    Alarm lines are security sensors connected to your RFID controllers.
                    They monitor for unauthorized access, motion, or door openings.
                </p>
                <p>
                    Common alarm types include:
                </p>
                <ul>
                    <li><b>Motion Detectors</b> - Detect movement in protected areas</li>
                    <li><b>Door Contacts</b> - Monitor if doors are opened when armed</li>
                    <li><b>Window Sensors</b> - Alert when windows are opened</li>
                    <li><b>Glass Break Detectors</b> - Detect breaking glass</li>
                </ul>
                <p>
                    Each alarm can be individually armed/disarmed and grouped for easier management.
                </p>
            </field>
        </record>

    </data>
</odoo>