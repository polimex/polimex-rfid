<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <record id="hr_view_employee_form_inherit_hr_rfid" model="ir.ui.view">
            <field name="name">hr.employee.rfid.info</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="button_employee_events"
                            type="object"
                            invisible="employee_event_count == 0"
                            groups="hr_rfid.hr_rfid_group_officer"
                            class="oe_stat_button" icon="fa-list-alt">
                        <field name="employee_event_count" widget="statinfo" string="Events"/>
                    </button>
                    <button name="button_doors_list" title="Accessible doors"
                            type="object" class="oe_stat_button" icon="fa-list-alt"
                            groups="hr_rfid.hr_rfid_group_officer"
                            invisible="employee_doors_count == 0">
                        <field name="employee_doors_count" widget="statinfo" string="Doors"/>
                    </button>
                </xpath>
                <notebook position="inside">
                    <page string="RFID Info"
                          name="rfid_info"
                          groups="hr_rfid.hr_rfid_group_officer"
                          invisible="not id">
                        <p class="text-muted">
                            RFID access for this employee: the personal PIN (used at PIN-enabled readers), the cards issued to them, and the access groups that decide which doors they can open.
                        </p>
                        <group>
                            <field name="hr_rfid_pin_code" groups="hr_rfid.hr_rfid_view_rfid_pin_code_data"/>
                        </group>
                        <notebook>
                            <page string="Cards" name="employee_cards">
                                <field name="hr_rfid_card_ids"
                                       context="{'active_test': False, 'default_employee_id': context.get('active_id')}"
                                       edit="0">
                                    <tree string="Cards belonging this employee" editable="bottom"
                                          decoration-success="active"
                                          decoration-danger="not active">
                                        <field name="active" invisible="1"/>
                                        <field name="number" help="Unique card identifier (hexadecimal format for RFID, numeric for Barcode)"/>
                                        <field name="card_reference" help="Optional reference label for easy identification"/>
                                        <field name="activate_on" help="Date when this card becomes active (leave empty for immediate activation)"/>
                                        <field name="deactivate_on" help="Date when this card expires (leave empty for no expiration)"/>
                                        <field name="card_type" help="Type of card: RFID for proximity cards, Barcode for printed badges"/>
                                        <field name="cloud_card" help="Enable for virtual/mobile cards that work through cloud services"/>
                                    </tree>
                                </field>
                                <label for="hr_rfid_card_ids" string="New Barcode card"/>
                                <div class="o_row">
                                    <button string="Generate" class="btn btn-link" type="object"
                                            name="generate_random_barcode_card"/>
                                </div>

                            </page>

                            <page string="Access Groups" name="employee_access_groups">
                                <p class="text-muted">
                                    Groups grant doors and schedules to this employee. Membership can be time-limited (set Expiration) or temporarily disabled via the state toggle.
                                </p>
                                <field name="hr_rfid_access_group_ids" widget="one2many_list">
                                    <tree editable="bottom">
                                        <field name="access_group_id"
                                               domain="[('department_ids','in',[parent.department_id])]"
                                               help="Select an access group available for the employee's department"/>
                                        <field name="activate_on" help="Date when this access group membership becomes active"/>
                                        <field name="expiration" help="Date when this access group membership expires (leave empty for permanent access)"/>
                                        <field name="state" widget="boolean_toggle" help="Enable/disable this access group membership temporarily"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
