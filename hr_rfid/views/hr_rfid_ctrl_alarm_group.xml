<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_rfid_ctrl_alarm_group_list_view" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.alarm.group.list.view</field>
            <field name="model">hr.rfid.ctrl.alarm.group</field>
            <field name="arch" type="xml">
                <list string="Alarm line list" sample="1"
                      decoration-success="state == 'disarm'"
                      decoration-warning="state == 'mixed'"
                      decoration-info="state == 'no_alarm'"
                      decoration-danger="state == 'arm'">

                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="alarm_line_ids" widget="many2many_tags" optional="hide"/>
                    <field name="state"/>
               </list>
            </field>
        </record>

        <record id="hr_rfid_ctrl_alarm_group_form_view" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.alarm.group.form.view</field>
            <field name="model">hr.rfid.ctrl.alarm.group</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                        <field name="state"
                               widget="statusbar"
                               statusbar_colors="{'no_alarm':'gray', 'arm':'red', 'mixed':'yellow', 'disarm':'green'}"
                               statusbar_visible=" "/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="disarm" type="object" class="oe_stat_button text-danger oe_read_only"
                                    icon="fa-shield"
                                    groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                                    help="DISARM all alarm sensors in this group and its sub-groups. The sensors will stop monitoring until re-armed."
                                    confirm="Are you sure to Disarm all lines in the group?"
                                    invisible="state in ['arm','mixed']">
                                Disarm
                            </button>
                            <button name="arm" type="object" class="oe_stat_button text-success oe_read_only"
                                    icon="fa-shield"
                                    groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                                    help="ARM all alarm sensors in this group and its sub-groups. All sensors will start actively monitoring for intrusions."
                                    confirm="Are you sure to Arm all lines in the group?"
                                    invisible="state in ['disarm','disarm']">
                                Arm
                            </button>
                            <button name="create_child" type="object" class="oe_stat_button text-primary oe_read_only"
                                    icon="fa-plus"
                                    help="Create a sub-group under this group for hierarchical organization (e.g., Building > Floor > Room)">
                                Create Child
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="The name of the alarm lines group"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="parent_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>

                        </group>
                        <group string="Included alarm lines">
                            <field name="alarm_line_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Child alarm groups">
                            <field name="child_ids" readonly="1" widget="many2many_tags"/>
                        </group>
                        <group string="Debug Information" groups="base.group_no_one" colspan="4">
                        </group>
                    </sheet>
                     <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="hr_rfid_ctrl_alarm_group_hierarchy_view" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.alarm.group.hierarchy.view</field>
            <field name="model">hr.rfid.ctrl.alarm.group</field>
            <field name="arch" type="xml">
                <hierarchy child_field="child_ids" draggable="1">
                    <field name="name"/>
                    <field name="color"/>
                    <templates>
                        <t t-name="hierarchy-box">
                            <div t-attf-class="o_hierarchy_node_header d-flex justify-content-center align-items-center o_hierarchy_node_color_{{ record.color.raw_value }}">
                                <field name="name"/>
                                <field name="state" invisible="1"/>
                                <button class="btn btn-link" name="disarm" type="object"
                                        t-if="record.state.raw_value == 'arm'">
                                    <i class="fa fa-universal-access text-success ms-auto"
                                       title="Disarm the Group"/>
                                </button>
                                <button class="btn btn-link" name="arm" type="object"
                                        t-if="record.state.raw_value == 'disarm'">
                                    <i class="fa fa-shield text-danger ms-auto"
                                       title="Arm the Group"/>
                                </button>
                            </div>
                            <div class="o_hierarchy_node_body d-flex flex-column">
                                <field name="alarm_line_ids" invisible="1"/>
                                <div>
                                    <button class="btn btn-link" name="open_alarm_line_list_action"
                                            type="object" t-if="record.alarm_line_ids.raw_value">
                                        <field name="alarm_line_ids" widget="many2many_tags"/>
                                    </button>
                                </div>
                            </div>
                        </t>
                    </templates>
                </hierarchy>
            </field>
        </record>

        <record id="hr_rfid_ctrl_alarm_group_view_kanban" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.alarm.group.kanban</field>
            <field name="model">hr.rfid.ctrl.alarm.group</field>
            <field name="arch" type="xml">
                <kanban sample="1" group_create="false"
                        group_edit="false"
                        quick_create="false"
                        default_group_by="parent_id">
                    <field name="alarm_line_ids"/>
                    <field name="parent_id"/>
                    <field name="state"/>
                    <field name="child_ids"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click position-relative">
                                <div class="oe_kanban_details">
                                    <div class="position-absolute top-0 end-0 mt-2 me-2">
                                        <span t-if="record.state.raw_value == 'arm'"
                                              class="fa fa-shield text-danger" title="Armed"/>
                                        <span t-if="record.state.raw_value == 'disarm'"
                                              class="fa fa-shield text-success" title="Disarmed"/>
                                        <span t-if="record.state.raw_value == 'mixed'"
                                              class="fa fa-shield text-warning" title="Mixed"/>
                                    </div>
                                    <div class="o_kanban_record_top mb-2">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                    <ul class="list-unstyled text-muted small">
                                        <li>
                                            <span class="text-muted">State:</span>
                                            <field name="state"
                                                   decoration-success="state == 'disarm'"
                                                   decoration-warning="state == 'mixed'"
                                                   decoration-info="state == 'no_alarm'"
                                                   decoration-danger="state == 'arm'"/>
                                        </li>
                                        <li t-if="record.alarm_line_ids.raw_value.length > 0">
                                            <i class="fa fa-list me-1"/> <t t-esc="record.alarm_line_ids.raw_value.length"/> alarm line(s)
                                        </li>
                                        <li t-if="record.child_ids.raw_value.length > 0">
                                            <i class="fa fa-sitemap me-1"/> <t t-esc="record.child_ids.raw_value.length"/> sub-group(s)
                                        </li>
                                    </ul>
                                </div>
                                <div class="oe_kanban_footer">
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <button name="arm" type="object" title="Arm the alarm group"
                                                    groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                                                    class="btn btn-link btn-sm ps-0 pe-1">
                                                <i class="fa fa-shield text-danger"/>
                                            </button>
                                            <button name="disarm" type="object" title="Disarm the alarm group"
                                                    groups="hr_rfid.hr_rfid_view_door_arm_disarm"
                                                    class="btn btn-link btn-sm ps-0 pe-1">
                                                <i class="fa fa-universal-access text-success"/>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                        
                        <!-- Menu template (optional) -->
                        <t t-name="menu" t-if="!selection_mode" groups="base.group_user">
                            <a role="menuitem" type="object" name="arm" class="dropdown-item">Arm Group</a>
                            <a role="menuitem" type="object" name="disarm" class="dropdown-item">Disarm Group</a>
                            <a role="menuitem" type="object" name="create_child" class="dropdown-item">Create Sub-group</a>
                            <div role="separator" class="dropdown-divider"/>
                            <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        </t>
                        
                        <!-- Tooltip template (optional) -->
                        <t t-name="tooltip">
                            <div>
                                <field name="name" class="fw-bold"/>
                                <div class="text-muted">
                                    <span>State: </span><field name="state"/>
                                    <div t-if="record.parent_id.raw_value">
                                        <span>Parent: </span><field name="parent_id"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="hr_rfid_ctrl_alarm_group_search_view" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.alarm.group.search.view</field>
            <field name="model">hr.rfid.ctrl.alarm.group</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="name"/>
                    <field name="alarm_line_ids"/>
                    <searchpanel>
                        <field name="parent_id" icon="fa-info-circle" color="#875A7B"/>
                    </searchpanel>

                </search>
            </field>
        </record>

        <record id="hr_rfid_ctrl_alarm_group_action" model="ir.actions.act_window">
            <field name="name">Alarm Line Groups</field>
            <field name="res_model">hr.rfid.ctrl.alarm.group</field>
            <field name="view_mode">hierarchy,kanban,list,form,search</field>
            <field name="view_id" ref="hr_rfid_ctrl_alarm_group_hierarchy_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first alarm group
                </p>
                <p>
                    Alarm groups help you organize and manage multiple alarm sensors efficiently.
                    Instead of controlling each sensor individually, you can:
                </p>
                <ul>
                    <li><b>Arm/Disarm Multiple Alarms</b> - Control all sensors in a group with one click</li>
                    <li><b>Organize by Area</b> - Group sensors by floor, building, or department</li>
                    <li><b>Create Hierarchies</b> - Build parent-child relationships (e.g., Campus → Building → Floor)</li>
                    <li><b>Monitor Status</b> - See if all alarms in a group are armed, disarmed, or mixed</li>
                </ul>
                <p>
                    <b>Example Groups:</b>
                </p>
                <ul>
                    <li>"First Floor Security" - All sensors on the first floor</li>
                    <li>"Warehouse Perimeter" - All door and window sensors around the warehouse</li>
                    <li>"After Hours Protection" - Motion detectors that should be armed at night</li>
                </ul>
                <p>
                    Click <b>Create</b> to set up your first alarm group and start organizing your security system.
                </p>
            </field>
        </record>

    </data>
</odoo>