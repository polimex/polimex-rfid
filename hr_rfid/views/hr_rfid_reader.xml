<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_rfid_reader_action" model="ir.actions.act_window">
            <field name="name">Readers</field>
            <field name="res_model">hr.rfid.reader</field>
            <field name="view_mode">list,form,search</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No readers configured yet
                </p>
                <p>
                    RFID readers are physical devices that scan access cards at entry/exit points.
                    Each reader is connected to a controller and can manage one or more doors.
                </p>
                <p>
                    <b>Reader Types:</b><br/>
                    • <b>In (Entry)</b> - Records when someone enters an area<br/>
                    • <b>Out (Exit)</b> - Records when someone leaves an area
                </p>
                <p>
                    <b>Reader Modes:</b><br/>
                    • <b>Card Only</b> - Simple card scan for access<br/>
                    • <b>Card + PIN</b> - Enhanced security with PIN verification<br/>
                    • <b>Card + Workcode</b> - For tracking time on specific projects<br/>
                    • <b>Card or PIN</b> - Flexible access with either method
                </p>
                <p class="text-muted">
                    <i>Note: Readers are automatically created when controllers are configured. 
                    You typically don't need to create them manually.</i>
                </p>
            </field>
        </record>

        <record id="hr_rfid_reader_view_form" model="ir.ui.view">
            <field name="name">hr.rfid.reader.form</field>
            <field name="model">hr.rfid.reader</field>
            <field name="arch" type="xml">
                <form create="false" delete="false">
                    <sheet>
                        <field name="door_ids" invisible="1"/>
                        <field name="user_event_ids" invisible="1"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="button_door_list"
                                    type="object" invisible="not door_ids"
                                    class="oe_stat_button" icon="fa-list-alt">
                                <field name="door_count" widget="statinfo" string="Doors"/>
                            </button>
                            <button name="button_event_list"
                                    type="object" invisible="not user_event_ids"
                                    class="oe_stat_button" icon="fa-list-alt">
                                <field name="user_event_count" widget="statinfo" string="User Events"/>
                            </button>

                        </div>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Enter friendly name of the reader"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Setup information">
                                <field name="mode"/>
                                <field name="reader_type"/>
                            </group>
                            <group string="Information">
                                <field name="number" readonly="1"/>
                                <field name="controller_id" readonly="1"/>
                                <field name="door_id" readonly="1"
                                       invisible="not door_id"/>
                            </group>
                        </group>
                    </sheet>
                     <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="hr_rfid_reader_view_list" model="ir.ui.view">
            <field name="name">hr.rfid.reader.list</field>
            <field name="model">hr.rfid.reader</field>
            <field name="arch" type="xml">
                <list create="false" delete="false" sample="1">
                    <field name="name"/>
                    <field name="mode"/>
                    <field name="reader_type"/>
                    <field name="door_ids" widget="many2many_tags" optional="show"/>
                    <field name="controller_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="hr_rfid_reader_view_search" model="ir.ui.view">
            <field name="name">hr.rfid.reader.search</field>
            <field name="model">hr.rfid.reader</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="mode"/>
                    <field name="controller_id"/>
                    <field name="reader_type"/>
                    <searchpanel>
                        <field name="controller_id" icon="fa-info-circle" color="#875A7B"/>
                    </searchpanel>
                </search>
            </field>
        </record>

    </data>
</odoo>