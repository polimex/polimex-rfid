<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rfid_form_inherit_res_company" model="ir.ui.view">
            <field name="name">res.company</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="RFID" name="rfid" groups="hr_rfid.hr_rfid_group_manager">
                        <p class="text-muted">
                            Company-wide defaults for the access-control stack. The event lifetime controls how long card swipes are retained before the cleanup cron archives them; the card input type sets the format the readers report.
                        </p>
                        <group string="RFID settings" name="rfid">
                            <group>
                                <field name="event_lifetime"/>
                                <field name="card_input_type"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>