<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_rfid_workcode_action" model="ir.actions.act_window">
            <field name="name">Workcodes</field>
            <field name="res_model">hr.rfid.workcode</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first workcode
                </p>
                <p>
                    Workcodes are 4-digit numerical codes that employees use at RFID terminals 
                    to track their time and attendance. Each workcode represents a specific action 
                    like starting work, taking a break, or leaving for the day.
                </p>
                <p>
                    <b>Common workcode setup:</b><br/>
                    • 0001 - Start Work (Clock In)<br/>
                    • 0002 - Start Break (Lunch/Rest)<br/>
                    • 0003 - End Break (Return from Break)<br/>
                    • 0004 - End Work (Clock Out)<br/>
                </p>
                <p>
                    Employees will enter these codes on RFID terminals along with their RFID card 
                    to record their attendance actions throughout the workday.
                </p>
            </field>
        </record>

        <record id="hr_rfid_workcode_view_form" model="ir.ui.view">
            <field name="name">hr.rfid.workcode.form</field>
            <field name="model">hr.rfid.workcode</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title" modifiers="{}">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <field name="workcode" readonly="id>0"/>
                            <field name="user_action"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </sheet>
                     <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="hr_rfid_workcode_view_list" model="ir.ui.view">
            <field name="name">hr.rfid.workcode.list</field>
            <field name="model">hr.rfid.workcode</field>
            <field name="arch" type="xml">
                <list sample="1">
                    <field name="name"/>
                    <field name="workcode"/>
                    <field name="user_action"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>


    </data>
</odoo>