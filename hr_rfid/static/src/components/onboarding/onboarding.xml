<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_rfid.OnboardingBanner">
        <div t-if="state.html" class="o_onboarding_main d-print-none position-relative border-bottom overflow-hidden">
            <div class="o_onboarding_wrap py-3 py-lg-4">
                <a href="#" class="o_onboarding_btn_close position-absolute top-0 end-0 py-2 px-3 h2"
                   title="Close the onboarding panel"
                   t-on-click.stop.prevent="onCloseBanner">
                    <i class="oi oi-close"/>
                </a>
                <div class="o_onboarding_steps d-flex">
                    <t t-foreach="state.steps" t-as="step" t-key="step.id">
                        <div class="o_onboarding_step position-relative d-flex flex-column align-items-center justify-content-start text-center"
                             t-att-data-step-state="step.state">
                            <img t-if="step.state === 'just_done'"
                                 class="o_onboarding_confetti position-absolute w-100"
                                 src="/base/static/img/onboarding_confetti.svg"
                                 alt="confetti"/>
                            <div class="o_onboarding_line position-absolute"/>
                            <div class="o_onboarding_step_side d-flex">
                                <img class="z-1"
                                     t-attf-src="/web/image/onboarding.onboarding.step/{{step.id}}/step_image"
                                     t-att-alt="step.title"/>
                            </div>
                            <div class="o_onboarding_step_content position-relative pt-2 flex-grow-1 d-flex flex-column align-items-center justify-content-around">
                                <div class="o_onboarding_step_content_info flex-grow-1 mb-2">
                                    <a href="#" role="button"
                                       t-on-click.stop.prevent="() => this.onStepClicked(step)">
                                        <h5 class="o_onboarding_step_title mb-1" t-out="step.title"/>
                                    </a>
                                    <p class="m-0 small" t-out="step.description"/>
                                </div>
                                <div t-if="step.state === 'not_done'" class="d-flex flex-column align-items-center gap-1">
                                    <a class="o_onboarding_step_action btn px-4" href="#" role="button"
                                       t-on-click.stop.prevent="() => this.onStepClicked(step)">
                                        <span t-out="step.button_text"/>
                                    </a>
                                    <a t-if="step.extra_action"
                                       class="o_onboarding_step_action btn px-4" href="#" role="button"
                                       t-on-click.stop.prevent="() => this.onExtraActionClicked(step)">
                                        <span><i class="fa fa-search me-1"/><t t-out="step.extra_action.label"/></span>
                                    </a>
                                </div>
                                <span t-else="" class="o_onboarding_step_action__done btn">
                                    <i t-attf-class="p-1 me-1 fa {{step.done_icon || 'fa-check'}} rounded-circle"/>
                                    <t t-out="step.done_text"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </div>
                <div t-if="state.onboardingState === 'just_done'"
                     class="o_onboarding_completed_message position-absolute end-0 start-0 border-bottom py-4 bg-white d-flex align-items-center justify-content-center">
                    <span class="h3 m-0">
                        <i class="fa fa-check text-success me-3"/>
                        Your RFID system is ready!
                    </span>
                    <a href="#" class="btn btn-primary ms-4"
                       t-on-click.stop.prevent="onCloseBanner">
                        Close Panel
                    </a>
                </div>
            </div>
        </div>
    </t>

</templates>
