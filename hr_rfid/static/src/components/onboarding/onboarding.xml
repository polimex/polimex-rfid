<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        The body is the server-rendered `onboarding.onboarding_panel` template
        (core markup + SCSS). We only own the click delegation: onPanelClick
        forwards step links to core's useActionLinks handler and intercepts the
        close control to use an OWL ConfirmationDialog.
    -->
    <t t-name="hr_rfid.OnboardingBanner">
        <div t-if="state.html" class="o_onboarding_container" t-on-click="onPanelClick" t-out="state.html"/>
    </t>

</templates>
