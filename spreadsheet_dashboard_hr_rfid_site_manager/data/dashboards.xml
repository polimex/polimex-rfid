<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Replace the shipped dashboards with site-enabled variants: same boards
         plus an interactive Site filter wired to every KPI and chart (events
         carry a stored site_id; system events reach the site via their door). -->
    <record id="spreadsheet_dashboard_hr_rfid.spreadsheet_dashboard_access_control"
            model="spreadsheet.dashboard">
        <field name="spreadsheet_binary_data" type="base64"
               file="spreadsheet_dashboard_hr_rfid_site_manager/data/files/access_control_site_dashboard.json"/>
    </record>

    <record id="spreadsheet_dashboard_hr_rfid.spreadsheet_dashboard_security_devices"
            model="spreadsheet.dashboard">
        <field name="spreadsheet_binary_data" type="base64"
               file="spreadsheet_dashboard_hr_rfid_site_manager/data/files/security_devices_site_dashboard.json"/>
    </record>

</odoo>
