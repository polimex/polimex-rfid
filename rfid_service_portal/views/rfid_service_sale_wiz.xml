<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_wiz_form_inherit" model="ir.ui.view">
            <field name="name">Sale RFID Service</field>
            <field name="model">rfid.service.sale.wiz</field>
            <field name="inherit_id" ref="rfid_service_base.sale_wiz_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='email_card']" position="after">
                    <button name="share_card" type="object"
                            string="Share" icon="fa-share-alt" data-hotkey="s"
                            invisible="not generate_barcode_card or (not email and not mobile)"/>
                </xpath>
                <xpath expr="//field[@name='email']" position="replace">
                    <div class="oe_inline">
                        <label for="email" class="oe_edit_only" />
                        <field name="email" class="oe_inline"/>
                        <label for="invite_in_portal" invisible="not email" class="oe_edit_only" />
                        <field name="invite_in_portal"
                               nolabel="1"
                               class="oe_inline"
                               invisible="not email"/>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>