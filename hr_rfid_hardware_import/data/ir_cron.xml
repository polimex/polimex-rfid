<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Active from the start and on a long interval: a survey wakes the
             worker up itself the moment it has work. A scheduled job left
             inactive never runs, not even when triggered. -->
        <record id="ir_cron_hw_import_run" model="ir.cron">
            <field name="name">RFID: continue hardware surveys</field>
            <field name="model_id" ref="model_hr_rfid_hw_import_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
