        </record>
        <record id="hw_import_group_comp_rule" model="ir.rule">
            <field name="name">Hardware survey groups: own company</field>
            <field name="model_id" ref="model_hr_rfid_hw_import_group"/>
            <field name="domain_force">[('run_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="hw_import_group_right_comp_rule" model="ir.rule">
            <field name="name">Hardware survey rights: own company</field>
            <field name="model_id" ref="model_hr_rfid_hw_import_group_right"/>
            <field name="domain_force">[('run_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="hw_import_person_comp_rule" model="ir.rule">
            <field name="name">Hardware survey people: own company</field>
            <field name="model_id" ref="model_hr_rfid_hw_import_person"/>
            <field name="domain_force">[('run_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="hw_import_name_comp_rule" model="ir.rule">
            <field name="name">Hardware survey names: own company</field>
            <field name="model_id" ref="model_hr_rfid_hw_import_name"/>
            <field name="domain_force">[('run_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="hw_import_issue_comp_rule" model="ir.rule">
