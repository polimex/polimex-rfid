        </record>
        <record id="hw_import_cmd_log_comp_rule" model="ir.rule">
            <field name="name">Hardware survey command log: own company</field>
            <field name="model_id" ref="model_hr_rfid_hw_import_cmd_log"/>
            <field name="domain_force">[('run_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
