#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/hw_import_group.py:0
msgid " + alarm"
msgstr " + аларма"

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid " and the rights that use it are left out"
msgstr " а правата, които я използват, се пропускат"

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/wizards/hw_import_group_merge_wiz.py:0
msgid "%(cards)s cards of '%(group)s' will also open: %(doors)s"
msgstr "%(cards)s карти от „%(group)s“ ще отварят също: %(doors)s"

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/hw_import_run.py:0
msgid "%(cards)s cards, %(doors)s doors"
msgstr "%(cards)s карти, %(doors)s врати"

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s announced %(count)s cards but returned nothing from position "
"%(pos)s; its card table is incomplete. Read it again."
msgstr ""
"%(ctrl)s съобщава за %(count)s карти, но не върна нищо от позиция %(pos)s; "
"таблицата с карти е непълна. Прочетете го отново."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s announced %(count)s cards; %(read)s card records were found in its "
"table."
msgstr ""
"%(ctrl)s съобщава за %(count)s карти; в таблицата му бяха намерени %(read)s "
"записа за карти."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s answered the read of its %(setting)s with a reply this system could"
" not interpret (%(why)s); the raw reply is kept but that setting is not "
"imported."
msgstr ""
"%(ctrl)s отговори на четенето на своя %(setting)s с отговор, който тази "
"система не можа да разтълкува (%(why)s); суровият отговор се пази, но тази "
"настройка не е импортирана."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid ""
"%(ctrl)s could not be created: a controller with its serial number is "
"registered on another module of this system."
msgstr ""
"%(ctrl)s не можа да бъде създаден: контролер с неговия сериен номер вече е "
"регистриран в друг модул на тази система."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s did not return row %(row)s of its input/output table; the rows read"
" before it are kept but the table is not imported."
msgstr ""
"%(ctrl)s не върна ред %(row)s от таблицата за входове/изходи; прочетените "
"преди него редове са запазени, но таблицата не е импортирана."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/analyser.py:0
msgid ""
"%(ctrl)s does not support reading its %(settings)s; those settings are not "
"part of the survey."
msgstr ""
"%(ctrl)s не поддържа четене на своите %(settings)s; тези настройки не са "
"част от проучването."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/hw_import_group.py:0
msgid "%(ctrl)s door %(door)s"
msgstr "%(ctrl)s врата %(door)s"

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s holds a card record at position %(pos)s whose number is not "
"readable; it is left out."
msgstr ""
"%(ctrl)s съдържа запис за карта на позиция %(pos)s, чийто номер не може да "
"бъде прочетен; той е изключен."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid ""
"%(ctrl)s holds a different schedule in slot %(n)s (%(summary)s); the chosen "
"schedule will be written to it the first time a right using that slot is "
"granted here."
msgstr ""
"%(ctrl)s съдържа различен график в слот %(n)s (%(summary)s); избраният "
"график ще бъде записан в него при първото предоставяне на право, използващо "
"този слот."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s holds card %(number)s twice, with different rights; the later "
"record (position %(pos)s) is used."
msgstr ""
"%(ctrl)s съдържа карта %(number)s два пъти, с различни права; използва се "
"по-късният запис (позиция %(pos)s)."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s is a vending machine controller and is left out of the survey."
msgstr "%(ctrl)s е контролер за вендинг автомат и е изключен от проучването."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s refused the request for its %(setting)s; that setting is not part "
"of the survey."
msgstr ""
"%(ctrl)s отказа заявката за своята настройка %(setting)s; тази настройка не "
"е част от проучването."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s reports %(count)s cards but can hold at most %(max)s; only the "
"first %(max)s are read."
msgstr ""
"%(ctrl)s съобщава за %(count)s карти, но може да съхранява най-много "
"%(max)s; прочетени са само първите %(max)s."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid ""
"%(ctrl)s reports hardware type %(hw)s, which this system does not know; it "
"was not imported."
msgstr ""
"%(ctrl)s съобщава за тип хардуер %(hw)s, който тази система не разпознава; "
"не беше импортиран."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s reports hardware type %(hw)s, which this system does not know; only"
" its system information was read and it cannot be imported."
msgstr ""
"%(ctrl)s съобщава за тип хардуер %(hw)s, който тази система не разпознава; "
"беше прочетена само системната му информация и не може да бъде импортиран."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s reports mode %(f5)s in one reply and %(f0)s in another; the system "
"information reply is used."
msgstr ""
"%(ctrl)s съобщава режим %(f5)s в един отговор и %(f0)s в друг; използва се "
"отговорът със системна информация."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid ""
"%(ctrl)s reports operating mode %(mode)s, which this system does not accept;"
" it was not imported."
msgstr ""
"%(ctrl)s съобщава за режим на работа %(mode)s, който тази система не приема;"
" не беше импортиран."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s returned an input/output table of an unexpected size; it is kept as"
" evidence but not imported."
msgstr ""
"%(ctrl)s върна таблица за входове/изходи с неочакван размер; тя се запазва "
"като доказателство, но не се импортира."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/reader.py:0
msgid ""
"%(ctrl)s returned an unreadable schedule in slot %(slot)s; the raw reply is "
"in the command log."
msgstr ""
"%(ctrl)s върна нечетим график в слот %(slot)s; суровият отговор е в лога на "
"командите."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid "%(ctrl)s was created with %(doors)s doors and %(readers)s readers."
msgstr "%(ctrl)s беше създаден с %(doors)s врати и %(readers)s четеца."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid ""
"%(ctrl)s was created with its settings only; its doors and readers could not"
" be derived from the mode it reports."
msgstr ""
"%(ctrl)s беше създаден само с настройките си; вратите и четците му не можаха"
" да бъдат изведени от съобщения режим."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid "%(ctrl)s was left out (already registered)."
msgstr "%(ctrl)s беше изключен (вече е регистриран)."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid "%(ctrl)s was left out (registered elsewhere in this database)."
msgstr "%(ctrl)s беше пропуснат (регистриран другаде в тази база данни)."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid ""
"%(ctrl)s: output %(output)s follows schedule %(n)s, which this company does "
"not have; that output schedule was not imported."
msgstr ""
"%(ctrl)s: изход %(output)s следва график %(n)s, който тази фирма няма; този "
"график за изход не беше импортиран."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid "%(ctrl)s: the existing controller record is used."
msgstr "%(ctrl)s: използва се съществуващият запис за контролера."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid ""
"%(ctrl)s: the input masks could not be interpreted and were not imported."
msgstr ""
"%(ctrl)s: маските на входовете не можаха да бъдат разтълкувани и не бяха "
"импортирани."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid "%(employees)s employees and %(contacts)s contacts are in place."
msgstr "%(employees)s служители и %(contacts)s контакта са налице."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid "%(groups)s access groups and %(memberships)s memberships are in place."
msgstr "%(groups)s групи за достъп и %(memberships)s членства са налице."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/wizards/hw_import_names_wiz.py:0
msgid ""
"%(matched)s lines matched a card, %(unmatched)s named a card no controller "
"holds, %(duplicate)s repeated a number, %(invalid)s could not be read. "
"%(merged)s names appear on more than one line and were merged into one "
"person each - check them in the People tab."
msgstr ""
"%(matched)s реда съвпаднаха с карта, %(unmatched)s посочиха карта, която "
"никой контролер не съдържа, %(duplicate)s повториха номер, %(invalid)s не "
"можаха да бъдат прочетени. %(merged)s имена се появяват на повече от един "
"ред и бяха обединени в едно лице всяко - проверете ги в раздела „Хора“."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/hw_import_ctrl.py:0
msgid "%(model)s SN:%(serial)s ID:%(address)s"
msgstr "%(model)s SN:%(serial)s ID:%(address)s"

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid "%(n)s cards were created."
msgstr "%(n)s карти бяха създадени."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid ""
"%(n)s employees had no department and were put in %(department)s so that "
"they can hold access groups."
msgstr ""
"%(n)s служители нямаха отдел и бяха поставени в %(department)s, за да могат "
"да имат групи за достъп."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/hw_import_run.py:0
msgid "%(n)s modules now report to this server."
msgstr "Вече %(n)s модула се отчитат пред този сървър."

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/hw_import_run.py:0
msgid ""
"%(n)s modules were pointed to this server; these were not: %(failures)s"
msgstr ""
"%(n)s модула бяха насочени към този сървър; следните не бяха: %(failures)s"

#. module: hr_rfid_hardware_import
#. odoo-python
#: code:addons/hr_rfid_hardware_import/models/importer.py:0
msgid ""
"%(name)s has no department, so the membership in %(group)s is left out."
msgstr "%(name)s няма отдел, затова членството в %(group)s е пропуснато."

#. module: hr_rfid_hardware_import
#: model_terms:ir.ui.view,arch_db:hr_rfid_hardware_import.hw_import_names_wiz_form
msgid ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                        Tip: uploading a file again starts the names step over; splits made by hand are lost."
msgstr ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                        Съвет: повторното качване на файл започва стъпката с имената отначало; ръчно направените разделяния се губят."

#. module: hr_rfid_hardware_import
#: model:ir.model.fields,help:hr_rfid_hardware_import.field_hr_rfid_hw_import_names_wiz__file
msgid "A CSV or Excel file with two columns: the name and the card number."
msgstr "CSV или Excel файл с две колони: името и номера на картата."

#. module: hr_rfid_hardware_import
#: model_terms:ir.ui.view,arch_db:hr_rfid_hardware_import.hw_import_names_wiz_form
msgid ""
"A CSV or Excel file with two columns: the person's name and the card number.\n"
"                        Cards are matched by number only. The same name on several lines becomes one\n"
"                        person with several cards - those people are marked for review."
msgstr ""
"CSV или Excel файл с две колони: името на лицето и номера на картата.\n"
"                        Картите се съпоставят само по номер. Едно и също име на няколко реда се превръща в едно\n"
"                        лице с няколко карти - тези лица се маркират за преглед."

#. module: hr_rfid_hardware_import
#: model:ir.model.fields,help:hr_rfid_hardware_import.field_hr_rfid_hw_import_issue__resolved
msgid "A blocker counts as resolved once a decision is recorded."
msgstr "Блокиращ проблем се счита за разрешен, щом бъде записано решение."

#. module: hr_rfid_hardware_import
#: model:ir.model.fields,help:hr_rfid_hardware_import.field_hr_rfid_hw_import_card__existing_card_id
