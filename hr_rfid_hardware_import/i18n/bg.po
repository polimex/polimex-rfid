#. module: hr_rfid_hardware_import
#: model:ir.model.fields,help:hr_rfid_hardware_import.field_hr_rfid_hw_import_ctrl__existing_ctrl_id
msgid "A controller with this serial that already exists here."
msgstr "Контролер с този сериен номер, който вече съществува тук."

#. module: hr_rfid_hardware_import
#: model:ir.model.constraint,message:hr_rfid_hardware_import.constraint_hr_rfid_hw_import_ctrl_address_uniq
msgid "A module cannot have two controllers at the same address."
msgstr "Един модул не може да има два контролера на един и същ адрес."

#. module: hr_rfid_hardware_import
#: model:ir.model.fields,help:hr_rfid_hardware_import.field_hr_rfid_hw_import_run__has_read_failures
msgid "A module or controller could not be read; it can be read again."
msgstr ""
"Модул или контролер не можа да бъде прочетен; може да бъде прочетен отново."

#. module: hr_rfid_hardware_import
#: model:ir.model.constraint,message:hr_rfid_hardware_import.constraint_hr_rfid_hw_import_card_number_uniq
msgid "A survey holds each card number once."
msgstr "Проучването съдържа всеки номер на карта веднъж."

#. module: hr_rfid_hardware_import
#: model:ir.model.constraint,message:hr_rfid_hardware_import.constraint_hr_rfid_hw_import_ts_slot_run_number_uniq
msgid "A survey holds each schedule slot once."
msgstr "Проучването съдържа всеки слот за график веднъж."

#. module: hr_rfid_hardware_import
#: model_terms:ir.actions.act_window,help:hr_rfid_hardware_import.hw_import_run_action
msgid ""
"A survey reads a working access control system - the modules, the controllers,\n"
"                    every card and the doors it opens - without changing anything on the devices.\n"
"                    You then name the card holders from a file, review the access groups the survey\n"
"                    proposes, and import it all into this system."
msgstr ""
"Проучването сканира работеща система за контрол на достъпа - модулите, контролерите,\n"
"                    всяка карта и вратите, които тя отваря - без да променя нищо по устройствата.\n"
"                    След това вие именувате притежателите на картите от файл, преглеждате групите за достъп,\n"
"                    които проучването предлага, и импортирате всичко в тази система."

#. module: hr_rfid_hardware_import
#: model:ir.model.fields.selection,name:hr_rfid_hardware_import.selection__hr_rfid_hw_import_ctrl__family__access
msgid "Access control"
msgstr "Контрол на достъпа"

