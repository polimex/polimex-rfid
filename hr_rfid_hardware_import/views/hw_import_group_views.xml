<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hw_import_group_list" model="ir.ui.view">
            <field name="name">hr.rfid.hw.import.group.list</field>
            <field name="model">hr.rfid.hw.import.group</field>
            <field name="arch" type="xml">
                <list string="Proposed access groups" editable="bottom" create="0"
                      decoration-muted="not include">
                    <field name="include" width="40px"/>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="card_count" readonly="1"/>
                    <field name="door_count" readonly="1"/>
                    <field name="right_ids" widget="many2many_tags" readonly="1" optional="show"/>
                    <field name="access_group_id" readonly="1" optional="show"/>
                    <field name="merged_from_json" readonly="1" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="hw_import_group_form" model="ir.ui.view">
            <field name="name">hr.rfid.hw.import.group.form</field>
            <field name="model">hr.rfid.hw.import.group</field>
            <field name="arch" type="xml">
                <form string="Proposed access group">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Group">
                                <field name="include"/>
                                <field name="card_count" readonly="1"/>
                                <field name="door_count" readonly="1"/>
                                <field name="access_group_id" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Rights" name="rights">
                                <p class="text-muted">The doors every card of this group opens.</p>
                                <field name="right_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="ctrl_id"/>
                                        <field name="door_number"/>
                                        <field name="ts_number"/>
                                        <field name="alarm"/>
                                        <field name="door_rec_id" optional="show"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Cards" name="cards">
                                <p class="text-muted">The cards that hold every right of this group.</p>
                                <field name="card_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="number_display"/>
                                        <field name="person_id"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hw_import_group_right_list" model="ir.ui.view">
            <field name="name">hr.rfid.hw.import.group.right.list</field>
            <field name="model">hr.rfid.hw.import.group.right</field>
            <field name="arch" type="xml">
                <list string="Rights" create="0">
                    <field name="group_id"/>
                    <field name="door_label"/>
                    <field name="door_rec_id" optional="show"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
