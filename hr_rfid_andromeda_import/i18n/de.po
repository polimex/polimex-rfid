msgid "Middle / second name from the Andromeda DB."
msgstr "Zweiter Vorname aus der Andromeda-Datenbank."

#. module: hr_rfid_andromeda_import
#: model:ir.model.fields,help:hr_rfid_andromeda_import.field_hr_rfid_andromeda_import_wiz__users_count
#: model:ir.model.fields,help:hr_rfid_andromeda_import.field_hr_rfid_andromeda_welcome_wiz__users_count
msgid ""
"Number of users discovered in the Andromeda DB after Test Connection — "
"informational, used to size the import."
msgstr ""
"Anzahl der nach dem Verbindungstest in der Andromeda-Datenbank gefundenen "
"Benutzer - informativ, dient zur Einschätzung des Importumfangs."

#. module: hr_rfid_andromeda_import
#: model:ir.model.fields,help:hr_rfid_andromeda_import.field_hr_rfid_andromeda_import_users__c_id
msgid ""
"Numeric company ID from Andromeda. Translated to a local res.company via "
"company_dict."
msgstr ""
"Numerische Firmen-ID aus Andromeda. Wird über company_dict einer lokalen res."
"company zugeordnet."

#. module: hr_rfid_andromeda_import
#: model:ir.model.fields,help:hr_rfid_andromeda_import.field_hr_rfid_andromeda_import_users__d_id
msgid ""
"Numeric department ID from Andromeda. Translated to a local hr.department "
"through the welcome-wizard mapping."
msgstr ""
"Numerische Abteilungs-ID aus Andromeda. Wird über die Zuordnung im "
"Willkommens-Assistenten einer lokalen hr.department zugeordnet."

#. module: hr_rfid_andromeda_import
#: model_terms:ir.ui.view,arch_db:hr_rfid_andromeda_import.andromeda_import_wizard_form
msgid "Operations"
msgstr "Vorgänge"

#. module: hr_rfid_andromeda_import
#: model:ir.model.fields,help:hr_rfid_andromeda_import.field_hr_rfid_andromeda_import_users__import_id
msgid ""
"Parent import-run wizard this user row belongs to. Set automatically when "
"the wizard fetches the user list."
msgstr ""
"Übergeordneter Import-Assistent, zu dem diese Benutzerzeile gehört. Wird "
"automatisch gesetzt, wenn der Assistent die Benutzerliste abruft."

#. module: hr_rfid_andromeda_import
#: model:ir.model.fields,field_description:hr_rfid_andromeda_import.field_hr_rfid_andromeda_import_users__u_sname
msgid "Second Name"
msgstr "Zweiter Vorname"

#. module: hr_rfid_andromeda_import
#: model:ir.model.fields,field_description:hr_rfid_andromeda_import.field_hr_rfid_andromeda_import_wiz__select_all
msgid "Select All"
msgstr "Alle auswählen"

#. module: hr_rfid_andromeda_import
#: model:ir.model.fields,help:hr_rfid_andromeda_import.field_hr_rfid_andromeda_import_users__do_import
msgid ""
"Select whether to import this specific user.\n"
"        \n"
"        • When enabled: User will be included in the import process\n"
"        • When disabled: User will be skipped during import\n"
"        • Bulk control: Use 'Select All' to toggle all users at once\n"
"        \n"
"        Note: Only selected users will be imported from the Andromeda "
"database."
msgstr ""
"Wählen Sie, ob dieser Benutzer importiert werden soll.\n"
"        \n"
"        • Aktiviert: Der Benutzer wird in den Importvorgang einbezogen\n"
"        • Deaktiviert: Der Benutzer wird beim Import übersprungen\n"
"        • Massenauswahl: Verwenden Sie 'Alle auswählen', um alle Benutzer "
"auf einmal umzuschalten\n"
"        \n"
"        Hinweis: Es werden nur ausgewählte Benutzer aus der Andromeda-"
"Datenbank importiert."

#. module: hr_rfid_andromeda_import
#: model_terms:ir.ui.view,arch_db:hr_rfid_andromeda_import.andromeda_import_wizard_form
msgid "Start Full Import"
msgstr "Vollständigen Import starten"

