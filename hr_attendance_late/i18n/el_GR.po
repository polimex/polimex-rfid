#. module: hr_attendance_late
#: model_terms:ir.ui.view,arch_db:hr_attendance_late.hr_legal_rate_view_form
msgid ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Tip: when the law changes, add a NEW row with "
"the new\n"
"                            Valid From date — do not edit the old one. Past "
"worked\n"
"                            days keep their historical coefficient, and the "
"new\n"
"                            value applies only from its effective date "
"onward.\n"
"                            Leave Company empty for a national rate that "
"applies\n"
"                            everywhere."
msgstr ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Συμβουλή: όταν αλλάζει ο νόμος, προσθέστε μια "
"ΝΕΑ γραμμή με τη νέα\n"
"                            ημερομηνία Ισχύει Από - μην επεξεργάζεστε την "
"παλιά. Οι παρελθούσες\n"
"                            εργάσιμες ημέρες διατηρούν τον ιστορικό τους "
"συντελεστή, και η νέα\n"
"                            τιμή ισχύει μόνο από την ημερομηνία ισχύος και "
"εφεξής.\n"
"                            Αφήστε την Εταιρεία κενή για εθνικό συντελεστή "
"που ισχύει\n"
"                            παντού."

