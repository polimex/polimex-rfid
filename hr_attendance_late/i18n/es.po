#. module: hr_attendance_late
#: model_terms:ir.ui.view,arch_db:hr_attendance_late.hr_legal_rate_view_form
msgid ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Tip: when the law changes, add a NEW row with "
"the new\n"
"                            Valid From date — do not edit the old one. Past "
"worked\n"
"                            days keep their historical coefficient, and the "
"new\n"
"                            value applies only from its effective date "
"onward.\n"
"                            Leave Company empty for a national rate that "
"applies\n"
"                            everywhere."
msgstr ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Consejo: cuando cambie la ley, añada una NUEVA "
"fila con la nueva\n"
"                            fecha de Válido Desde - no edite la anterior. "
"Los días\n"
"                            trabajados en el pasado conservan su coeficiente "
"histórico, y el\n"
"                            nuevo valor se aplica solo a partir de su fecha "
"de vigencia.\n"
"                            Deje Compañía vacío para una tarifa nacional que "
"se aplica\n"
"                            en todas partes."

