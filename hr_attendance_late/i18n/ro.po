#. module: hr_attendance_late
#: model_terms:ir.ui.view,arch_db:hr_attendance_late.hr_legal_rate_view_form
msgid ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Tip: when the law changes, add a NEW row with the new\n"
"                            Valid From date — do not edit the old one. Past worked\n"
"                            days keep their historical coefficient, and the new\n"
"                            value applies only from its effective date onward.\n"
"                            Leave Company empty for a national rate that applies\n"
"                            everywhere."
msgstr ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Съвет: когато законът се промени, добавете НОВ ред с новата\n"
"                            дата Валидно от — не редактирайте стария. Минали отработени\n"
"                            дни запазват историческия си коефициент, а новата\n"
"                            стойност се прилага само от датата на влизане в сила нататък.\n"
"                            Оставете Фирма празно за национална ставка, приложима\n"
"                            навсякъде."

