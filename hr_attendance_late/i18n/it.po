#. module: hr_attendance_late
#: model_terms:ir.ui.view,arch_db:hr_attendance_late.hr_legal_rate_view_form
msgid ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Tip: when the law changes, add a NEW row with "
"the new\n"
"                            Valid From date — do not edit the old one. Past "
"worked\n"
"                            days keep their historical coefficient, and the "
"new\n"
"                            value applies only from its effective date "
"onward.\n"
"                            Leave Company empty for a national rate that "
"applies\n"
"                            everywhere."
msgstr ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Suggerimento: quando la legge cambia, aggiungere "
"una NUOVA riga con la nuova\n"
"                            data di decorrenza - non modificare quella "
"precedente. I giorni lavorati\n"
"                            in passato mantengono il loro coefficiente "
"storico, e il nuovo\n"
"                            valore si applica solo a partire dalla sua data "
"di decorrenza.\n"
"                            Lasciare Azienda vuoto per una tariffa nazionale "
"valida\n"
"                            ovunque."

#. module: hr_attendance_late
#: model:ir.model.constraint,message:hr_attendance_late.constraint_hr_legal_rate_unique_global_rate
