#. module: hr_attendance_late
#: model_terms:ir.ui.view,arch_db:hr_attendance_late.hr_legal_rate_view_form
msgid ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Tip: when the law changes, add a NEW row with "
"the new\n"
"                            Valid From date — do not edit the old one. Past "
"worked\n"
"                            days keep their historical coefficient, and the "
"new\n"
"                            value applies only from its effective date "
"onward.\n"
"                            Leave Company empty for a national rate that "
"applies\n"
"                            everywhere."
msgstr ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Tipp: Wenn sich das Gesetz ändert, eine NEUE "
"Zeile mit dem neuen\n"
"                            Gültig-ab-Datum hinzufügen - die alte Zeile "
"nicht bearbeiten. Bereits\n"
"                            geleistete Arbeitstage behalten ihren "
"historischen Koeffizienten, und der\n"
"                            neue Wert gilt erst ab seinem Gültigkeitsdatum.\n"
"                            Unternehmen leer lassen für einen landesweiten "
"Satz, der überall\n"
"                            gilt."

#. module: hr_attendance_late
#: model:ir.model.constraint,message:hr_attendance_late.constraint_hr_legal_rate_unique_global_rate
msgid "A global legal rate already exists for this code and effective date."
msgstr ""
"Für diesen Code und dieses Gültigkeitsdatum existiert bereits ein globaler "
"gesetzlicher Satz."

#. module: hr_attendance_late
#: model:ir.model.constraint,message:hr_attendance_late.constraint_hr_legal_rate_unique_company_rate
msgid "A legal rate already exists for this code, effective date and company."
msgstr ""
"Für diesen Code, dieses Gültigkeitsdatum und dieses Unternehmen existiert "
"bereits ein gesetzlicher Satz."

