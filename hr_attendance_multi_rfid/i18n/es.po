#: model:ir.model.fields,help:hr_attendance_multi_rfid.field_hr_attendance_recalc_wizard__end_date
msgid ""
"Ending date for attendance recalculation. Attendance records will be "
"processed up to and including this date. Default is today."
msgstr ""
"Fecha de finalización para el recálculo de asistencia. Los registros de "
"asistencia se procesarán hasta esta fecha, inclusive. El valor "
"predeterminado es el día de hoy."

