#. module: hr_attendance_multi_rfid
#: model:ir.model.fields,field_description:hr_attendance_multi_rfid.field_hr_rfid_zone__max_time_in_zone
msgid "Maximum Hours in Zone"
msgstr "Μέγιστες ώρες στη ζώνη"

#. module: hr_attendance_multi_rfid
#: model:ir.model.fields,help:hr_attendance_multi_rfid.field_hr_rfid_zone__max_time_in_zone
msgid ""
"Maximum hours an employee can stay in the zone before attendance is "
"automatically closed. This prevents forgotten check-outs from creating "
"excessively long attendance records. Set to 0 to disable automatic closure. "
"Example: 12 hours for a standard work day."
msgstr ""
"Μέγιστες ώρες που μπορεί να παραμείνει ένας υπάλληλος στη ζώνη πριν η "
"παρουσία κλείσει αυτόματα. Αποτρέπει τη δημιουργία υπερβολικά μακρών "
"εγγραφών παρουσίας λόγω ξεχασμένων εξόδων. Ορίστε σε 0 για απενεργοποίηση "
"του αυτόματου κλεισίματος. Παράδειγμα: 12 ώρες για μια τυπική εργάσιμη "
"ημέρα."

