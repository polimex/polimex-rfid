<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="act_wizard_recompute_attendance_records" model="ir.actions.act_window">
            <field name="name">Re-create Attendance records</field>
            <field name="res_model">hr.attendance.recalc.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                Rebuild attendance records from RFID events
            </p>
                <p>
                This wizard recalculates attendance records by analyzing RFID door events 
                for the selected employees and date range.
                    <br/>
                    <br/>
                Key features:
                • Deletes auto-generated attendance records in the date range
                • Preserves manually created attendance records
                • Rebuilds attendance from RFID zone entry/exit events
                • Handles zone-specific attendance settings and overrides
                </p>
            </field>
        </record>
        <record id="view_hr_attendance_records_recompute_wizard" model="ir.ui.view">
            <field name="name">hr_attendance_recalc_wizard</field>
            <field name="model">hr.attendance.recalc.wizard</field>
            <field name="arch" type="xml">
                <form string="Select Date Range">
                    <group>
                        <field name="employee_ids" widget="many2many_tags"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <footer>
                        <button string="Re-Create" name="execute" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="recreate_attendance_records_action" model="ir.actions.act_window">
            <field name="name">Re-create Attendance records</field>
            <field name="res_model">hr.attendance.recalc.wizard</field>
            <field name="binding_model_id" ref="model_hr_employee"/>
            <field name="view_mode">form</field>
            <field name="context">{'default_employee_ids': active_ids, 'employee_ids': active_ids, }</field>
            <field name="target">new</field>
            <field name="groups_id" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                Recalculate attendance for selected employees
            </p>
                <p>
                This action allows HR managers to rebuild attendance records based on RFID events.
                    <br/>
                    <br/>
                Use cases:
                • After changing zone attendance settings
                • When attendance data appears incorrect
                • After importing historical RFID events
                • To sync attendance with actual door access events
                </p>
            </field>
        </record>
    </data>
</odoo>