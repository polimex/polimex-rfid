<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_attendance_calendar_view" model="ir.ui.view">
            <field name="name">hr.attendance.calendar</field>
            <field name="model">hr.attendance</field>
            <field name="arch" type="xml">
                <calendar string="Attendance" date_start="check_in" date_stop="check_out"
                          color="employee_id" mode="month" quick_create="0" event_open_popup="1">
                    <field name="employee_id"/>
                    <field name="check_in" readonly="1"/>
                    <field name="check_out" readonly="1"/>
                    <field name="worked_hours"/>
                </calendar>
            </field>
        </record>

        <record id="view_attendance_list_inherit" model="ir.ui.view">
            <field name="name">hr.attendance.list.rfid.attendance</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='worked_hours']" position="after">
                    <field name="in_zone_id"/>
                    <field name="forgotten_badge" optional="show"/>
                </xpath>

            </field>
        </record>

        <record id="hr_attendance_view_filter_inherit" model="ir.ui.view">
            <field name="name">hr_attendance_view_filter</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//group" position="before">
                    <filter string="With Check Out" name="withcheckout" domain="[('check_out', '!=', False)]"/>
                    <filter name="today" string="Attendance for today"
                            domain="[('check_in', '&gt;',  (context_today()-datetime.timedelta(days=1)).strftime('%%Y-%%m-%%d')),('check_in', '&lt;',  (context_today()+datetime.timedelta(days=1)).strftime('%%Y-%%m-%%d'))]"/>
                </xpath>
                <xpath expr="//filter[@name='auto_check']" position="after">
                    <filter string="Forgotten Badge" name="forgotten_badge"
                            domain="[('forgotten_badge', '=', True)]"/>
                </xpath>
                <xpath expr="//group" position="inside">
                    <filter string="Departments" name="department" context="{'group_by': 'department_id'}"/>
                </xpath>
                <xpath expr="//group" position="after">
                    <searchpanel>
                        <field name="in_zone_id" icon="fa-info-circle" color="#875A7B"/>
                        <field name="department_id" icon="fa-info-circle" color="#875A7B"/>
                    </searchpanel>
                </xpath>
            </field>
        </record>

        <record id="hr_attendance_view_form_forgotten_badge" model="ir.ui.view">
            <field name="name">hr.attendance.form.forgotten.badge</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='out_mode']" position="after">
                    <field name="forgotten_badge" invisible="not forgotten_badge"/>
                </xpath>
                <!-- A door has no browser, address or position to show: where
                     device tracking is on, a badge reads as core's manual
                     entry does, without the empty device details. -->
                <xpath expr="//field[@name='in_ip_address']" position="attributes">
                    <attribute name="invisible">in_mode in ('manual', 'rfid') or not device_tracking_enabled</attribute>
                </xpath>
                <xpath expr="//field[@name='in_browser']" position="attributes">
                    <attribute name="invisible">in_mode in ('manual', 'rfid') or not device_tracking_enabled</attribute>
                </xpath>
                <xpath expr="//field[@name='in_location']/parent::group" position="attributes">
                    <attribute name="invisible">in_mode in ('manual', 'rfid') or not device_tracking_enabled</attribute>
                </xpath>
                <xpath expr="//field[@name='out_ip_address']" position="attributes">
                    <attribute name="invisible">in_mode == 'manual' or out_mode == 'rfid' or not device_tracking_enabled</attribute>
                </xpath>
                <xpath expr="//field[@name='out_browser']" position="attributes">
                    <attribute name="invisible">in_mode == 'manual' or out_mode == 'rfid' or not device_tracking_enabled</attribute>
                </xpath>
                <xpath expr="//field[@name='out_location']/parent::group" position="attributes">
                    <attribute name="invisible">out_mode in ('manual', 'rfid') or not device_tracking_enabled</attribute>
                </xpath>
            </field>
        </record>

