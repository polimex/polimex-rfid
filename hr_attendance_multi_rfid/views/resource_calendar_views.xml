<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="resource_calendar_form_forgotten_badge" model="ir.ui.view">
        <field name="name">resource.calendar.form.inherit.hr_attendance_multi_rfid</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <!-- Beside the hours that define the schedule's day, because this
                 says what such a day is worth when nobody badged out of it.
                 Whoever may edit the schedule may set it: the schedule's own
                 access rights decide, as for every other field here. -->
            <xpath expr="//group[@name='resource_working_hours']" position="inside">
                <label for="forgotten_badge_hours"/>
                <div class="d-flex">
                    <field name="forgotten_badge_hours" nolabel="1" widget="float_time"
                           style="width: 6ch;"/>
                    <span class="ms-2 text-muted">0 = the working day of the schedule</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
