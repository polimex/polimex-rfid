<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Active from the start and on a long interval: a rebuild wakes this
             up itself the moment it is asked for. A scheduled task left
             inactive is never run, not even when triggered - the readiness
             check requires active to be true - and it would fail silently.

             Priority is deliberately below the auto-close task next to it
             (5, every minute): a rebuild that runs for a long time must never
             hold up the job that closes people's open attendance. -->
        <record id="hr_attendance_multi_rfid_recalc_cron" model="ir.cron">
            <field name="name">HR RFID Multi Attendance: Continue attendance rebuilds</field>
            <field name="model_id" ref="model_hr_attendance_recalc_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">20</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
