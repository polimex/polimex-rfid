<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron job for HR Attendance Multi RFID module
         Automatically closes incomplete attendance records based on zone configuration.

         Odoo 19 cron features used:
         - noupdate="1" allows users to customize the interval
         - priority field controls execution order (lower = higher priority)
         - state defaults to 'code' (omitted for cleaner XML)
    -->
    <data noupdate="1">

        <!-- Auto-close incomplete attendances. Every 30 minutes: the limits
             being enforced are measured in hours, so a minute-level sweep
             only burned scheduler time. noupdate="1" means databases
             installed before this change keep whatever interval they have;
             operators can also tune it themselves. -->
        <record id="hr_attendance_multi_rfid_autoclose_cron" model="ir.cron">
            <field name="name">HR RFID Multi Attendance: Auto-close incomplete attendances</field>
            <field name="model_id" ref="model_hr_attendance"/>
            <field name="code">model.check_for_incomplete_attendances()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="priority">5</field>
        </record>

    </data>
</odoo>