<?xml version='1.0' encoding='UTF-8' ?>
<odoo>

    <record id="f76_edit_holiday_status_form" model="ir.ui.view">
        <field name="name">hr.leave.type.form.76</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='visual']" position="before">
                <group name="leave_description_form_76" id="f76" string="Form 76 Description">
                    <field name="form76_code"/>
                    <field name="form76_law_reason"/>
                    <field name="form76_description"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="f76_view_holiday_status_normal_tree" model="ir.ui.view">
        <field name="name">hr.leave.type.normal.list.76</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holiday_status_normal_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='leave_validation_type']" position="after">
                <field name="form76_code" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
