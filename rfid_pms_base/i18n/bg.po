#. module: rfid_pms_base
#: model_terms:ir.ui.view,arch_db:rfid_pms_base.rfid_pms_base_room_kanban
msgid "<i class=\"fa fa-home\" role=\"img\" aria-label=\"Enterprise\" title=\"Enterprise\"/>"
msgstr "<i class=\"fa fa-home\" role=\"img\" aria-label=\"Enterprise\" title=\"Enterprise\"/>"

#. module: rfid_pms_base
#: model_terms:ir.ui.view,arch_db:rfid_pms_base.rfid_pms_base_room_form
msgid ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Tip: rooms sharing the same Group value cluster together in the Hotel Rooms kanban. Use it to split the kanban by floor or wing (e.g. \"Floor 3\" / \"Suites\" / \"Annex\")."
msgstr ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Съвет: стаите, споделящи една и съща стойност на групата, се обединяват в изгледа тип kanban на хотелските стаи. Използвайте това, за да разделите изгледа по етаж или крило (напр. „Етаж 3“ / „Апартаменти“ / „Пристройка“)."

