<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_rfid_card_view_list_base_pms_inherit" model="ir.ui.view">
            <field name="name">hr_rfid_card_view_list_base_pms_inherit</field>
            <field name="model">hr.rfid.card</field>
            <field name="inherit_id" ref="hr_rfid.hr_rfid_card_view_list"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='card_type']" position="replace">
                    <field name="door_ids" widget="many2many_tags"/>
                </xpath>

            </field>
        </record>

         <!--Inherited Card view for search only-->
        <record id="pms_base_card_action" model="ir.actions.act_window">
            <field name="name">Cards</field>
            <field name="res_model">hr.rfid.card</field>
            <field name="view_mode">list,search</field>
            <field name="context">{"search_default_showall": 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No cards have been issued yet</p>
                <p>
                    Cards appear here automatically when receptionists open a reservation from the Hotel Rooms kanban. Manager-only view — use it to audit which cards are in circulation and which doors each card can open.
                </p>
            </field>
        </record>


    </data>
</odoo>