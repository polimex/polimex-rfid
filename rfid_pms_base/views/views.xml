<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.actions.act_window" id="rfid_pms_base.action_window_hr">
            <field name="name">Hotel Employees</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No hotel employees yet</p>
                <p>
                    Standard HR employees who have cards in the hotel. Their cards typically belong to a staff access group with broader rights than guest cards.
                </p>
            </field>
        </record>

        <record model="ir.actions.act_window" id="rfid_pms_base.action_window_partner">
            <field name="name">Hotel Guests</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No guests on file yet</p>
                <p>
                    Guest contacts created from the New / Add buttons on the Hotel Rooms kanban. Each reservation becomes a parent partner (e.g. R002615) with one child contact per issued guest card.
                </p>
            </field>
        </record>
    </data>
</odoo>
