<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="rfid_pms_base_room_form" model="ir.ui.view">
            <field name="name">rfid_pms_base_room_view_form</field>
            <field name="model">rfid_pms_base.room</field>
            <field name="arch" type="xml">
                <form string="rfid_pms_base_room_form">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Friendly Room name "/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="number"/>
                                <field name="door_id"/>
                            </group>
                            <group>
                                <field name="access_group_id"/>
                                <field name="group"/>
                            </group>
                        </group>
                        <p class="text-muted">
                            <i class="fa fa-lightbulb-o" role="img"/>
                            Tip: rooms sharing the same Group value cluster together in the Hotel Rooms kanban. Use it to split the kanban by floor or wing (e.g. "Floor 3" / "Suites" / "Annex").
                        </p>
                        <group>
                            <field name="all_contact_ids">
                                <list create="0" delete="0" edit="0">
                                    <field name="contact_id"/>
                                    <field name="expiration"/>
                                </list>
                            </field>
                        </group>
                        <group>
                            <field name="all_employee_ids">
                                <list create="0" delete="0" edit="0">
                                    <field name="employee_id"/>
                                    <field name="expiration"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="rfid_pms_base_room_list" model="ir.ui.view">
            <field name="name">Schneider Room list</field>
            <field name="model">rfid_pms_base.room</field>
            <field name="arch" type="xml">
                <list sample="1" import="False">
                    <field name="name"/>
                    <field name="number"/>
                    <field name="hb_card_present"/>
                    <field name="hb_dnd"/>
                    <field name="hb_clean"/>
                </list>
            </field>
        </record>

        <record id="rfid_pms_base_room_kanban" model="ir.ui.view">
            <field name="name">rfid_pms_base_room_view_kanban</field>
            <field name="model">rfid_pms_base.room</field>
            <field name="arch" type="xml">
                <kanban sample="1" default_group_by="group"
                        js_class="onboarding_kanban"
                        records_draggable="false"
                        group_create="true"
                        quick_create="false">
                    <field name="name"/>
                    <field name="number"/>
                    <templates>
                        <t t-name="card">
                            <field name="last_occupancy" invisible="1"/>
                            <field name="hb_dnd" invisible="1"/>
                            <field name="hb_clean" invisible="1"/>
                            <field name="hb_card_present" invisible="1"/>
                            <div class="d-flex align-items-center mb-2">
                                <img alt="Guests present" src="/rfid_pms_base/static/icons/guests.png"
                                     class="me-2" style="height: 24px;"
                                     invisible="not hb_card_present"
                                     title="Guests present"/>
                                <img alt="No guests" src="/rfid_pms_base/static/icons/guests_off.png"
                                     class="me-2" style="height: 24px;"
                                     invisible="hb_card_present"
                                     title="No Guests present"/>
                                <i class="fa fa-home me-2" role="img" aria-label="Enterprise" title="Enterprise"/>
                                <strong>
                                    <field name="name"/>
                                    (<field name="number"/>)
                                </strong>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-4">
                                    <button type="action"
                                            name="%(cards_program_wiz_action)d"
                                            context="{'new': True}"
                                            icon="fa-plus"
                                            class="btn btn-primary w-100"
                                            title="Add new Reservation and issue a Guest card">
                                        <span>New</span>
                                    </button>
                                </div>
                                <div class="col-4 text-center">
                                    <button type="object" name="toggle_hotel"
                                            context="{'btn': 'dnd'}"
                                            class="btn btn-link p-0">
                                        <img alt="DND" src="/rfid_pms_base/static/icons/dnd.png"
                                             class="mx-1" style="height: 24px;"
                                             invisible="not hb_dnd"
                                             title="Do not disturb"/>
                                        <img alt="DND off" src="/rfid_pms_base/static/icons/dnd_off.png"
                                             class="mx-1" style="height: 24px;"
                                             invisible="hb_dnd"
                                             title="DND off"/>
                                    </button>
                                    <button type="object" name="toggle_hotel"
                                            context="{'btn': 'clean'}"
                                            class="btn btn-link p-0">
                                        <img alt="Clean" src="/rfid_pms_base/static/icons/clean.png"
                                             class="mx-1" style="height: 24px;"
                                             invisible="not hb_clean"
                                             title="Please Clean"/>
                                        <img alt="Clean off" src="/rfid_pms_base/static/icons/clean_off.png"
                                             class="mx-1" style="height: 24px;"
                                             invisible="hb_clean"
                                             title="Clean off"/>
                                    </button>
                                </div>
                                <div class="col-4" t-if="record.reservation.value">
                                    <button type="action"
                                            name="%(cards_program_wiz_action)d"
                                            context="{'current': True}"
                                            icon="fa-address-card"
                                            class="btn btn-secondary w-100"
                                            title="Add more cards to current reservation">
                                        <span>Add</span>
                                    </button>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <button type="object"
                                            name="user_events_act"
                                            class="btn btn-secondary w-100">
                                        <span>Events</span>
                                    </button>
                                </div>
                                <div t-if="record.reservation.value" class="col-6 text-end">
                                    <strong><field name="reservation"/></strong>
                                </div>
                            </div>
                            <div class="row g-2 mt-1">
                                <div class="col-7">
                                    <field name="last_insert_name"
                                           invisible="not hb_card_present"
                                           title="Current inserted card"/>
                                </div>
                                <div class="col-5 text-end" t-if="record.reservation.value">
                                    <button type="action"
                                            name="%(rfid_pms_base.room_move_wiz_action)d"
                                            class="btn btn-secondary"
                                            icon="fa-arrow-right">
                                        <span>Move</span>
                                    </button>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="rfid_pms_base_room_search" model="ir.ui.view">
            <field name="name">rfid_pms_base_room_search</field>
            <field name="model">rfid_pms_base.room</field>
            <field name="arch" type="xml">
                <search string="Rooms">
                    <field name="name" string="Room Name"
                           filter_domain="['|', ('name', 'ilike', self), ('number', 'ilike', self)]"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_window_room">
            <field name="name">Hotel Rooms</field>
            <field name="res_model">rfid_pms_base.room</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'onboarding_route_name': 'rfid_pms_base_setup'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Register your first hotel room</p>
                <p>
                    Rooms tie a guest access group to the controller door that locks the room. Once you have at least one room here, this kanban becomes the receptionist's daily working surface — issue new reservations, toggle DND / Clean, and move occupants between rooms.
                </p>
                <p>
                    <strong>Prerequisite:</strong> create a guest access group with doors first (Configuration → Access Groups in the RFID app).
                </p>
            </field>
        </record>

    </data>
</odoo>