<odoo>
    <data>
        <!-- Наследяване на формовия изглед на hr.rfid.event.user -->
        <record id="hr_rfid_sys_ev_view_form_anpr_ext" model="ir.ui.view">
            <field name="name">hr.rfid.sys.ev.view.form.anpr.ext</field>
            <field name="model">hr.rfid.event.system</field>
            <field name="inherit_id" ref="hr_rfid.hr_rfid_sys_ev_view_form"/>
            <field name="arch" type="xml">
                <!-- Например, след групата "Where" добавяме нова група за ANPR данни -->
                <xpath expr="//field[@name='webstack_id']" position="after">
                        <field name="camera_id" invisibe="controller_id"/>
                        <field name="license_plate" invisibe="controller_id"/>
                        <field name="anpr_confidence" invisibe="controller_id"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="after">
                     <div class="oe_avatar" invisible="not camera_id">
                        <field name="snapshot" widget="image"
                               options="{'zoom': true, 'preview_image': 'snapshot', 'size': [80, 80]}" class="bg-view"/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='controller_id']" position="attributes">
                    <attribute name="invisible">not controller_id</attribute>
                </xpath>
                <xpath expr="//field[@name='webstack_id']" position="attributes">
                    <attribute name="invisible">not controller_id</attribute>
                </xpath>
            </field>
        </record>

        <!-- Наследяване на списъчния (list) изглед за hr.rfid.event.user -->
        <record id="view_hr_rfid_user_ev_list_anpr_ext" model="ir.ui.view">
            <field name="name">hr.rfid.user.ev.list.anpr.ext</field>
            <field name="model">hr.rfid.event.user</field>
            <field name="inherit_id" ref="hr_rfid.hr_rfid_user_ev_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="camera_id" optional="hide"/>
                    <field name="license_plate" optional="hide"/>
                    <field name="anpr_confidence" optional="hide"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
