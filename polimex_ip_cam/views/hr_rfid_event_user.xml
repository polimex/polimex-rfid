<odoo>
    <data>
        <record id="view_hr_rfid_user_ev_form_anpr_ext" model="ir.ui.view">
            <field name="name">hr.rfid.user.ev.form.anpr.ext</field>
            <field name="model">hr.rfid.event.user</field>
            <field name="inherit_id" ref="hr_rfid.hr_rfid_user_ev_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='card_data']" position="inside">
                    <group string="ANPR Details" invisible="not camera_id">
                        <field name="camera_id"/>
                        <field name="license_plate"/>
                        <field name="anpr_confidence"/>
                    </group>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="after">
                     <div class="oe_avatar" invisible="not camera_id">
                        <field name="snapshot" widget="image"
                               options="{'zoom': true, 'preview_image': 'snapshot', 'size': [80, 80]}" class="bg-view"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_hr_rfid_user_ev_list_anpr_ext" model="ir.ui.view">
            <field name="name">hr.rfid.user.ev.list.anpr.ext</field>
            <field name="model">hr.rfid.event.user</field>
            <field name="inherit_id" ref="hr_rfid.hr_rfid_user_ev_view_list"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="camera_id" optional="hide"/>
                    <field name="license_plate" optional="hide"/>
                    <field name="anpr_confidence" optional="hide"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
