<odoo>
    <!-- Action for Whitelist smart button -->
    <record id="action_cctv_camera_whitelist" model="ir.actions.act_window">
        <field name="name">Whitelist Cards</field>
        <field name="res_model">cctv.camera.rfid.rel</field>
        <field name="view_mode">list</field>
        <field name="domain">[('camera_id','=',active_id), ('list_category','=','whitelist')]</field>
        <field name="context">{'default_camera_id': active_id, 'default_list_category': 'whitelist'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No plates whitelisted on this camera</p>
            <p>
                Whitelisted plates are auto-granted on detection. Add a row by selecting a card whose number matches the plate the camera should accept.
            </p>
        </field>
    </record>

    <!-- Action for Blacklist smart button -->
    <record id="action_cctv_camera_blacklist" model="ir.actions.act_window">
        <field name="name">Blacklist Cards</field>
        <field name="res_model">cctv.camera.rfid.rel</field>
        <field name="view_mode">list</field>
        <field name="domain">[('camera_id','=',active_id), ('list_category','=','blacklist')]</field>
        <field name="context">{'default_camera_id': active_id, 'default_list_category': 'blacklist'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No plates blacklisted on this camera</p>
            <p>
                Blacklisted plates trigger a denial event on detection. Add rows for vehicles that should never gain access through this camera's barrier.
            </p>
        </field>
    </record>

    <!-- List View for CCTV Cameras -->
    <record id="view_cctv_camera_list" model="ir.ui.view">
        <field name="name">cctv.camera.list</field>
        <field name="model">cctv.camera</field>
        <field name="arch" type="xml">
            <list sample="1" string="CCTV Cameras"
                  decoration-muted="connection_status == 'unknown'"
                  decoration-success="connection_status == 'connected'"
                  decoration-warning="connection_status in ('protocol_error', 'failed')"
                  decoration-danger="connection_status in ('unreachable', 'auth_failed', 'error')">
                <field name="name"/>
                <field name="ip_address"/>
                <field name="brand" optional="hide"/>
                <field name="model" optional="show"/>
                <field name="serial_number" optional="hide"/>
                <field name="connection_status" widget="badge" optional="show"
                       decoration-success="connection_status == 'connected'"
                       decoration-warning="connection_status in ('protocol_error', 'failed', 'unknown')"
                       decoration-danger="connection_status in ('unreachable', 'auth_failed', 'error')"/>
                <field name="last_seen" optional="show"/>
                <field name="last_heart_beat" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View for CCTV Cameras with Chatter and Smart Buttons for each list type -->
    <record id="view_cctv_camera_form" model="ir.ui.view">
        <field name="name">cctv.camera.form</field>
        <field name="model">cctv.camera</field>
        <field name="arch" type="xml">
            <form string="CCTV Camera">
                <header>
                    <field name="connection_status" widget="badge"
                           decoration-success="connection_status == 'connected'"
                           decoration-warning="connection_status in ('protocol_error', 'failed', 'unknown')"
                           decoration-danger="connection_status in ('unreachable', 'auth_failed', 'error')"/>
                    <!-- Manager-only: both actions read the manager-restricted
                         `password` field to authenticate to the camera. A plain
                         CCTV user would read it as empty and the API call would
                         fail, so the buttons are offered only to managers. -->
                    <button name="action_check_connection" type="object" string="Check Connection"
                            class="oe_highlight" groups="polimex_ip_cam.group_cctv_manager"
                            invisible="not ip_address or not port or not username"/>
                    <button name="action_get_snapshot" type="object" string="Take Snapshot"
                            class="oe_highlight" groups="polimex_ip_cam.group_cctv_manager"
                            invisible="not ip_address or not port or not username"/>
                    <button name="action_camera_diagnostics" type="object" string="Self-Test"
                            groups="polimex_ip_cam.group_cctv_manager"
                            invisible="not ip_address or not port or not username"
                            help="Checks everything this system uses from the camera - identity, picture, clock, event delivery, the plate list - and reports every problem in one place. Safe to run on a working camera: it only reads, apart from one test plate that is added and removed again."/>
                </header>
                <sheet>
                    <!-- Health banner: plain-language status + what to do, shown
                         only when there is a problem (hidden when online/unchecked). -->
                    <div class="alert alert-warning" role="alert"
                         invisible="connection_status in ('connected', 'unknown')">
                        <field name="connection_message" class="fw-bold mb-0"/>
                        <div class="small text-muted mt-1" invisible="not last_seen">
                            <span>Last online: </span>
                            <field name="last_seen" class="d-inline-block"/>
                        </div>
                        <field name="connection_error_detail"
                               class="d-block small text-muted mt-1"
                               invisible="not connection_error_detail"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <!-- Smart button for Whitelist -->
                        <button class="oe_stat_button" name="%(action_cctv_camera_whitelist)d" type="action"
                                icon="fa-users" invisible="rfid_whitelist_count == 0">
                            <field string="Whitelist" name="rfid_whitelist_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="%(action_cctv_camera_blacklist)d" type="action"
                                icon="fa-users" invisible="rfid_blacklist_count == 0">
                            <field string="Blacklist" name="rfid_blacklist_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="action_show_reader" type="object"
                                icon="fa-users" string="Readers" invisible="not reader_ids"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_avatar">
                        <field name="snapshot" widget="image"
                               options="{'zoom': true, 'preview_image': 'snapshot', 'size': [80, 80]}" class="bg-view"/>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Camera 1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="brand"/>
                            <field name="integration_type" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="serial_number"/>
                            <field name="firmware"/>
                            <field name="last_heart_beat"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Plate Lists" name="plate_lists" groups="base.group_no_one">
                            <p class="text-muted">
                                License plates registered with this camera and the ANPR list they belong to (allow, block, visitor, etc.). The camera enforces the list on each plate detection.
                            </p>
                            <div class="oe_button_box" name="button_box" groups="base.group_no_one">
                                <!--                                <button name="action_get_whitelist" type="object"-->
                                <!--                                        string="Get Whitelist"-->
                                <!--                                        invisible="connection_status != 'connected'"-->
                                <!--                                        class="oe_highlight"/>-->
                            </div>

                            <field name="rfid_rel_ids">
                                <list string="License Plate and Lists">
                                    <field name="card_id"/>
                                    <field name="list_category"/>
                                </list>
                                <form string="License Plate to Lists">
                                    <sheet>
                                        <group>
                                            <field name="card_id"/>
                                            <field name="list_category"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Settings" name="network_settings">
                            <p class="text-muted">
                                Connection details Odoo uses to reach the camera. Authentication is the same operator account configured on the camera's web UI.
                            </p>
                            <group>
                                <group string="Network Settings">
                                    <field name="ip_address"/>
                                    <field name="port"/>
                                    <field name="tz"/>
                                </group>
                                <group string="Authentication">
                                    <field name="username"/>
                                    <field name="password" password="True" placeholder="************"/>
                                </group>
                            </group>
                        </page>
                        <page string="Server Settings" name="server_settings" groups="base.group_no_one">
                            <p class="text-muted">
                                Where the camera pushes ANPR events to. Use Get to read the current push target from the camera, then Set to redirect it to this Odoo endpoint.
                            </p>
                            <div class="oe_button_box" name="button_box">
                                <button name="action_get_http_host" type="object"
                                        string="Get Push Server Information"
                                        invisible="connection_status != 'connected'"
                                        class="oe_highlight"/>
                                <button name="action_set_http_host" type="object"
                                        string="Set Push Server Information"
                                        invisible="connection_status != 'connected' and not server_setup"
                                        class="oe_highlight"/>
                            </div>
                            <group>
                                <field name="server_setup"/>
                            </group>
                        </page>
                        <page string="Entrance Settings" name="entrance_settings" groups="base.group_no_one">
                            <p class="text-muted">
                                Per-entrance parameters (lane direction, allowed list, snapshot mode) pulled from the camera. Use Get to read the current configuration; Set writes any local changes back to the device.
                            </p>
                            <div class="oe_button_box" name="button_box">
                                <button name="action_get_entrance_param" type="object"
                                        string="Get Entrance settings"
                                        invisible="connection_status != 'connected'"
                                        class="oe_highlight"/>
                                <button name="action_set_entrance_param" type="object"
                                        string="Set Entrance settings"
                                        invisible="connection_status != 'connected' and not server_setup"
                                        class="oe_highlight"/>
                            </div>
                            <group>
                                <field name="entrance_setup"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="view_cctv_camera_filter" model="ir.ui.view">
        <field name="name">cctv.camera.search</field>
        <field name="model">cctv.camera</field>
        <field name="arch" type="xml">
            <search string="CCTV Cameras">
                <field name="name" string="Camera"
                       filter_domain="['|','|','|','|', ('serial_number', 'ilike', self), ('sub_serial_number', 'ilike', self), ('model', 'ilike', self), ('ip_address', 'ilike', self), ('name', 'ilike', self)]"/>
                <field name="description"/>
                <field name="connection_status"/>
                <searchpanel>
                    <field name="company_id" groups="base.group_multi_company" icon="fa-building" enable_counters="1"/>
                    <field name="brand" icon="fa-users" enable_counters="1"/>
                </searchpanel>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_brand" string="Brand" domain="[]" context="{'group_by': 'brand'}"/>
                    <filter name="group_model" string="Model" domain="[]" context="{'group_by': 'model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_server_reload_whitelist" model="ir.actions.server">
        <field name="name">Reload Whitelist</field>
        <field name="model_id" ref="model_cctv_camera"/>
        <!-- вграждаме я в Action менюто на form & list -->
        <field name="binding_model_id" ref="model_cctv_camera"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
# Author: Polimex Dev Team
records.action_reload_whitelist()
action = {'type': 'ir.actions.client', 'tag': 'reload'}
        </field>
    </record>


    <!-- Kanban: the operator's overview. A camera IS its picture - the
         snapshot the model already holds (owner: "просто я използвай").
         Card idiom copied from fleet_vehicle_views.xml:294 (aside image +
         main), v19 t-name="card". -->
    <record id="cctv_camera_view_kanban" model="ir.ui.view">
        <field name="name">cctv.camera.kanban</field>
        <field name="model">cctv.camera</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="d-flex align-items-center me-2">
                            <field name="snapshot" widget="image"
                                   options="{'img_class': 'object-fit-cover'}"/>
                        </aside>
                        <main>
                            <div class="d-flex justify-content-between align-items-start">
                                <field class="fw-bolder fs-5" name="name"/>
                                <field name="connection_status" widget="badge"/>
                            </div>
                            <div class="text-muted small">
                                <field name="ip_address"/> - <field name="model"/>
                            </div>
                            <footer class="text-muted small pt-1"
                                    t-if="record.last_seen.raw_value">
                                <field name="last_seen"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Menu and Action for CCTV Camera Management -->
    <record id="action_cctv_camera" model="ir.actions.act_window">
        <field name="name">CCTV Cameras</field>
        <field name="res_model">cctv.camera</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first CCTV camera</p>
            <p>
                Add an ANPR camera by giving it an IP address, port, timezone and the operator credentials configured on the camera's web UI. Once connected, the camera pushes plate detection events back to Odoo and you can manage its access lists from here.
            </p>
        </field>
    </record>

    <menuitem id="menu_cctv_camera_action"
              name="Camera Manager"
              parent="hr_rfid.hr_rfid_root_menu_hardware_manager"
              groups="polimex_ip_cam.group_cctv_user"
              action="action_cctv_camera"
                  sequence="50"/>
</odoo>
