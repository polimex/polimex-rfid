<odoo>
    <!-- Action for Whitelist smart button -->
    <record id="action_cctv_camera_whitelist" model="ir.actions.act_window">
        <field name="name">Whitelist Cards</field>
        <field name="res_model">cctv.camera.rfid.rel</field>
        <field name="view_mode">list</field>
        <field name="domain">[('camera_id','=',active_id), ('list_category','=','whitelist')]</field>
        <field name="context">{'default_camera_id': active_id, 'default_list_category': 'whitelist'}</field>
    </record>

    <!-- Action for Blacklist smart button -->
    <record id="action_cctv_camera_blacklist" model="ir.actions.act_window">
        <field name="name">Blacklist Cards</field>
        <field name="res_model">cctv.camera.rfid.rel</field>
        <field name="view_mode">list</field>
        <field name="domain">[('camera_id','=',active_id), ('list_category','=','blacklist')]</field>
        <field name="context">{'default_camera_id': active_id, 'default_list_category': 'blacklist'}</field>
    </record>

    <!-- Action for Graylist smart button -->
    <record id="action_cctv_camera_graylist" model="ir.actions.act_window">
        <field name="name">Graylist Cards</field>
        <field name="res_model">cctv.camera.rfid.rel</field>
        <field name="view_mode">list</field>
        <field name="domain">[('camera_id','=',active_id), ('list_category','=','graylist')]</field>
        <field name="context">{'default_camera_id': active_id, 'default_list_category': 'graylist'}</field>
    </record>

    <!-- Action for Yellolist smart button -->
    <record id="action_cctv_camera_yellolist" model="ir.actions.act_window">
        <field name="name">Yellolist Cards</field>
        <field name="res_model">cctv.camera.rfid.rel</field>
        <field name="view_mode">list</field>
        <field name="domain">[('camera_id','=',active_id), ('list_category','=','yellolist')]</field>
        <field name="context">{'default_camera_id': active_id, 'default_list_category': 'yellolist'}</field>
    </record>

    <!-- Action for Otherlist smart button -->
    <record id="action_cctv_camera_otherlist" model="ir.actions.act_window">
        <field name="name">Otherlist Cards</field>
        <field name="res_model">cctv.camera.rfid.rel</field>
        <field name="view_mode">list</field>
        <field name="domain">[('camera_id','=',active_id), ('list_category','=','otherlist')]</field>
        <field name="context">{'default_camera_id': active_id, 'default_list_category': 'otherlist'}</field>
    </record>

    <!-- List View for CCTV Cameras -->
    <record id="view_cctv_camera_list" model="ir.ui.view">
        <field name="name">cctv.camera.list</field>
        <field name="model">cctv.camera</field>
        <field name="arch" type="xml">
            <list string="CCTV Cameras"
                  decoration-muted="connection_status == 'unknown'"
                  decoration-success="connection_status == 'connected'"
                  decoration-warning="connection_status == 'failed'">
                <field name="name"/>
                <field name="ip_address"/>
                <field name="brand" optional="hide"/>
                <field name="model" optional="show"/>
                <field name="serial_number" optional="hide"/>
                <field name="connection_status" optional="hide"/>
                <field name="last_heart_beat" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View for CCTV Cameras with Chatter and Smart Buttons for each list type -->
    <record id="view_cctv_camera_form" model="ir.ui.view">
        <field name="name">cctv.camera.form</field>
        <field name="model">cctv.camera</field>
        <field name="arch" type="xml">
            <form string="CCTV Camera">
                <header>
                    <field name="connection_status" widget="statusbar" statusbar_visible="unknown,connected,failed"/>
                    <button name="action_check_connection" type="object" string="Check Connection"
                            class="oe_highlight"
                            invisible="not ip_address or not port or not username or not password"/>
                    <button name="action_get_snapshot" type="object" string="Take Snapshot"
                            class="oe_highlight"
                            invisible="not ip_address or not port or not username or not password"/>

                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Smart button for Whitelist -->
                        <button class="oe_stat_button" name="%(action_cctv_camera_whitelist)d" type="action"
                                icon="fa-users" invisible="rfid_whitelist_count == 0">
                            <field string="Whitelist" name="rfid_whitelist_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="%(action_cctv_camera_blacklist)d" type="action"
                                icon="fa-users" invisible="rfid_blacklist_count == 0">
                            <field string="Blacklist" name="rfid_blacklist_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="%(action_cctv_camera_graylist)d" type="action"
                                icon="fa-users" invisible="rfid_graylist_count == 0">
                            <field string="Graylist" name="rfid_graylist_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="%(action_cctv_camera_yellolist)d" type="action"
                                icon="fa-users" invisible="rfid_yellolist_count == 0">
                            <field string="Yellolist" name="rfid_yellolist_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="%(action_cctv_camera_otherlist)d" type="action"
                                icon="fa-users" invisible="rfid_otherlist_count == 0">
                            <field string="Otherlist" name="rfid_otherlist_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="action_show_reader" type="object"
                                icon="fa-users" string="Readers" invisible="not reader_ids"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_avatar">
                        <field name="snapshot" widget="image"
                               options="{'zoom': true, 'preview_image': 'snapshot', 'size': [80, 80]}" class="bg-view"/>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Camera 1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="brand"/>
                            <field name="integration_type" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="serial_number"/>
                            <field name="firmware"/>
                            <field name="last_heart_beat"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Plate Lists" groups="base.group_no_one">
                            <div class="oe_button_box" name="button_box" groups="base.group_no_one">
                                <!--                                <button name="action_get_whitelist" type="object"-->
                                <!--                                        string="Get Whitelist"-->
                                <!--                                        invisible="connection_status != 'connected'"-->
                                <!--                                        class="oe_highlight"/>-->
                            </div>

                            <field name="rfid_rel_ids">
                                <list string="License Plate and Lists">
                                    <field name="card_id"/>
                                    <field name="list_category"/>
                                </list>
                                <form string="License Plate to Lists">
                                    <sheet>
                                        <group>
                                            <field name="card_id"/>
                                            <field name="list_category"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Settings">
                            <group>
                                <group string="Network Settings">
                                    <field name="ip_address"/>
                                    <field name="port"/>
                                    <field name="tz"/>
                                </group>
                                <group string="Authentication">
                                    <field name="username"/>
                                    <field name="password" password="True" placeholder="************"/>
                                </group>
                            </group>
                        </page>
                        <page string="Server Settings" groups="base.group_no_one">
                            <div class="oe_button_box" name="button_box">
                                <button name="action_get_http_host" type="object"
                                        string="Get Push Server Information"
                                        invisible="connection_status != 'connected'"
                                        class="oe_highlight"/>
                                <button name="action_set_http_host" type="object"
                                        string="Set Push Server Information"
                                        invisible="connection_status != 'connected' and not server_setup"
                                        class="oe_highlight"/>
                            </div>
                            <group>
                                <field name="server_setup"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="view_cctv_camera_filter" model="ir.ui.view">
        <field name="name">cctv.camera.search</field>
        <field name="model">cctv.camera</field>
        <field name="arch" type="xml">
            <search string="CCTV Cameras">
                <field name="name" string="Camera"
                       filter_domain="['|','|','|', ('serial', 'ilike', self),('model', 'ilike', self), ('ip_address', 'ilike', self), ('name', 'ilike', self)]"/>
                <field name="description"/>
                <field name="connection_status"/>
                <searchpanel>
                    <field name="company_id" groups="base.group_multi_company" icon="fa-building" enable_counters="1"/>
                    <field name="brand" icon="fa-users" enable_counters="1"/>
                </searchpanel>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_brand" string="Brand" domain="[]" context="{'group_by': 'brand'}"/>
                    <filter name="group_model" string="Model" domain="[]" context="{'group_by': 'model'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Menu and Action for CCTV Camera Management -->
    <record id="action_cctv_camera" model="ir.actions.act_window">
        <field name="name">CCTV Cameras</field>
        <field name="res_model">cctv.camera</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cctv_camera_action"
              name="Camera Manager"
              parent="hr_rfid.hr_rfid_root_menu_hardware_manager"
              groups="polimex_ip_cam.group_cctv_user"
              action="action_cctv_camera"/>
</odoo>
