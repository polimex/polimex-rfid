<odoo>
    <data>
        <!-- Form view for Camera Commands -->
        <record id="view_cctv_camera_command_form" model="ir.ui.view">
            <field name="name">cctv.camera.command.form</field>
            <field name="model">cctv.camera.command</field>
            <field name="arch" type="xml">
                <form string="Camera Command">
                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="camera_id"/>
                        </group>
                        <group>
                            <field name="command_type"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="execution_time" readonly="1"/>
                            <field name="retry_count" readonly="1"/>
                        </group>
                        <group string="Request Data" groups="base.group_no_one">
                            <field name="request_data"/>
                        </group>
                        <group string="Response Data" groups="base.group_no_one">
                            <field name="response_data"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- list view for Camera Commands -->
        <record id="view_cctv_camera_command_list" model="ir.ui.view">
            <field name="name">cctv.camera.command.list</field>
            <field name="model">cctv.camera.command</field>
            <field name="arch" type="xml">
                <list sample="1" string="Camera Commands">
                    <field name="name"/>
                    <field name="camera_id"/>
                    <field name="command_type"/>
                    <field name="state"/>
                    <field name="execution_time"/>
                    <field name="retry_count"/>
                </list>
            </field>
        </record>

        <record id="view_cctv_camera_command_search" model="ir.ui.view">
            <field name="name">view.cctv.camera.command.search</field>
            <field name="model">cctv.camera.command</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="name"
                           string="string"
                           filter_domain="['|','|',('request_data','ilike',self),('response_data','ilike',self),('camera_id','ilike',self)]"/>
                    <filter string="Command time" name="filter_command_time" date="create_date"
                            default_period="month-1"/>

                    <filter name="filter_this_day" string="Commands from today" domain="[
                            ('create_date', '&gt;=', (datetime.datetime.combine(context_today(), datetime.time(0,0,0)).to_utc()).strftime('%Y-%m-%d %H:%M:%S'))]"/>

                    <searchpanel>
                        <field name="state" select="multi" enable_counters="1" icon="fa-list-alt"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="action_server_restart_commands" model="ir.actions.server">
            <field name="name">Restart sending</field>
            <field name="model_id" ref="model_cctv_camera_command"/>
            <field name="binding_model_id" ref="model_cctv_camera_command"/>
            <field name="binding_type">action</field>
            <field name="binding_view_types">form,list</field>
            <field name="state">code</field>
            <field name="code">
# Author: Polimex Dev Team
records.queue_send()
action = {'type': 'ir.actions.client', 'tag': 'reload'}
            </field>
        </record>

        <!-- Action for Camera Commands -->
        <record id="action_cctv_camera_command" model="ir.actions.act_window">
            <field name="name">Camera Commands</field>
            <field name="res_model">cctv.camera.command</field>
            <field name="context">{"search_default_filter_this_day": 1}</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No camera commands sent today</p>
                <p>
                    Audit trail of commands Odoo has sent to cameras (whitelist sync, push-server reconfigure, etc.). The view defaults to today's batch; expand the date filter to see the full history. Use Restart Sending to retry a failed command.
                </p>
            </field>
        </record>

        <!-- Menu Item (if desired) -->
        <menuitem id="menu_cctv_camera_command" name="Camera Commands"
                  parent="hr_rfid.hr_rfid_events_menu" action="action_cctv_camera_command"/>
    </data>
</odoo>
