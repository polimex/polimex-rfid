<odoo>
    <data>
        <!-- Form view for Camera Commands -->
        <record id="view_cctv_camera_command_form" model="ir.ui.view">
            <field name="name">cctv.camera.command.form</field>
            <field name="model">cctv.camera.command</field>
            <field name="arch" type="xml">
                <form string="Camera Command">
                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="camera_id"/>
                        </group>
                        <group>
                            <field name="command_type"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="execution_time" readonly="1"/>
                            <field name="retry_count" readonly="1"/>
                        </group>
                        <group string="Request Data">
                            <field name="request_data"/>
                        </group>
                        <group string="Response Data">
                            <field name="response_data"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- list view for Camera Commands -->
        <record id="view_cctv_camera_command_list" model="ir.ui.view">
            <field name="name">cctv.camera.command.list</field>
            <field name="model">cctv.camera.command</field>
            <field name="arch" type="xml">
                <list string="Camera Commands">
                    <field name="name"/>
                    <field name="camera_id"/>
                    <field name="command_type"/>
                    <field name="state"/>
                    <field name="execution_time"/>
                    <field name="retry_count"/>
                </list>
            </field>
        </record>

        <!-- Action for Camera Commands -->
        <record id="action_cctv_camera_command" model="ir.actions.act_window">
            <field name="name">Camera Commands</field>
            <field name="res_model">cctv.camera.command</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu Item (if desired) -->
        <menuitem id="menu_cctv_camera_command" name="Camera Commands"
                  parent="hr_rfid.hr_rfid_events_menu" action="action_cctv_camera_command"/>
    </data>
</odoo>
