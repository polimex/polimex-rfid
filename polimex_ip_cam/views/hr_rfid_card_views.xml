<odoo>
    <!-- Action to open the list view of camera relations for the current card -->
    <record id="action_hr_rfid_card_cameras" model="ir.actions.act_window">
        <field name="name">Cameras for Card</field>
        <field name="res_model">cctv.camera.rfid.rel</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('card_id','=',active_id)]</field>
        <field name="context">{'default_card_id': active_id}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">This card is not registered with any camera</p>
            <p>
                Add a row to associate this card with an ANPR camera and a list category (whitelist / blacklist / etc.). The camera enforces the list on plate detection.
            </p>
        </field>
    </record>

    <!-- Inherit the existing hr.rfid.card form view -->
    <record id="inherited_hr_rfid_card_view_form_cctv" model="ir.ui.view">
        <field name="name">hr.rfid.card.form.inherit.cctv</field>
        <field name="model">hr.rfid.card</field>
        <field name="inherit_id" ref="hr_rfid.hr_rfid_card_view_form"/>
        <field name="arch" type="xml">
            <!-- Insert a new button into the button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="%(action_hr_rfid_card_cameras)d" type="action"
                        icon="fa-video-camera" context="{'default_card_id': id}"
                        groups="polimex_ip_cam.group_cctv_user"
                        help="List Cameras in which this card is included"
                        invisible="camera_count == 0">
                    <field string="Cameras" name="camera_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

        <record id="action_server_check_card_len" model="ir.actions.server">
        <field name="name">Check Card numbers</field>
        <field name="model_id" ref="model_hr_rfid_card"/>
        <!-- вграждаме я в Action менюто на form & list -->
        <field name="binding_model_id" ref="model_hr_rfid_card"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
# Author: Polimex Dev Team
records._check_len_number()
action = {'type': 'ir.actions.client', 'tag': 'reload'}
        </field>
    </record>

</odoo>
