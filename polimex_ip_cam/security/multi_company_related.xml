<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ir_rule_cctv_camera_multi_company" model="ir.rule">
            <field name="name">CCTV Camera: Multi Company</field>
            <field name="model_id" ref="model_cctv_camera"/>
            <field name="global" eval="True"/>
            <!-- company_id is optional on cctv.camera (no required=); tolerate
                 NULL so a global camera is not hidden from every user
                 (odoo19-gotchas: optional company_id rule must allow False). -->
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- These records OVERRIDE the base hr_rfid rules (same xml_id): each
             must carry EVERY branch of the base domain - the camera branch is an
             ADDITION, not a replacement. That means the broken-chain /
             NULL-company branches AND the shared-module branch, or installing
             this module would silently revoke visibility hr_rfid grants.
             hr_rfid splits these rules per operation (a sharing company only
             READS the owner's hardware), so the overrides mirror the split:
             the shared branch appears in the read rule only. -->
        <record id="hr_rfid.ir_rule_hr_rfid_reader_multi_company" model="ir.rule">
            <field name="name">HR RFID Readers Camera: Multi Company</field>
            <field name="model_id" ref="model_hr_rfid_reader"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', '|', '|', '|', ('camera_id.company_id', 'in', company_ids), ('controller_id', '=', False), ('webstack_id.company_id', '=', False), ('webstack_id.company_id', 'in', company_ids), ('webstack_id.shared_company_ids', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_rfid.ir_rule_hr_rfid_reader_multi_company_write" model="ir.rule">
            <field name="name">HR RFID Readers Camera: Multi Company (change)</field>
            <field name="model_id" ref="model_hr_rfid_reader"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', '|', '|', ('camera_id.company_id', 'in', company_ids), ('controller_id', '=', False), ('webstack_id.company_id', '=', False), ('webstack_id.company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="hr_rfid.ir_rule_hr_rfid_event_system_multi_company" model="ir.rule">
            <field name="name">HR RFID System Events Camera: Multi Company</field>
            <field name="model_id" ref="model_hr_rfid_event_system"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', '|', '|', '|', ('camera_id.company_id', 'in', company_ids), ('controller_id', '=', False), ('controller_id.webstack_id.company_id', '=', False), ('controller_id.webstack_id.company_id', 'in', company_ids), ('controller_id.webstack_id.shared_company_ids', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_rfid.ir_rule_hr_rfid_event_system_multi_company_write" model="ir.rule">
            <field name="name">HR RFID System Events Camera: Multi Company (change)</field>
            <field name="model_id" ref="model_hr_rfid_event_system"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', '|', '|', ('camera_id.company_id', 'in', company_ids), ('controller_id', '=', False), ('controller_id.webstack_id.company_id', '=', False), ('controller_id.webstack_id.company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- An unknown plate at a camera produces an event with no employee
             and no contact. In hr_rfid such an orphan is kept visible when
             its reader chain is BROKEN, so it is not lost to everyone - and
             a camera reader has no controller by design (the camera is the
             equipment), so every ANPR orphan fell into that branch and was
             readable by every company, plate and snapshot included. The
             camera itself names the company; that is the answer here, with
             the broken-chain fallback kept only for a reader that belongs to
             neither a camera nor a controller. -->
        <record id="hr_rfid.ir_rule_hr_rfid_event_user_multi_company" model="ir.rule">
            <field name="name">HR RFID User Events Camera: Multi Company</field>
            <field name="model_id" ref="model_hr_rfid_event_user"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[
                '|', '|',
                '|', ('employee_id.company_id', 'in', company_ids),
                ('employee_id.company_id', '=', False),
                '|', ('contact_id.company_id', 'in', company_ids),
                ('contact_id.company_id', '=', False),
                '&amp;', ('employee_id', '=', False),
                '&amp;', ('contact_id', '=', False),
                '|', '|', '|', '|', '|', '|',
                ('camera_id.company_id', 'in', company_ids),
                ('reader_id.camera_id.company_id', 'in', company_ids),
                ('reader_id.controller_id.webstack_id.company_id', 'in', company_ids),
                ('reader_id.controller_id.webstack_id.shared_company_ids', 'in', company_ids),
                '&amp;', ('reader_id', '=', False), ('camera_id', '=', False),
                '&amp;', ('reader_id.controller_id', '=', False),
                ('reader_id.camera_id', '=', False),
                ('reader_id.controller_id.webstack_id.company_id', '=', False)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>