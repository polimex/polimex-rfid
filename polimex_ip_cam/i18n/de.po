#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid ""
"%(cameras)s did not answer, so nothing was sent there - try again when the "
"connection is back. %(queued)s plate(s) were queued to the reachable "
"cameras."
msgstr ""
"%(cameras)s hat/haben nicht geantwortet, daher wurde dorthin nichts gesendet"
" - versuchen Sie es erneut, wenn die Verbindung wiederhergestellt ist. "
"%(queued)s Kennzeichen wurden für die erreichbaren Kameras in die "
"Warteschlange gestellt."

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid "%(label)s (fields: %(shape)s): REFUSED - %(error)s"
msgstr "%(label)s (Felder: %(shape)s): ABGELEHNT - %(error)s"

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid "%(label)s (fields: %(shape)s): accepted"
msgstr "%(label)s (Felder: %(shape)s): akzeptiert"

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid ""
"%(queued)s plate(s) queued for sending; %(removed)s foreign plate(s) queued "
"for removal - the camera will hold exactly the list kept here."
msgstr ""
"%(queued)s Kennzeichen zum Senden eingereiht; %(removed)s fremde(s) "
"Kennzeichen zum Entfernen eingereiht - die Kamera wird genau die hier "
"gepflegte Liste vorhalten."

