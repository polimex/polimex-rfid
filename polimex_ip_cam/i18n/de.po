#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid ""
"A DIFFERENT device answers at this address: it reports serial %(got)s, this "
"record says %(want)s."
msgstr ""
"An dieser Adresse antwortet ein ANDERES Gerät: Es meldet Seriennummer "
"%(got)s, dieser Datensatz besagt %(want)s."

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid ""
"A write onto a plate the camera already holds FAILS even with the replace "
"step: %(error)s"
msgstr ""
"Ein Schreibvorgang auf ein von der Kamera bereits gespeichertes Kennzeichen "
"SCHLÄGT selbst mit dem Ersetzungsschritt fehl: %(error)s"

