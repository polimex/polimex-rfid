#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid ""
"%(cameras)s did not answer, so nothing was sent there - try again when the "
"connection is back. %(queued)s plate(s) were queued to the reachable "
"cameras."
msgstr ""
"%(cameras)s не отговори(ха), затова нищо не беше изпратено там - опитайте "
"отново, когато връзката се възстанови. %(queued)s табела(и) бяха добавени в "
"опашката за достъпните камери."

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid "%(label)s (fields: %(shape)s): REFUSED - %(error)s"
msgstr "%(label)s (полета: %(shape)s): ОТКАЗАНО - %(error)s"

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid "%(label)s (fields: %(shape)s): accepted"
msgstr "%(label)s (полета: %(shape)s): прието"

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid ""
"%(queued)s plate(s) queued for sending; %(removed)s foreign plate(s) queued "
"for removal - the camera will hold exactly the list kept here."
msgstr ""
"%(queued)s табела(и) в опашка за изпращане; %(removed)s чужда(и) табела(и) в"
" опашка за премахване - камерата ще пази точно списъка, поддържан тук."

