#: model:ir.model.fields,help:polimex_ip_cam.field_hr_rfid_event_system__anpr_confidence
#: model:ir.model.fields,help:polimex_ip_cam.field_hr_rfid_event_user__anpr_confidence
#: model:ir.model.fields,help:polimex_ip_cam.field_hr_rfid_vending_event__anpr_confidence
