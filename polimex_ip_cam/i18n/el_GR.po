#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid ""
"%(cameras)s did not answer, so nothing was sent there - try again when the "
"connection is back. %(queued)s plate(s) were queued to the reachable "
"cameras."
msgstr ""
"Οι %(cameras)s δεν απάντησαν, επομένως δεν στάλθηκε τίποτα εκεί - δοκιμάστε "
"ξανά όταν αποκατασταθεί η σύνδεση. %(queued)s πινακίδα(ες) τέθηκαν σε "
"αναμονή για τις προσβάσιμες κάμερες."

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid "%(label)s (fields: %(shape)s): REFUSED - %(error)s"
msgstr "%(label)s (πεδία: %(shape)s): ΑΠΟΡΡΙΦΘΗΚΕ - %(error)s"

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid "%(label)s (fields: %(shape)s): accepted"
msgstr "%(label)s (πεδία: %(shape)s): αποδεκτό"

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid ""
"%(queued)s plate(s) queued for sending; %(removed)s foreign plate(s) queued "
"for removal - the camera will hold exactly the list kept here."
msgstr ""
"%(queued)s πινακίδα(ες) σε αναμονή αποστολής· %(removed)s ξένη(ες) "
"πινακίδα(ες) σε αναμονή αφαίρεσης - η κάμερα θα διατηρήσει ακριβώς τη λίστα "
"που τηρείται εδώ."

#. module: polimex_ip_cam
