#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid ""
"%(cameras)s did not answer, so nothing was sent there - try again when the "
"connection is back. %(queued)s plate(s) were queued to the reachable "
"cameras."
msgstr ""
"%(cameras)s non ha risposto, quindi non è stato inviato nulla - riprova "
"quando la connessione sarà ripristinata. %(queued)s targa/e sono state messe"
" in coda per le telecamere raggiungibili."

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid "%(label)s (fields: %(shape)s): REFUSED - %(error)s"
msgstr "%(label)s (campi: %(shape)s): RIFIUTATO - %(error)s"

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid "%(label)s (fields: %(shape)s): accepted"
msgstr "%(label)s (campi: %(shape)s): accettato"

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid ""
"%(queued)s plate(s) queued for sending; %(removed)s foreign plate(s) queued "
"for removal - the camera will hold exactly the list kept here."
msgstr ""
"%(queued)s targa/e in coda per l'invio; %(removed)s targa/e estranea/e in "
"coda per la rimozione - la telecamera manterrà esattamente la lista "
"conservata qui."

