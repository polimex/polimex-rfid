msgstr "<span>Ultimo online: </span>"

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid ""
"A DIFFERENT device answers at this address: it reports serial %(got)s, this "
"record says %(want)s."
msgstr ""
"A questo indirizzo risponde un dispositivo DIVERSO: dichiara il numero di "
"serie %(got)s, mentre questo record indica %(want)s."

#. module: polimex_ip_cam
#. odoo-python
#: code:addons/polimex_ip_cam/models/cctv_camera.py:0
msgid ""
"A write onto a plate the camera already holds FAILS even with the replace "
"step: %(error)s"
msgstr ""
"Una scrittura su una targa già presente nella telecamera FALLISCE anche con "
"il passaggio di sostituzione: %(error)s"

