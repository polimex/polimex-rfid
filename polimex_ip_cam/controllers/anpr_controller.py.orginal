import logging
import xml.etree.ElementTree as ET  # ако ще парсвате XML
import json                        # ако ще парсвате JSON
from odoo import http, fields
from odoo.http import request

_logger = logging.getLogger(__name__)

class AnprEventController(http.Controller):
    """
    Controller for handling ANPR events from IP cameras.
    """
    @http.route(['/ipcam/anpr/event'], type='http', auth='none', methods=['POST'], cors='*', csrf=False,
                save_session=False, sitemap=False)
    def receive_anpr_event(self, **kwargs):
        """
        Този метод ще се извиква от камерата, когато има ново ANPR събитие.
        URL: http://<odoo-host>:<odoo-port>/ipcam/anpr/event
        """
        # 1. Извличане на суровите данни от заявката
        raw_data = request.httprequest.data  # bytes
        _logger.info("Received ANPR event data: %s", raw_data)

        # 2. Пример: проверка дали данните са XML или JSON
        # (в зависимост от настройките на камерата)
        # Ще демонстрираме с XML парсване:
        license_plate = False
        camera_ip = request.httprequest.remote_addr  # IP-то на камерата
        camera_obj = None

        try:
            # Примерен XML парсинг
            # <EventNotificationAlert>...<licensePlate>XXX</licensePlate>...</EventNotificationAlert>
            root = ET.fromstring(raw_data.decode('utf-8', errors='ignore'))
            ns = {'ns': 'http://www.isapi.org/ver20/XMLSchema'}  # ако има namespace
            plate_element = root.find('.//licensePlate')
            if plate_element is not None:
                license_plate = plate_element.text.strip()
        except Exception as e:
            _logger.warning("XML parsing failed, trying JSON or ignoring. Error: %s", e)
            # Ако не е XML, може да опитаме JSON:
            try:
                json_data = json.loads(raw_data)
                license_plate = json_data.get('licensePlate')
            except Exception as e2:
                _logger.error("Failed to parse as XML or JSON: %s", e2)

        # 3. Откриване на камера по IP (ако желаете да я свържете автоматично)
        #    Например, ако в cctv.camera има поле ip_address
        if camera_ip:
            camera_obj = request.env['cctv.camera'].sudo().search([('ip_address', '=', camera_ip)], limit=1)

        # 4. Създаване на запис в hr.rfid.event.user (или друг модел) със sudo(),
        #    защото auth='public' няма автентикация
        event_vals = {
            'event_time': fields.Datetime.now(),  # текущо време
            'event_action': '64',  # примерно '64' => "Request Instructions" или друго
            'more_json': raw_data.decode('utf-8', errors='ignore'),  # запазваме суровите данни за справка
        }
        # Ако сте добавили ANPR полета в hr.rfid.event.user:
        if camera_obj:
            event_vals['camera_id'] = camera_obj.id
        if license_plate:
            event_vals['license_plate'] = license_plate

        new_event = request.env['hr.rfid.event.user'].sudo().create(event_vals)
        _logger.info("Created new hr.rfid.event.user: %s", new_event)

        # 5. Връщаме отговор към камерата
        return "OK"
