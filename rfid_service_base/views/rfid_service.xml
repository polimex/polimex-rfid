<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_rfid_service_action" model="ir.actions.act_window">
            <field name="name">Services</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">rfid.service</field>
            <field name="view_mode">kanban,list,form</field>
            <!--            <field name="context">{'active_test': False}</field>-->
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p>
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>

        <record id="hr_rfid_service_kanban" model="ir.ui.view">
            <field name="name">hr.rfid.service.kanban</field>
            <field name="model">rfid.service</field>
            <field name="arch" type="xml">
                <kanban highlight_color="color" can_open="0" sample="1">
                    <field name="name"/>
                    <field name="active"/>
                    <field name="service_type"/>
                    <field name="access_group_id"/>
                    <field name="zone_id"/>
                    <field name="color"/>
                    <field name="displayed_image_id"/>

                    <templates>
                        <t t-name="menu">
                            <div class="container">
                                <div class="row">
                                    <div class="col-6">
                                        <h5 role="menuitem" class="o_kanban_card_manage_title">
                                            <span>View</span>
                                        </h5>
                                        <div role="menuitem">
                                            <a role="menuitem" name="action_new_sale"
                                               type="object" groups="base.group_user">Sale Service
                                            </a>
                                        </div>
                                        <div role="menuitem">
                                            <a role="menuitem" name="action_view_sales"
                                               type="object" groups="rfid_service_base.group_card_manager">Sales history
                                            </a>
                                        </div>
                                    </div>
                                    <div class="col-6 o_kanban_manage_reports">
                                        <h5 role="menuitem" class="o_kanban_card_manage_title">
                                            <span>Setup</span>
                                        </h5>
                                        <div role="menuitem">
                                            <a role="menuitem" data-field="displayed_image_id"
                                               type="set_cover" groups="rfid_service_base.group_card_manager">
                                                Set Cover Image
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_card_manage_settings row" groups="hr.group_hr_user">
                                    <div t-if="widget.editable" role="menuitem" aria-haspopup="true" class="col-6">
                                        <field name="color" widget="kanban_color_picker"/>
                                    </div>
                                    <div class="col-6">
                                        <a t-if="widget.editable" role="menuitem" class="dropdown-item" type="open">
                                            Configuration
                                        </a>
                                        <a t-if="record.active.raw_value" role="menuitem" type="archive"
                                           class="dropdown-item">Archive
                                        </a>
                                        <a t-if="!record.active.raw_value" role="menuitem" type="unarchive"
                                           class="dropdown-item">Unarchive
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Заменяме "kanban-box" с "card" -->
                        <t t-name="card">
                            <div t-attf-class="#{kanban_color(record.color.raw_value)} col o_has_icon oe_kanban_content oe_kanban_card">
                                <div class="o_kanban_card_content mw-100">
                                    <div class="o_kanban_primary_left">
                                        <div class="o_primary">
                                            <span class="o_text_overflow">
                                                <t t-esc="record.name.value"/>
                                            </span>
                                            <div t-if="record.displayed_image_id.value">
                                                <a name="action_new_sale" type="object">
                                                    <field name="displayed_image_id" widget="attachment_image"/>
                                                </a>
                                            </div>
                                            <span class="o_text_overflow text-muted"
                                                  t-if="record.service_type.value">
                                                <span class="fa fa-user mr-2" aria-label="Type" title="Type"></span>
                                                <t t-esc="record.service_type.value"/>
                                            </span>
                                            <div t-if="record.time_interval_start.raw_value or record.time_interval_end.raw_value"
                                                 class="text-muted d-flex align-items-center">
                                                <span class="fa fa-clock-o mr-2" title="Start"></span>
                                                <field name="time_interval_start" widget="float_time"/>
                                                <i t-if="record.time_interval_end.raw_value"
                                                   class="fa fa-long-arrow-right mx-2 oe_read_only"
                                                   aria-label="Arrow icon" title="Arrow"/>
                                                <field name="time_interval_end" widget="float_time"/>
                                            </div>

                                            <div t-if="record.access_group_id.value"
                                                 class="text-muted">
                                                <span class="fa fa-envelope-o mr-2" aria-label="Group"
                                                      title="Group"></span>
                                                <t t-esc="record.access_group_id.value"/>
                                            </div>
                                            <field name="tag_ids" widget="many2many_tags"
                                                   options="{'color_field': 'color'}"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <footer class="pt-1 mt-0">
                                <div class="d-flex mt-auto">
                                    <a name="action_new_sale" type="object">
                                        <span class="o_label">New sale</span>
                                    </a>
                                </div>
                                <field name="activity_ids" widget="kanban_activity" class="ms-auto"/>
                            </footer>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="services_form" model="ir.ui.view">
            <field name="name">RFID Services</field>
            <field name="model">rfid.service</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h2>
                                <div>
                                    <field name="name" placeholder="Friendly name of the domain" class="oe_inline"/>
                                    <span class="oe_inline oe_read_only">-</span>
                                    <field name="service_type" class="oe_inline"/>
                                </div>
                            </h2>
                        </div>
                        <group>
                            <group string="Time based" invisible="service_type == 'count'">
                                <label for="time_interval_number"/>
                                <div>
                                    <field name="time_interval_number" class="oe_inline"/>
                                    <span class="oe_inline oe_read_only"></span>
                                    <field name="time_interval_type" class="oe_inline"/>
                                </div>
                                <label for="time_interval_start" string="Start and End time"/>
                                <div>
                                    <field name="time_interval_start" widget="float_time" class="oe_inline"/>
                                    <span class="oe_inline oe_read_only">-</span>
                                    <field name="time_interval_end" widget="float_time" class="oe_inline"/>
                                </div>
                            </group>
                            <group string="Visit based" invisible="service_type == time">
                                <field name="visits"/>
                            </group>
                            <group id="rfid_service_form_group">
                                <field name="fixed_time"/>
                                <field name="generate_barcode_card" widget="generate_barcode_card"/>
                            </group>
                            <group id="rfid_service_form_group2">
                                <field name="card_type" options='{"no_open": True, "no_create": True}'/>
                                <field name="parent_id"/>
                            </group>
                            <group string="Templates" id="rfid_service_form_printing_templates"
                                   groups="base.group_no_one">
                                <field name="mail_template_id"/>
                                <field name="print_template_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Settings">
                                <group>
                                    <group string="Default Access Rights">
                                        <field name="access_group_id"/>
                                    </group>
                                    <group string="Related company" groups="base.group_multi_company">
                                        <field name="company_id"/>
                                    </group>
                                    <group>
                                        <field name="tag_ids" widget="many2many_tags"
                                               options="{'color_field': 'color'}"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="services_tree" model="ir.ui.view">
            <field name="name">RFID Services List</field>
            <field name="model">rfid.service</field>
            <field name="arch" type="xml">
                <list string="RFID Services List" decoration-success="active==True" decoration-danger="active!=True">
                    <field name="name"/>
                    <field name="service_type"/>
                    <field name="access_group_id" optional="hide"/>
                    <field name="card_type" options='{"no_open": True, "no_create": True}' optional="hide"/>
                    <field name="time_interval_start" widget="float_time" optional="show"/>
                    <field name="time_interval_end" widget="float_time" optional="show"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                    <field name="parent_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="hr_rfid_service_search" model="ir.ui.view">
            <field name="name">hrrfid.service.search</field>
            <field name="model">rfid.service</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="name"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <searchpanel>
                        <field name="service_type" icon="fa-building" enable_counters="1"/>
                        <field name="card_type" icon="fa-users" enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>
    </data>
</odoo>