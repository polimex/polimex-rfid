<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="ir_rule_hr_rfid_leave_block_multi_company" model="ir.rule">
            <field name="name">RFID leave block: Multi Company</field>
            <field name="model_id" ref="model_hr_rfid_leave_block"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[
                '|', ('company_id', 'in', company_ids),
                ('company_id', '=', False),
                ]
            </field>
        </record>
    </data>
</odoo>
