<?xml version="1.0" encoding="utf-8"?>
<!-- Part of Polimex Modules. See LICENSE file for full copyright and licensing details.

     Showcase demo for hr_rfid_leave_block.

     Strategy: drive the module through its REAL production hooks instead of
     hand-seeding audit rows. Two people of their own (so their time off meets
     no core demo leave) get RFID cards and a sick leave that began three days
     ago - always going on when the demo loads, whatever the weekday. Approving
     a leave that goes on fires this module's write hook (_rfid_block_access):
     it snapshots exactly the person's ACTIVE cards into an hr.rfid.leave.block
     and deactivates them. A leave approved for later would stop the cards only
     when it begins (the scheduled action). Result:

       * Nora Hill  -> ACTIVE 'Blocking' block, 2 suspended cards; a 3rd card
         she had already disabled is correctly NOT in the snapshot and stays
         off. When her leave ends, the scheduled action gives the 2 back.
       * Owen Price -> RESTORED block: his leave was approved, then refused;
         his 1 card is re-enabled, with blocked_at + restored_at timestamps.

     noupdate="1": the <function> approvals mutate state and must run ONLY at
     install (mode='init'); re-running them on a module -u would try to approve
     an already-validated leave and raise. Records are preserved across updates.
-->
<odoo noupdate="1">

    <record id="demo_lb_employee_nora" model="hr.employee">
        <field name="name">Nora Hill</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="demo_lb_employee_owen" model="hr.employee">
        <field name="name">Owen Price</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <!-- Two active badges + one she already disabled before the leave. -->
    <record id="demo_lb_card_al_1" model="hr.rfid.card">
        <field name="employee_id" ref="demo_lb_employee_nora"/>
        <field name="number">2200000001</field>
        <field name="card_reference">Badge LB-1</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="demo_lb_card_al_2" model="hr.rfid.card">
        <field name="employee_id" ref="demo_lb_employee_nora"/>
        <field name="number">2200000002</field>
        <field name="card_reference">Badge LB-2</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <!-- Already disabled BEFORE the leave. Not active at approval time, so the
         snapshot must exclude it; restore must never switch it back on. -->
    <record id="demo_lb_card_al_old" model="hr.rfid.card">
        <field name="employee_id" ref="demo_lb_employee_nora"/>
        <field name="number">2200000003</field>
        <field name="card_reference">Old Badge (already off)</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="active" eval="False"/>
    </record>

    <record id="demo_lb_card_qdp_1" model="hr.rfid.card">
        <field name="employee_id" ref="demo_lb_employee_owen"/>
        <field name="number">2200000010</field>
        <field name="card_reference">Badge LB-3</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <!-- Nora's sick leave, going on now. Sick Time Off: requires_allocation
         False, single-step ('hr') validation, so one action_approve reaches
         'validate' and the cards stop at once. -->
    <record id="demo_lb_leave_al" model="hr.leave">
        <field name="name">RFID access block demo - approved absence</field>
        <field name="holiday_status_id" ref="hr_holidays.leave_type_sick_time_off"/>
        <field name="employee_id" ref="demo_lb_employee_nora"/>
        <field name="request_date_from" eval="(datetime.today().date() - relativedelta(days=3))"/>
        <field name="request_date_to" eval="(datetime.today().date() + relativedelta(days=4))"/>
        <field name="state">confirm</field>
    </record>
    <function model="hr.leave" name="action_approve">
        <value eval="ref('hr_rfid_leave_block.demo_lb_leave_al')"/>
    </function>

    <!-- Owen's leave, going on now: approved (his card stops), then refused
         (his card comes back). -->
    <record id="demo_lb_leave_qdp" model="hr.leave">
        <field name="name">RFID access block demo - refused absence</field>
        <field name="holiday_status_id" ref="hr_holidays.leave_type_sick_time_off"/>
        <field name="employee_id" ref="demo_lb_employee_owen"/>
        <field name="request_date_from" eval="(datetime.today().date() - relativedelta(days=3))"/>
        <field name="request_date_to" eval="(datetime.today().date() + relativedelta(days=1))"/>
        <field name="state">confirm</field>
    </record>
    <function model="hr.leave" name="action_approve">
        <value eval="ref('hr_rfid_leave_block.demo_lb_leave_qdp')"/>
    </function>
    <function model="hr.leave" name="action_refuse">
        <value eval="ref('hr_rfid_leave_block.demo_lb_leave_qdp')"/>
    </function>

</odoo>
