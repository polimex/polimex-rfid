#. module: hr_rfid_leave_block
#: model_terms:ir.ui.view,arch_db:hr_rfid_leave_block.hr_rfid_leave_block_view_form
msgid ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Only the cards listed here are re-activated when access\n"
"                            is restored. A card the employee disabled before the\n"
"                            leave, or added during it, is intentionally left as-is."
msgstr ""
"<i class=\"fa fa-lightbulb-o\" role=\"img\"/>\n"
"                            Само картите, изброени тук, се активират отново при възстановяване на достъпа. Карта, деактивирана от служителя преди отпуска или добавена по времето му, умишлено се оставя непроменена."

