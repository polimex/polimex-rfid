<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="spreadsheet_dashboard_access_control" model="spreadsheet.dashboard">
        <field name="name">Access Control</field>
        <field name="spreadsheet_binary_data" type="base64"
               file="spreadsheet_dashboard_hr_rfid/data/files/access_control_dashboard.json"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_hr"/>
        <field name="group_ids" eval="[Command.link(ref('hr_rfid.hr_rfid_group_officer'))]"/>
        <field name="sequence">100</field>
        <field name="is_published">True</field>
    </record>

    <record id="spreadsheet_dashboard_security_devices" model="spreadsheet.dashboard">
        <field name="name">Security and Devices</field>
        <field name="spreadsheet_binary_data" type="base64"
               file="spreadsheet_dashboard_hr_rfid/data/files/security_devices_dashboard.json"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_hr"/>
        <field name="group_ids" eval="[Command.link(ref('hr_rfid.hr_rfid_group_officer'))]"/>
        <field name="sequence">105</field>
        <field name="is_published">True</field>
    </record>

</odoo>
