msgstr "Website-Kommunikationsverlauf"

#. module: hr_rfid_site_manager
#: model:ir.model.constraint,message:hr_rfid_site_manager.constraint_hr_rfid_site_no_loop
msgid "You cannot create a loop in the site hierarchy."
msgstr "Sie können keine Schleife in der Standorthierarchie erstellen."

#. module: hr_rfid_site_manager
#. odoo-python
#: code:addons/hr_rfid_site_manager/models/hr_rfid_access_group.py:0
msgid "You cannot delete an access group that is linked to a site."
msgstr ""
"Sie können eine Zugangsgruppe, die mit einem Standort verknüpft ist, nicht "
"löschen."

#. module: hr_rfid_site_manager
#: model_terms:ir.ui.view,arch_db:hr_rfid_site_manager.hr_rfid_site_view_form
msgid "Your site Name"
msgstr "Ihr Standortname"

