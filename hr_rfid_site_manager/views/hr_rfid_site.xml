<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_rfid_site_action" model="ir.actions.act_window">
            <field name="name">Site Manager</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.rfid.site</field>
            <field name="view_mode">hierarchy,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first site to organize your RFID infrastructure
                </p>
                <p>
                    Sites represent physical locations in your organization's hierarchy.
                    <br/><br/>
                    Key features:
                    • <b>Hierarchy:</b> Create building > floor > room structures
                    • <b>Auto Access Groups:</b> Generate access groups containing all site doors
                    • <b>Equipment Organization:</b> Group doors, controllers, and modules by location
                    • <b>Centralized Control:</b> Manage alarms and access permissions per site
                    <br/><br/>
                    <b>Examples:</b> "Main Building", "Parking Garage", "Research Lab", "Executive Floor"
                </p>
            </field>
        </record>
        <menuitem id="hr_rfid_menu_site_manager"
                  name="Site Manager"
                  parent="hr_rfid.hr_rfid_root_menu_hardware_manager"
                  action="hr_rfid_site_action"
                  groups="hr_rfid_site_manager.group_guard"
                  sequence="40"/>


        <record id="hr_rfid_site_view_tree" model="ir.ui.view">
            <field name="name">hr_rfid_site_view_tree</field>
            <field name="model">hr.rfid.site</field>
            <field name="arch" type="xml">
                <list sample="1" string="hr_rfid_site_tree">
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="door_ids" widget="many2many_tags"/>
                    <field name="webstack_ids" widget="many2many_tags"/>
                    <field name="controller_ids" widget="many2many_tags"/>
                    <field name="access_group_ids" widget="many2many_tags"/>
                    <field name="alarm_line_group_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record id="hr_rfid_site_view_form" model="ir.ui.view">
            <field name="name">hr_rfid_site_view_form</field>
            <field name="model">hr.rfid.site</field>
            <field name="arch" type="xml">
                <form string="Site manager">
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="open_door_list_action"
                                    type="object"
                                    class="oe_stat_button"
                                    invisible="door_count == 0"
                                    icon="fa-search-plus">
                                <field name="door_count" widget="statinfo" string="Door records"/>
                            </button>
                            <button name="open_controller_list_action"
                                    type="object"
                                    class="oe_stat_button"
                                    invisible="controller_count == 0"
                                    icon="fa-search-plus">
                                <field name="controller_count" widget="statinfo" string="Controller records"/>
                            </button>
                            <button name="open_webstack_list_action"
                                    type="object"
                                    class="oe_stat_button"
                                    invisible="webstack_count == 0"
                                    icon="fa-search-plus">
                                <field name="webstack_count" widget="statinfo" string="Module records"/>
                            </button>
                            <button name="open_access_group_list_action"
                                    type="object"
                                    class="oe_stat_button"
                                    invisible="access_group_count == 0"
                                    icon="fa-search-plus">
                                <field name="access_group_count" widget="statinfo" string="Access Group records"/>
                            </button>
                            <button name="open_alarm_line_group_list_action"
                                    type="object"
                                    class="oe_stat_button"
                                    invisible="alarm_line_group_count == 0"
                                    icon="fa-search-plus">
                                <field name="alarm_line_group_count" widget="statinfo" string="Alarm Line Group records"/>
                            </button>
                            <button name="open_child_site_list_action"
                                    type="object"
                                    class="oe_stat_button"
                                    invisible="child_count == 0"
                                    icon="fa-search-plus">
                                <field name="child_count" widget="statinfo" string="Child records"/>
                            </button>

                            <button name="create_child" type="object" class="oe_stat_button text-primary oe_read_only"
                                    icon="fa-plus"
                                    help="Create a new child site">
                                Create Child
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>

                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Your site Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="parent_id"/>
                                <field name="make_access_group"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="access_group_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                            <field name="child_ids" invisible="1"/>
                            <div invisible="not id or id and not child_ids and not parent_id">
                                <widget name="site_chart"/>
                            </div>
                        </group>
                        <notebook>
                            <page name="access_group_list" string="Access Groups" invisible="not access_group_ids">
                                <p class="text-muted">
                                    Access groups assigned to this site. Only groups not yet attached to another site are listed below.
                                </p>
                                <field name="access_group_ids" nolabel="1"
                                       domain="[('site_id','=',False)]"/>
                            </page>
                            <page name="door_list" string="Doors" invisible="not door_ids">
                                <p class="text-muted">
                                    Physical doors that belong to this site. A door can be on at most one site at a time.
                                </p>
                                <field name="door_ids" nolabel="1" widget="many2many_tags"
                                       domain="[('site_id','=',False)]"/>
                            </page>
                            <page name="ctrl_list" string="Controllers" invisible="not controller_ids">
                                <p class="text-muted">
                                    RFID controllers (iCON boards) classified under this site. The controller's webstack typically stays in the same site as its controllers.
                                </p>
                                <field name="controller_ids" nolabel="1"
                                       domain="[('site_id','=',False)]"/>
                            </page>
                            <page name="module_list" string="Modules" invisible="not webstack_ids">
                                <p class="text-muted">
                                    Webstack network modules (the hubs that talk to the controllers) located at this site.
                                </p>
                                <field name="webstack_ids" nolabel="1"
                                       domain="[('site_id','=',False)]"/>
                            </page>
                            <page name="alarm_group_list" string="Alarm Line Groups" invisible="not alarm_line_group_ids">
                                <p class="text-muted">
                                    Alarm line groups (zones) wired to controllers on this site. Useful for filtering security events by location.
                                </p>
                                <field name="alarm_line_group_ids" nolabel="1"
                                       domain="[('site_id','=',False)]"/>
                            </page>
                        </notebook>
                    </sheet>
                     <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="view_site_filter" model="ir.ui.view">
            <field name="name">hr.rfid.site.search</field>
            <field name="model">hr.rfid.site</field>
            <field name="arch" type="xml">
                <search string="Sites">
                    <field name="name" string="Site"/>
                    <field name="parent_id"/>
                    <field name="door_ids"/>
                    <field name="controller_ids"/>
                    <field name="webstack_ids"/>
                    <filter string="Sites with doors" name="site_with_doors" domain="[('door_ids','!=',False)]"/>
                    <filter string="Sites with controllers" name="site_with_ctrl"
                            domain="[('controller_ids','!=',False)]"/>
                    <filter string="Sites with modules" name="site_with_webstack"
                            domain="[('webstack_ids','!=',False)]"/>
                    <separator/>
                    <filter string="Root Sites" name="root_site" domain="[('parent_id','=',False)]"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                    <searchpanel>
                        <field name="company_id" groups="base.group_multi_company" icon="fa-building"
                               enable_counters="1"/>
                        <field name="parent_id" select="multi" string="Sites" icon="fa-building" color="#338FFC"
                               enable_counters="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="hr_rfid_site_hierarchy_view" model="ir.ui.view">
            <field name="name">hr_rfid_site_view_hierarchy</field>
            <field name="model">hr.rfid.site</field>
            <field name="arch" type="xml">
                <hierarchy child_field="child_ids" draggable="1">
                    <field name="name"/>
                    <field name="color"/>
                    <field name="make_access_group"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="hierarchy-box">
                            <div t-attf-class="o_hierarchy_node_header d-flex justify-content-center align-items-center o_hierarchy_node_color_{{ record.color.raw_value }}">
                                <button class="btn btn-link" name="disarm" type="object"
                                        t-if="record.state.raw_value == 'arm'">
                                    <i class="fa fa-universal-access text-success ms-auto"
                                       title="Disarm the Group"/>
                                </button>
                                <button class="btn btn-link" name="arm" type="object"
                                        t-if="record.state.raw_value == 'disarm'">
                                    <i class="fa fa-shield text-danger ms-auto"
                                       title="Arm the Group"/>
                                </button>
                                <field name="name"/>
                                <button class="btn btn-link" name="open_access_group_list_action" type="object">
                                    <i class="fa fa-circle text-success ms-auto"
                                       t-if="record.make_access_group.raw_value"
                                       title="Available Access Group"/>
                                </button>
                            </div>
                            <div class="o_hierarchy_node_body d-flex flex-column">
                                <field name="door_ids" invisible="1"/>
                                <field name="controller_ids" invisible="1"/>
                                <field name="webstack_ids" invisible="1"/>
                                <div>
                                    <button class="btn btn-link" name="open_door_list_action"
                                            type="object" t-if="record.door_ids.raw_value">
                                        <field name="door_ids" widget="many2many_tags"/>
                                    </button>
                                    <button class="btn btn-link" name="open_controller_list_action"
                                            type="object" t-if="record.controller_ids.raw_value">
                                        <field name="controller_ids" widget="many2many_tags"/>
                                    </button>
                                    <button class="btn btn-link" name="open_webstack_list_action"
                                            type="object" t-if="record.webstack_ids.raw_value">
                                        <field name="webstack_ids" widget="many2many_tags"/>
                                    </button>
                                </div>
                            </div>
                        </t>
                    </templates>
                </hierarchy>
            </field>
        </record>

        <record id="act_site_from_sites" model="ir.actions.act_window">
            <field name="name">Site</field>
            <field name="res_model">hr.rfid.site</field>
            <field name="view_mode">list,kanban,hierarchy,form</field>
            <!--            <field name="search_view_id" ref="view_employee_filter"/>-->
            <field name="context">{
                <!--                "searchpanel_default_parent_id": active_id,-->
                <!--                "default_parent_id": active_id,-->
                "search_default_site_id": active_id,
                "expand": 1}
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No sites found for this context
                </p>
                <p>
                    This view shows sites filtered by the selected context.
                    <br/><br/>
                    Use the search panel and filters to:
                    • Find sites by parent location
                    • Filter by equipment type (doors, controllers, modules)
                    • View hierarchical organization
                    • Access site-specific management tools
                </p>
            </field>
        </record>
    </data>
</odoo>