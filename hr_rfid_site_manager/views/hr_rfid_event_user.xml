<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_rfid_user_ev_view_form_inherit" model="ir.ui.view">
            <field name="name">hr.rfid.user.ev.view.form.inherit</field>
            <field name="model">hr.rfid.event.user</field>
            <field name="inherit_id" ref="hr_rfid.hr_rfid_user_ev_view_form"/>
            <field name="arch" type="xml">
                <field name="door_id" position="before">
                    <field name="site_id" groups="hr_rfid_site_manager.group_guard"/>
                </field>
            </field>
        </record>
        <record id="hr_rfid_user_ev_view_tree_inherit" model="ir.ui.view">
            <field name="name">hr.rfid.user.ev.view.tree.inherit</field>
            <field name="model">hr.rfid.event.user</field>
            <field name="inherit_id" ref="hr_rfid.hr_rfid_user_ev_view_list"/>
            <field name="arch" type="xml">
                <field name="card_number" position="after">
                    <field name="site_id" groups="hr_rfid_site_manager.group_guard" optional="hide"/>
                </field>
            </field>
        </record>
    </data>
</odoo>