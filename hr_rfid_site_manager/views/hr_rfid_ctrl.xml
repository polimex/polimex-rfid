<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_rfid_ctrl_view_form_inherit" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.form.inherit</field>
            <field name="model">hr.rfid.ctrl</field>
            <field name="inherit_id" ref="hr_rfid.hr_rfid_controller_view_form"/>
            <field name="arch" type="xml">
                <field name="sw_version" position="after">
                    <field name="site_id" groups="hr_rfid_site_manager.group_guard"/>
                </field>
            </field>
        </record>

        <record id="hr_rfid_controller_view_search" model="ir.ui.view">
            <field name="name">hr.rfid.ctrl.search</field>
            <field name="model">hr.rfid.ctrl</field>
            <field name="inherit_id" ref="hr_rfid.hr_rfid_controller_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sw_version']" position="after">
                    <filter string="by Site" name="groupby_site" context="{'group_by':'site_id'}"/>
                </xpath>
            </field>
        </record>

        <record id="hr_rfid_controller_view_kanban" model="ir.ui.view">
            <field name="name">hr.rfid.controller.kanban</field>
            <field name="model">hr.rfid.ctrl</field>
            <field name="inherit_id" ref="hr_rfid.hr_rfid_controller_view_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='emergency_state']" position="after">
                    <field name="site_id" groups="hr_rfid_site_manager.group_guard"/>
                </xpath>
                <xpath expr="//div[@name='third_col']" position="after">
                    <div t-if="record.site_id.raw_value">
                        <field name="site_id" groups="hr_rfid_site_manager.group_guard"/>
                    </div>

                </xpath>
            </field>
        </record>

    </data>
</odoo>