<!-- ZPL II Wristband Report for `rfid.service.sale`Author: Polimex Dev Team -->
<odoo>
    <!-- 1 × 11 inch wristband @203 dpi  -->
    <record id="paperformat_wristband_1x11" model="report.paperformat">
        <field name="name">Wristband 1×11 in</field>
        <field name="format">custom</field>
        <field name="page_width">25</field>     <!-- mm -->
        <field name="page_height">279</field>   <!-- mm -->
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
    </record>

    <!-- QWeb template : renders ONE ^XA…^XZ block per record -->
    <template id="wristband_template_view">
        <t t-foreach="docs" t-as="sale" t-translation="off">
            ^XA^CI28
            ^PW203 ^LL2233 ^LH0,0
            
            ; COLUMN LAYOUT - No lines, centered elements
            
            ; COLUMN 1: Company + Service (Y: 50-400)
            ^FO90,150
            ^A0R,48,48^FD<t t-out="(sale.service_id.company_id.name if sale.service_id else env.company.name)[:15]"/>^FS
            ^FO60,150
            ^A0R,44,44^FD<t t-out="(sale.service_id.name if sale.service_id else 'Service')[:15]"/>^FS
            
            ; COLUMN 2: Partner Name (Y: 600-1000)
            <t t-set="partner_name" t-value="sale.partner_id.name if sale.partner_id else 'GUEST'"/>
            ^FO85,750
            ^A0R,60,60^FD<t t-out="partner_name[:20]"/>^FS
            
            ; COLUMN 3: Barcode centered (Y: 1100-1500)
            <t t-set="card_number" t-value="sale.card_id.barcode_number or sale.card_number or '0000000000'"/>
            ^FO60,1250
            ^BY4,4,160
            ^BCR,160,N,N,N
            ^FD<t t-out="card_number"/>^FS
            
            ; COLUMN 4: Dates/Times (Y: 1700-2100)
            <t t-if="sale.start_date">
                <t t-set="start_datetime" t-value="sale.start_date.strftime('%d-%b-%y %H:%M').upper()"/>
                ^FO85,1800
                ^A0R,36,36^FD<t t-out="start_datetime"/>^FS
            </t>
            <t t-if="sale.end_date">
                <t t-set="end_datetime" t-value="sale.end_date.strftime('%d-%b-%y %H:%M').upper()"/>
                ^FO55,1800
                ^A0R,36,36^FD<t t-out="end_datetime"/>^FS
            </t>
            
            ^XZ
        </t>
    </template>

    <record id="action_report_rfid_wristband" model="ir.actions.report">
        <field name="name">Patient Wristband (ZPL)</field>
        <field name="model">rfid.service.sale</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">rfid_service_zpl_labels.wristband_template_view</field>
        <field name="report_file">rfid_service_zpl_labels.wristband_template_view</field>
        <field name="binding_model_id" ref="rfid_service_base.model_rfid_service_sale"/>
        <field name="binding_type">report</field>
        <!-- optional: force "raw" mode if you use a CUPS queue -->
        <field name="print_report_name">'wristband_' + (object.name or 'by_polimex')</field>
        <field name="paperformat_id" ref="rfid_service_zpl_labels.paperformat_wristband_1x11"/>
    </record>

</odoo>