<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_rfid_service_form_inherit_new_group" model="ir.ui.view">
            <field name="name">rfid.service.form.inherit.new.group</field>
            <field name="model">rfid.service</field>
            <field name="inherit_id" ref="rfid_service_base.services_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='rfid_service_form_printing_templates']" position="inside">
                    <field name="label_template_id"/>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="preview_label" 
                            string="Preview Label" 
                            type="object" 
                            class="btn-secondary"
                            icon="fa-eye"
                            help="Preview the configured label template with test data"
                            groups="rfid_service_base.group_card_user"/>
                    <button name="test_label_printer_connection" 
                            string="Test Label Printer" 
                            type="object" 
                            class="oe_highlight"
                            icon="fa-print"
                            help="Send a test label to the configured printer to verify connectivity. Note: System parameters 'rfid.label.printer.ip' and 'rfid.label.printer.port' must be configured first in Settings → Technical → Parameters → System Parameters"
                            groups="rfid_service_base.group_card_manager"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>